        end
        window = {Alive=true,Gui=gui,Main=nativeWindow._main,Tabs={},Connections={},DestroyCallbacks={},Native=nativeWindow}
        function window:Connect(signal,callback)
            local connection=signal:Connect(callback)
            self.Connections[#self.Connections+1]=connection
            return connection
        end
        function window:OnDestroy(callback) self.DestroyCallbacks[#self.DestroyCallbacks+1]=callback end
        function window:Destroy()
            if not self.Alive then return end
            self.Alive=false
            for _,connection in ipairs(self.Connections) do connection:Disconnect() end
            unloadNative(native)
            for _,callback in ipairs(self.DestroyCallbacks) do
                local ok,err=pcall(callback)
                if not ok then warn("[Luna UI] Destroy: "..tostring(err)) end
            end
        end
        function window:SelectTab(index)
            if self.Tabs[index] then nativeWindow:_switchTab(self.Tabs[index].Native) end
        end
        native.Unload=function() window:Destroy() end
        native.Destroy=native.Unload
        local launcher=gui:FindFirstChild("OpenButton")
        launcher.Name="Launcher"
        launcher.Text="☾"
        launcher.TextSize=26
        launcher.TextColor3=palette.accent
        window:Connect(launcher.MouseButton1Click,function()
            local tween=game:GetService("TweenService"):Create(launcher,TweenInfo.new(0.25,Enum.EasingStyle.Quad),
                {Rotation=(launcher.Rotation or 0)+360})
            tween:Play()
        end)
        return window
    end
    function library:CreateSURWindow() return self:CreateWindow() end
    function library:CreateSURNavigation(windowObject)
        local tabs={}
        for _,pair in ipairs({{"Farm","Stand Farm"},{"Dashboard","Home"},{"Targets","Targets"},
            {"Storage","Storage & Orb"},{"Lair","Auto Lair"},{"Utilities","Utilities"},{"Settings","Settings"}}) do
            local nt=windowObject.Native:AddTab(pair[2])
            local group=nt:AddGroupbox(pair[2])
            local tab={Native=nt,Page=nt._contentFrame,Button=nt._tabButton}
            windowObject.Tabs[#windowObject.Tabs+1]=tab
            local function textControl(text)
                local item=group:AddLabel(tostring(text or ""))._label
                item.AutomaticSize=Enum.AutomaticSize.Y
                item.Visible=item.Text~=""
                local function set(value) item.Text=tostring(value or "");item.Visible=item.Text~="" end
                return setmetatable({Set=function(_,value)set(value)end},{
                    __index=function(_,key)if key=="Text" then return item.Text end end,
                    __newindex=function(self,key,value)if key=="Text" then set(value)else rawset(self,key,value)end end})
            end
            function tab:CreateSection(text) return textControl(text) end
            function tab:CreateLabel(first,second) return textControl(second or first) end
            function tab:CreateButton(options)
                group:AddButton({Text=options.Name,Callback=options.Callback})
                return {Set=function()end}
            end
            function tab:CreateToggle(options)
                local syncing=false
                local object=group:AddToggle(flag(options),{Text=options.Name,Default=options.CurrentValue==true,
                    Callback=function(value)if not syncing and options.Callback then options.Callback(value)end end})
                return {Set=function(_,raw,silent)
                    syncing=true;object:SetValue(raw==true);syncing=false
                    if not silent and options.Callback then options.Callback(raw==true)end
                end}
            end
            function tab:CreateInput(options)
                local object=group:AddInput(flag(options),{Text=options.Name,Default=tostring(options.CurrentValue or ""),
                    Placeholder=options.PlaceholderText,Callback=options.Callback})
                return {Set=function(_,value)
                    value=tostring(value or "")
                    if object.Value~=value then object:SetValue(value)end
                end}
            end
            function tab:CreateSlider(options)
                local range=options.Range or {0,100}
                local syncing=false
                local object=group:AddSlider(flag(options),{Text=options.Name,Min=range[1],Max=range[2],
                    Default=options.CurrentValue,Step=options.Increment or 1,Rounding=(options.Increment or 1)<1 and 1 or 0,
                    Suffix=options.Suffix,Callback=function(value)
                        if not syncing and options.Callback then options.Callback(value)end
                    end})
                return {Set=function(_,value,silent)
                    syncing=true;object:SetValue(value);syncing=false
                    if not silent and options.Callback then options.Callback(object.Value)end
                end}
            end
            function tab:CreateDropdown(options)
                local choices=cloneList(options.Options)
                local selected=cloneList(options.CurrentOption)
                local object
                local function assign(values)
                    object:SetValue(options.MultipleOptions and cloneList(values) or values[1])
                end
                object=group:AddDropdown(flag(options),{Text=options.Name,Values=choices,
                    Default=options.MultipleOptions and cloneList(selected) or selected[1],Multi=options.MultipleOptions,
                    Callback=function(raw)
                        local values=cloneList(raw)
                        if options.MultipleOptions then
                            local newExclusive
                            for _,exclusive in ipairs(options.ExclusiveOptions or {})do
                                if listContains(values,exclusive) and not listContains(selected,exclusive) then newExclusive=exclusive;break end
                            end
                            if newExclusive then values={newExclusive}
                            elseif #values>1 then
                                for _,exclusive in ipairs(options.ExclusiveOptions or {})do
                                    local index=table.find(values,exclusive)
                                    if index then table.remove(values,index)end
                                end
                            end
                        end
                        selected=values;assign(selected)
                        if options.Callback then options.Callback(cloneList(selected))end
                    end})
                return {Set=function(_,value,silent)
                    selected=cloneList(value);assign(selected)
                    if not silent and options.Callback then options.Callback(cloneList(selected))end
                end,Refresh=function(_,raw)
                    local values=cloneList(raw)
                    if #values==#choices then
                        local same=true
                        for index,value in ipairs(values)do if choices[index]~=value then same=false;break end end
                        if same then return end
                    end
                    choices=values;object:Refresh(values,true)
                end}
            end
            tabs[pair[1]]=tab
        end
        self._surTabs=tabs
        return tabs
    end
