-- Only the loader references the UI; no menu construction lives in this file.
local UI_LIBRARY_URL = "https://raw.githubusercontent.com/lunaoir/lunan/refs/heads/main/ui%20lib"
local UI_LIBRARY_REFRESH_URL = "https://raw.githubusercontent.com/lunaoir/lunan/main/ui%20lib"
local loaded, library = pcall(function()
    assert(type(loadstring)=="function", "loadstring is required")
    local function fetch(url)
        local ok, source = pcall(game.HttpGet, game, url)
        if not ok then return nil, tostring(source) end
        if type(source)~="string" or not source:find("-- LUNA_UI_DESIGN05_FEATURES_V2",1,true)
            or not source:find("-- LUNA_UI_HALLOWEEN_AUTO_V1",1,true) then
            return nil, "Cap nhat ui lib bang Luna_UI_Library.lua co muc Halloween moi."
        end
        return source
    end
    local source, fetchError = fetch(UI_LIBRARY_URL)
    if not source then source, fetchError = fetch(UI_LIBRARY_REFRESH_URL) end
    assert(source, "Khong tai duoc UI moi: "..tostring(fetchError))
    local chunk, err = loadstring(source, "@Luna_UI_Library.lua")
    assert(chunk, err)
    local result = chunk()
    assert(type(result)=="table" and result.Design=="Luna-05" and result.FeaturesVersion==2 and result.HalloweenAutoVersion==1
        and type(result.Mount)=="function", "UI library is incompatible with this rebuild")
    return result
end)
if not loaded then warn("[Luna Hub] UI: "..tostring(library)); return end
local ok, session = pcall(Features.Start)
if not ok then warn("[Luna Hub] Start: "..tostring(session)); return end
local mounted, result = pcall(library.Mount, session)
if not mounted then session:Destroy(); warn("[Luna Hub] Mount: "..tostring(result)); return end
return session
