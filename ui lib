local reworkedSet = setmetatable({}, {__mode = "k"})
local function isHacBachInternal(inst)
    while inst do
        if inst.Name:sub(1, 8) == "HacBach_" then return true end
        inst = inst.Parent
    end
    return false
end

-- Legacy SUR dashboards update colors directly. Watch their color changes only;
-- V3 controls/decoration are excluded by the HacBach_ namespace above.
local function watchWorkspaceColors(inst)
    if not inst:IsA("GuiObject") and not inst:IsA("UIStroke") then return end
    local busy=false
    local isText=inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")
    local isImage=inst:IsA("ImageLabel") or inst:IsA("ImageButton")
    local function apply()
        if busy or not inst.Parent then return end
        busy=true
        if inst:IsA("UIStroke") then inst.Color=toMonochromeColor(inst.Color,"stroke")
        else
            inst.BackgroundColor3=toMonochromeColor(inst.BackgroundColor3,"bg")
            if isText then
                local color=toMonochromeColor(inst.TextColor3,"text")
                if brightSurface(inst) then color=Library.COLORS.textInverse
                elseif math.max(color.R,color.G,color.B)<0.22 then color=Library.COLORS.text end
                inst.TextColor3=color
            end
            if isImage then inst.ImageColor3=toMonochromeColor(inst.ImageColor3,"image") end
        end
        busy=false
    end
    if inst:IsA("UIStroke") then inst:GetPropertyChangedSignal("Color"):Connect(apply)
    else
        inst:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
            apply()
            for _,child in ipairs(inst:GetChildren()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                    if brightSurface(child) then child.TextColor3=Library.COLORS.textInverse
                    elseif math.max(child.TextColor3.R,child.TextColor3.G,child.TextColor3.B)<0.22 then
                        child.TextColor3=Library.COLORS.text
                    end
                end
            end
        end)
        if isText then inst:GetPropertyChangedSignal("TextColor3"):Connect(apply) end
        if isImage then inst:GetPropertyChangedSignal("ImageColor3"):Connect(apply) end
    end
    apply()
end

local function reworkWorkspaceInstance(inst)
    if not inst or not inst.Parent or reworkedSet[inst] or isHacBachInternal(inst) then return end
    reworkedSet[inst]=true
    if inst:IsA("UIGradient") then
        local points={}
        for _,kp in ipairs(inst.Color.Keypoints) do
            table.insert(points,ColorSequenceKeypoint.new(kp.Time,toMonochromeColor(kp.Value,"bg")))
        end
        if #points>=2 then inst.Color=ColorSequence.new(points) end
    end
    watchWorkspaceColors(inst)
end

