                    if argument ~= nil then
                        for index, item in next, argument do
                            colors[index] = item
                        end
                    end

                    local tokens = {}
                    local currentToken = ""

                    local inString = false
                    local inComment = false
                    local commentPersist = false

                    for index = 1, #source do
                        local character = source:sub(index, index)

                        if inComment then
                            if character == "\n" and not commentPersist then
                                table.insert(tokens, currentToken)
                                table.insert(tokens, character)
                                currentToken = ""

                                inComment = false
                            elseif source:sub(index - 1, index) == "]]" and commentPersist then
                                currentToken = currentToken .. "]"

                                table.insert(tokens, currentToken)
                                currentToken = ""

                                inComment = false
                                commentPersist = false
                            else
                                currentToken = currentToken .. character
                            end
                        elseif inString then
                            if
                                character == inString and source:sub(index - 1, index - 1) ~= "\\"
                                or character == "\n"
                            then
                                currentToken = currentToken .. character
                                inString = false
                            else
                                currentToken = currentToken .. character
                            end
                        else
                            if source:sub(index, index + 1) == "--" then
                                table.insert(tokens, currentToken)
                                currentToken = "-"
                                inComment = true
                                commentPersist = source:sub(index + 2, index + 3) == "[["
                            elseif character == '"' or character == "'" then
                                table.insert(tokens, currentToken)
                                currentToken = character
                                inString = character
                            elseif operatorsSet[character] then
                                table.insert(tokens, currentToken)
                                table.insert(tokens, character)
                                currentToken = ""
                            elseif character:match("[%w_]") then
                                currentToken = currentToken .. character
                            else
                                table.insert(tokens, currentToken)
                                table.insert(tokens, character)
                                currentToken = ""
                            end
                        end
                    end

                    table.insert(tokens, currentToken)

                    local highlighted = {}

                    for index, token in ipairs(tokens) do
                        local highlight = getHighlight(tokens, index)

                        if highlight then
                            local syntax = string.format(
                                '<font color = "#%s">%s</font>',
                                highlight:ToHex(),
                                token:gsub("<", "&lt;"):gsub(">", "&gt;")
                            )

                            table.insert(highlighted, syntax)
                        else
                            table.insert(highlighted, token)
                        end
                    end

                    return table.concat(highlighted)
                end

                return highlighter
            end

