local function cloneArray(list)
    local result = {}
    if type(list) == "table" then
        for _, value in ipairs(list) do
            table.insert(result, value)
        end
    end
    return result
end

function Library:_setFlag(flag, value, fromLoad)
    if not flag or flag == "" then return end
    self._compat.flags[flag] = value
    local setter = self._compat.bindings[flag]
    if setter then setter(value, fromLoad) end
end

function Library:_bindFlag(flag, defaultValue, setter)
    if not flag or flag == "" then return end
    if self._compat.flags[flag] == nil then
        self._compat.flags[flag] = defaultValue
    end
    self._compat.bindings[flag] = setter
end

--================== HỆ THỐNG TWEEN & BLUR MƯỢT TUYỆT ĐỐI ==================--
local function tween(obj, goal, duration, style, dir)
    if not obj then return nil end
    style = style or Enum.EasingStyle.Exponential
    dir = dir or Enum.EasingDirection.Out
    local t = TweenService:Create(obj, TweenInfo.new(duration or 0.26, style, dir), goal)
    t:Play()
    return t
end

local function corner(r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    return c
end

