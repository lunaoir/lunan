        set("Dashboard_Section_2","Stand Farm  •  "..(state.Farming and "RUNNING" or "OFF"))
        set("Dashboard_Section_4","Current  •  "..state.Stand.."  /  "..state.Attribute.."  /  Tier "..state.Tier)
        set("Dashboard_Section_5","Targets  •  "..#state.Targets.." configured")
        set("Dashboard_Section_6",state.OrbStatus)
        set("Dashboard_Section_8","Ready  •  "..#state.Targets.." target rules  •  Unlimited capacity")
        set("Storage_Section_3","Storage: "..state.StorageMessage)
        set("Storage_Section_8",state.OrbStatus)
        for index,record in ipairs(state.Storage) do
            storageLabels[index].stand:Set(record.Label..": "..(record.Stand or "data unavailable"))
            storageLabels[index].attribute:Set(record.Attribute and ("Attribute: "..record.Attribute..(record.Protected and " [KEEP]" or " [AVAILABLE]")) or "Unavailable - do not use")
        end
    end)
    refreshing=false
    if not ok then warn("[Luna UI] Refresh: "..tostring(err)) end
end
