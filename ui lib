end

local function readSavedState(path)
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return nil
    end
    local ok, result = pcall(function()
        if not isfile(path) then
            return nil
        end
        return jsonservice:JSONDecode(readfile(path))
    end)
    if not ok then
        return nil, "Unreadable saved state: " .. path
    end
    if result ~= nil and type(result) ~= "table" then
        return nil, "Invalid saved state: " .. path
    end
    return result
end

local function readStandRecord(prefix)
    local data = localplr:FindFirstChild("Data")
    if not data then
        return nil
    end
    local s = data:FindFirstChild((prefix or "") .. "Stand")
    local a = data:FindFirstChild((prefix or "") .. "Attri")
    local g = data:FindFirstChild((prefix or "") .. "GUID")
    if not s or not a or not g then
        return nil
    end
    local ok, record = pcall(function()
        return { stand = s.Value, att = a.Value, guid = g.Value }
    end)
    if
        not ok
        or type(record.stand) ~= "string"
        or record.stand == ""
        or type(record.att) ~= "string"
        or type(record.guid) ~= "string"
        or (record.stand ~= "None" and (record.guid == "" or record.guid == "Generate"))
    then
        return nil
    end
    return record
end

local function sameRecord(a, b)
    return a and b and a.stand == b.stand and a.att == b.att and a.guid == b.guid
end

local function confirmedSwap(current, stored, pending)
    if not sameRecord(stored, pending.current) then
        return false
    end
    if pending.stored.stand == "None" then
        -- Empty storage commonly has GUID "Generate", while the active empty
        -- record may receive a fresh GUID. The valuable side must still arrive
        -- intact in storage; the active side must be stably empty.
        return current and current.stand == "None" and current.att == "None"
    end
    return sameRecord(current, pending.stored)
end

local function validRecord(record)
    return type(record) == "table"
        and type(record.stand) == "string"
        and type(record.att) == "string"
        and type(record.guid) == "string"
end

local function validPending(pending)
    if type(pending) ~= "table" or not validRecord(pending.current) or not validRecord(pending.stored) then
        return false
    end
    for _, slot in ipairs(storageMap) do
        if pending.data == slot.data and pending.remote == slot.remote then
            return true
        end
    end
    return false
end

local function setStoragePending(pending)
    storagePending = pending
    getgenv().SURStorageStateV2[accountKey] = pending
    persistState(storageFile, pending or { pending = false })
end

local function storageAvailability()
    local free, unknown, protected = nil, 0, 0
    for _, slot in ipairs(storageMap) do
        local record = readStandRecord(slot.data)
        if not record then
            unknown = unknown + 1
        elseif checkSlotMatch(record.stand, record.att) then
            protected = protected + 1
        elseif not free then
            free = slot
        end
    end
    if free then
        return free, "available"
    end
    return nil, unknown > 0 and "unavailable" or (protected == #storageMap and "full" or "unavailable")
end

local function storageCooldown()
    local folder = localplr:FindFirstChild("GlobalCooldowns")
    local cd = folder and folder:FindFirstChild("StandSwitchCD")
    local remaining = math.max(0, 8 - (os.clock() - lastStorageRequest))
    if cd then
        local ok, value = pcall(function()
            return cd.Value
        end)
        if not ok or type(value) ~= "number" or value ~= value then
            return nil
        end
        remaining = math.max(remaining, value)
    end
    return remaining
end

local function awaitStorageConfirmation(running)
    if not validPending(storagePending) then
        return false, "Storage check needs manual review."
    end
    local pending = storagePending
    local deadline = os.clock() + 10
    local confirmedSince
    while running() and os.clock() < deadline do
        local current = readStandRecord()
        local stored = readStandRecord(pending.data)
        if confirmedSwap(current, stored, pending) then
            confirmedSince = confirmedSince or os.clock()
            if os.clock() - confirmedSince >= 0.35 then
                setStoragePending(nil)
                storageMessage = "Stored in " .. pending.label
                return true, pending.label
            end
        else
            confirmedSince = nil
        end
        task.wait(0.08)
    end
    storageMessage = "Swap not confirmed. Check storage before resuming."
    return false, storageMessage
end

local function storeMatchedStand(stand, att, running)
    if storagePending then
        return awaitStorageConfirmation(running)
    end
    local deadline = os.clock() + 25
    while running() and autoStoreMatches and os.clock() < deadline do
        local remaining = storageCooldown()
        if remaining == nil then
            return false, "Cannot read storage cooldown."
        end
        if remaining > 0 then
            storageMessage = "Waiting for storage cooldown: " .. math.ceil(remaining) .. "s"
            task.wait(0.1)
            continue
        end
        local current = readStandRecord()
        if not current or current.stand ~= stand or current.att ~= att then
            return false, "Current stand data changed."
        end
        if not checkSlotMatch(current.stand, current.att) then
            return false, "Target list changed."
        end
        local slot, reason = storageAvailability()
        if not slot then
            return false,
                reason == "full" and "All enabled slots are protected." or "No confirmed usable storage slot."
        end
        local stored = readStandRecord(slot.data)
        if not stored or checkSlotMatch(stored.stand, stored.att) then
            return false, "Storage contents changed."
        end
        -- Require a stable snapshot of both sides before sending the swap.
        task.wait(0.35)
        if not running() or not autoStoreMatches then
            return false, "Storage cancelled."
        end
        if
            not sameRecord(readStandRecord(), current) or not sameRecord(readStandRecord(slot.data), stored)
        then
            continue
        end
        if not checkSlotMatch(current.stand, current.att) or checkSlotMatch(stored.stand, stored.att) then
            continue
        end
        local cd = storageCooldown()
        if cd == nil or cd > 0 then
            continue
        end
        local events = ReplicatedStorage:FindFirstChild("Events")
        local remote = events and events:FindFirstChild("SwitchStand")
        if not remote or not remote:IsA("RemoteEvent") then
            return false, "SwitchStand RemoteEvent is missing."
        end
        setStoragePending({
            pending = true,
            data = slot.data,
            remote = slot.remote,
            label = slot.label,
            current = current,
            stored = stored,
        })
        -- File APIs may yield, so verify once more after recording the intent.
        if
            not running()
            or not autoStoreMatches
            or not sameRecord(readStandRecord(), current)
            or not sameRecord(readStandRecord(slot.data), stored)
            or not checkSlotMatch(current.stand, current.att)
            or checkSlotMatch(stored.stand, stored.att)
        then
            setStoragePending(nil)
            return false, "Storage cancelled before request."
        end
        storageMessage = "Confirming swap into " .. slot.label
        lastStorageRequest = os.clock()
        local ok, err = pcall(function()
            remote:FireServer(slot.remote)
        end)
        if not ok then
            return false, "Storage request failed: " .. tostring(err)
        end
        return awaitStorageConfirmation(running)
    end
    return false, "Storage cancelled or cooldown timed out."
end

