            local dragging = false
            local currentValue = default

            local function normalizeValue(value)
                value = math.clamp(tonumber(value) or min, min, max)
                local stepped = min + math.floor(((value - min) / increment) + 0.5) * increment
                return math.clamp(stepped, min, max)
            end

            local function applyValue(value)
                currentValue = normalizeValue(value)
                local percent = (max == min) and 0 or ((currentValue - min) / (max - min))
                tween(fill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.1)
                valLbl.Text = tostring(currentValue) .. suffix
                if flag then Library._compat.flags[flag] = currentValue end
                pcall(callback, currentValue)
            end

            local function updateSlider(input)
                local posX = math.clamp(input.Position.X - track.AbsolutePosition.X, 0, math.max(1, track.AbsoluteSize.X))
                local percent = posX / math.max(1, track.AbsoluteSize.X)
                applyValue(min + ((max - min) * percent))
            end

            dragBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(input)
                end
            end)
            connect(UserInputService.InputChanged, function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
