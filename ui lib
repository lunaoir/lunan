	make("Frame", {BackgroundColor3 = C.Accent, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(34, 16), Size = UDim2.fromOffset(7, 1.5)}, titlebar)
	make("Frame", {BackgroundColor3 = C.Accent, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(34, 16), Size = UDim2.fromOffset(1.5, 7)}, titlebar)
	local titleText = options.Title or "LUNA"
	local titleWidth = measureWidth(titleText, F.Bold, 18)
	textLabel(titlebar, {Text = titleText, Font = F.Bold, TextSize = 18, Position = UDim2.fromOffset(48, 0), Size = UDim2.fromOffset(titleWidth + 2, HEADER)})
	local subtitleHolder = make("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(48 + titleWidth + 12, 0), Size = UDim2.new(1, -(48 + titleWidth + 24), 1, 0)}, titlebar)
	make("Frame", {BackgroundColor3 = C.LineStrong, Position = UDim2.fromOffset(0, 15), Size = UDim2.fromOffset(1, 16)}, subtitleHolder)
	textLabel(subtitleHolder, {
		Text = options.Subtitle or "", TextSize = 15, TextColor3 = C.Muted, Position = UDim2.fromOffset(12, 0),
