                if not camera then return end
                local sent, inputError = pcall(function()
                    virtualUser:ClickButton2(Vector2.new(0, 0), camera.CFrame)
                end)
                if not sent then reportFailure(inputError) end
            end)
            getgenv().SURAntiAfkConnection = connection
        end)
        if not ok then reportFailure(err) end
    end)
    engine:OnStop(stopAntiAFK)
end

-- Feature lifecycle state
do
    local records = {}
    local added: RBXScriptConnection? = nil
    local enabled = false
    local function stopTapE()
        enabled = false
        if added then added:Disconnect(); added = nil end
        for prompt, record in pairs(records) do
            record.Changed:Disconnect()
            record.Destroying:Disconnect()
            if prompt.Parent then prompt.HoldDuration = record.Duration end
        end
        table.clear(records)
    end
    local function applyTapE(prompt)
        if not enabled or not engine:IsRunning() or records[prompt] then return end
        if not prompt:IsA("ProximityPrompt") or prompt.Name ~= "Knock" then return end
        local map = workspace:FindFirstChild("Map")
        local base = map and map:FindFirstChild("BaseMap")
        local doors = base and base:FindFirstChild("Doors")
        if not doors or not prompt:IsDescendantOf(doors) then return end
        local holder = prompt.Parent
        if not holder or holder.Name ~= "TrickOrTreatKnock" then return end
        local record = {Duration=prompt.HoldDuration}
        records[prompt] = record
        record.Changed = prompt:GetPropertyChangedSignal("HoldDuration"):Connect(function()
            if not enabled or records[prompt] ~= record or not engine:IsRunning() then return end
            if prompt.HoldDuration ~= 0 then
                record.Duration = prompt.HoldDuration
                prompt.HoldDuration = 0
            end
        end)
        record.Destroying = prompt.Destroying:Connect(function()
            record.Changed:Disconnect()
            record.Destroying:Disconnect()
            records[prompt] = nil
        end)
        prompt.HoldDuration = 0
    end
    engine:Define("HalloweenTapE", {Type="boolean"}, false, function(value)
        stopTapE()
        if not value then return end
        enabled = true
        added = workspace.DescendantAdded:Connect(applyTapE)
        for _, object in ipairs(workspace:GetDescendants()) do applyTapE(object) end
    end)
    engine:OnStop(stopTapE)
end

-- Halloween owns its movement, prompt hold and paired M1 input independently.
do
    local autoDoor, autoMob = false, false
    local heartbeat: RBXScriptConnection? = nil
    local added: RBXScriptConnection? = nil
    local prompts, mobs = {}, {}
    local chosenDoor, doorPoint
    local heldPrompt, promptEndAt
    local m1Input, m1EndAt
    local movedHumanoid, movedRoot
    local nextDoorAt, nextM1At, nextScanAt, elapsed = 0, 0, 0, 0
    featureState.halloweenStatus = "Đã tắt"
    local function setStatus(text) featureState.halloweenStatus = text end
    local function releasePrompt()
        if heldPrompt then
            local prompt = heldPrompt
            heldPrompt, promptEndAt = nil, nil
            local ok, err = pcall(function() prompt:InputHoldEnd() end)
            if not ok then warn("[Halloween] End prompt: "..tostring(err)) end
        end
    end
    local function releaseM1()
        if m1Input then
            local remote = m1Input
            m1Input, m1EndAt = nil, nil
            local ok, err = pcall(function() remote:FireServer("MouseButton1", "End", nil) end)
            if not ok then warn("[Halloween] End M1: "..tostring(err)) end
        end
    end
    local function stopMovement()
        local humanoid, root = movedHumanoid, movedRoot
        movedHumanoid, movedRoot = nil, nil
        if humanoid and humanoid.Parent and root and root.Parent then humanoid:MoveTo(root.Position) end
    end
    local function releaseActions()
        releasePrompt(); releaseM1(); stopMovement()
    end
    local function doorFolder()
        local map = workspace:FindFirstChild("Map")
        local base = map and map:FindFirstChild("BaseMap")
        return base and base:FindFirstChild("Doors")
    end
    local function validDoor(prompt)
        local doors = doorFolder()
        return doors and prompt.Parent and prompt:IsDescendantOf(doors)
            and prompt:IsA("ProximityPrompt") and prompt.Name=="Knock"
            and prompt.Parent.Name=="TrickOrTreatKnock"
    end
    local function promptPoint(prompt)
        local parent = prompt.Parent
        if parent and parent:IsA("Attachment") then return parent.WorldPosition end
        if parent and parent:IsA("BasePart") then return parent.Position end
    end
    local function indexObject(object)
        if object:IsA("ProximityPrompt") and validDoor(object) then prompts[object] = true end
        local model = object
        while model and model~=workspace do
            if model:IsA("Model") and (model.Name=="Evil Bandit" or model.Name=="Headless Horseman") then
                if not mobs[model] then mobs[model]=os.clock() end
                break
            end
            model=model.Parent
        end
    end
    local function rescan(now)
        local foundPrompts, foundMobs = {}, {}
        for _, object in ipairs(workspace:GetDescendants()) do
            indexObject(object)
            if prompts[object] then foundPrompts[object]=true end
            if mobs[object] then foundMobs[object]=mobs[object] end
        end
        prompts, mobs = foundPrompts, foundMobs
        nextScanAt = now+3
    end
    local function moveTo(humanoid, root, point, standOff)
        local delta = Vector3.new(root.Position.X-point.X, 0, root.Position.Z-point.Z)
        local target = point
        if delta.Magnitude>.01 then target=point+delta.Unit*standOff end
        movedHumanoid, movedRoot = humanoid, root
        humanoid:MoveTo(target)
    end
    local function selectDoor(root)
        if chosenDoor and validDoor(chosenDoor) then
            doorPoint=promptPoint(chosenDoor)
            if doorPoint then return end
        end
        chosenDoor, doorPoint = nil, nil
        local nearest = math.huge
        for prompt in pairs(prompts) do
            if validDoor(prompt) then
                local point = promptPoint(prompt)
                local distance = point and (point-root.Position).Magnitude or math.huge
                if distance<nearest then chosenDoor, doorPoint, nearest=prompt,point,distance end
            else prompts[prompt]=nil end
        end
    end
    local function selectMob(root, now)
        local selected, selectedRoot, nearest, pending = nil, nil, math.huge, false
        local origin = doorPoint and (doorPoint-root.Position).Magnitude<=80 and doorPoint or root.Position
        for model, seenAt in pairs(mobs) do
            if not model.Parent or not model:IsDescendantOf(workspace)
                or (model.Name~="Evil Bandit" and model.Name~="Headless Horseman") then mobs[model]=nil; continue end
            local humanoid=model:FindFirstChildOfClass("Humanoid")
            local targetRoot=model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            if not humanoid or not targetRoot then
                if now-seenAt<2 then pending=true end
            elseif humanoid.Health>0 and targetRoot.Parent and (targetRoot.Position-origin).Magnitude<=60 then
                local distance=(targetRoot.Position-root.Position).Magnitude
                if distance<nearest then selected,selectedRoot,nearest=model,targetRoot,distance end
            end
        end
        return selected, selectedRoot, nearest, pending
    end
    local function attack(character, now)
        if m1Input or now<nextM1At then return true end
        local combat=character
        local standEvents=combat:FindFirstChild("StandEvents")
        if not standEvents then
            local living=workspace:FindFirstChild("Living")
            combat=living and living:FindFirstChild(localplr.Name)
            standEvents=combat and combat:FindFirstChild("StandEvents")
        end
        local remote=standEvents and standEvents:FindFirstChild("M1")
        local events=ReplicatedStorage:FindFirstChild("Events")
        local input=events and events:FindFirstChild("AbilityInput")
        if not remote or not remote:IsA("RemoteEvent") or not input or not input:IsA("RemoteEvent") then return false end
        nextM1At=now+.25
        m1Input, m1EndAt=input,now+.08
        input:FireServer("MouseButton1", "Begin", nil)
        if not autoMob or not engine:IsRunning() or localplr.Character~=character then releaseM1();return true end
        remote:FireServer()
        return true
    end
    local function tick(now)
        if now>=nextScanAt then rescan(now) end
        if engine:Get("StandFarm") or engine:Get("JoinLair") or engine:Get("BossLockAura") then
            releaseActions();setStatus("Tạm chờ Stand Farm / Auto Lair dừng");return
        end
        local character=localplr.Character
        local humanoid=character and character:FindFirstChildOfClass("Humanoid")
        local root=character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or humanoid.Health<=0 or not root then
            releaseActions();setStatus("Chờ nhân vật hồi sinh");return
        end
        selectDoor(root)
        local mob, targetRoot, distance, pending=selectMob(root,now)
        if mob then
            releasePrompt()
            nextDoorAt=now+.8
            if not autoMob then stopMovement();setStatus("Có quái quanh cửa — bật Auto Mob để đánh");return end
            if distance>4.5 then
                releaseM1();moveTo(humanoid,root,targetRoot.Position,3.5)
                setStatus("Đang đến "..mob.Name);return
            end
            stopMovement()
            local look=Vector3.new(targetRoot.Position.X,root.Position.Y,targetRoot.Position.Z)
            if (look-root.Position).Magnitude>.01 then root.CFrame=CFrame.lookAt(root.Position,look) end
            if attack(character,now) then setStatus("Đang đánh "..mob.Name.." bằng M1")
            else setStatus("Chờ Stand / remote M1 sẵn sàng") end
            return
        end
        releaseM1()
        if pending then releasePrompt();stopMovement();setStatus("Chờ quái tải đủ bộ phận");return end
        if not autoDoor then releasePrompt();stopMovement();setStatus("Chờ quái quanh cửa");return end
        if not chosenDoor then releaseActions();setStatus("Chưa tải được cửa Halloween");return end
        if not chosenDoor.Enabled then releaseActions();setStatus("Chờ cửa hoạt động / ban đêm");return end
        local doorDistance=(doorPoint-root.Position).Magnitude
        if doorDistance>math.max(0,chosenDoor.MaxActivationDistance-.5) then
            releasePrompt();moveTo(humanoid,root,doorPoint,math.max(0,chosenDoor.MaxActivationDistance*.6))
            setStatus("Đang đến cửa đã chọn");return
        end
        stopMovement()
        if heldPrompt then
            if now>=promptEndAt then releasePrompt();nextDoorAt=now+.8 end
            setStatus("Đang tương tác cửa");return
        end
        if now<nextDoorAt then setStatus("Chờ kết quả cửa");return end
        heldPrompt, promptEndAt=chosenDoor,now+chosenDoor.HoldDuration+.05
        nextDoorAt=promptEndAt+.8
        chosenDoor:InputHoldBegin()
        setStatus("Đang tương tác cửa")
    end
    local function stop()
        if heartbeat then heartbeat:Disconnect();heartbeat=nil end
        if added then added:Disconnect();added=nil end
        releaseActions()
        prompts,mobs={},{}
        chosenDoor,doorPoint=nil,nil
        nextDoorAt,nextM1At,nextScanAt,elapsed=0,0,0,0
    end
    local function update()
        stop()
        if not autoDoor and not autoMob then setStatus("Đã tắt");return end
        setStatus("Đang tìm cửa / quái")
        added=workspace.DescendantAdded:Connect(indexObject)
        heartbeat=game:GetService("RunService").Heartbeat:Connect(function(dt)
            if not engine:IsRunning() then stop();return end
            local now=os.clock()
            if m1Input and now>=m1EndAt then releaseM1() end
            elapsed+=dt
            if elapsed<.1 then return end
            elapsed=0
            local ok,err=pcall(tick,now)
            if not ok then
                autoDoor,autoMob=false,false
                stop()
                engine.Values.HalloweenAutoDoor,engine.Values.HalloweenAutoMob=false,false
                setStatus("Lỗi: "..tostring(err))
                engine:Emit("Changed")
                engine:Notify("Halloween",featureState.halloweenStatus)
            end
        end)
    end
    engine:Define("HalloweenAutoDoor",{Type="boolean"},false,function(value) autoDoor=value;update() end)
    engine:Define("HalloweenAutoMob",{Type="boolean"},false,function(value) autoMob=value;update() end)
    engine:OnStop(function() autoDoor,autoMob=false,false;stop() end)
end

