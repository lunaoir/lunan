            searchBox.Font = Enum.Font.Gotham
            searchBox.TextSize = 11
            searchBox.TextColor3 = Library.COLORS.text
            searchBox.PlaceholderColor3 = Library.COLORS.muted
            searchBox.Visible = false
            searchBox.ZIndex = 46
            searchBox.Parent = menu
            corner(5).Parent = searchBox

            local menuScroll = Instance.new("ScrollingFrame")
            menuScroll.Size = UDim2.new(1, -12, 0, 0)
            menuScroll.Position = UDim2.new(0, 6, 0, 38)
