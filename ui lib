local function targetOptions(state)
    local options={}
    local needle=listQuery:lower():gsub("[^%w]","")
    for _,target in ipairs(state.Targets) do
        if needle=="" or target.Description:lower():gsub("[^%w]",""):find(needle,1,true) then
            table.insert(options,"Target "..target.Index..": "..target.Description)
        end
    end
    if #options==0 then options={"-- No matching targets --"} end
    return options
end
local function invoke(id,value)
