                        end
                        baseEffect.Parent = cloneref3(game:GetService("Lighting"))
                    end

                    function Acrylic2.Disable()
                        for index, effect in pairs(depthOfFieldDefaults) do
                            effect.Enabled = effect.enabled
                        end
                        baseEffect.Parent = nil
