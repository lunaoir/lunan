-- Source Sans covers Vietnamese diacritics; Roboto Mono is used only for numeric values.
local F = {
	Regular = Enum.Font.SourceSans, Semi = Enum.Font.SourceSansSemibold,
	Bold = Enum.Font.SourceSansBold, Mono = Enum.Font.RobotoMono,
}

local function make(class, properties, parent)
	local object = Instance.new(class)
	if object:IsA("GuiObject") then object.BorderSizePixel = 0 end
	for key, value in pairs(properties) do object[key] = value end
	object.Parent = parent
	return object
end

local function corner(parent, radius)
	return make("UICorner", {CornerRadius = UDim.new(0, radius or 6)}, parent)
end

-- Border mode is explicit: the default (Contextual) outlines the glyphs of text objects instead of the box.
local function stroke(parent, color, transparency)
	return make("UIStroke", {
		Color = color or C.Line, Thickness = 1, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function textLabel(parent, properties)
	local base = {
		BackgroundTransparency = 1, Text = "", Font = F.Regular, TextSize = 15, TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		RichText = false, AutoLocalize = false,
	}
	for key, value in pairs(properties) do base[key] = value end
	return make("TextLabel", base, parent)
end

