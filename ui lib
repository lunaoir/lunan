-- User-confirmed open storage buttons are Slots 1, 2 and 4. Slot 4 uses the
-- remote argument "Slot4" and Data.Slot4; Slots 3, 5 and 6 are excluded.
local storageMap = {
    { label = "Slot 1", remote = "Slot1", data = "Slot1" },
    { label = "Slot 2", remote = "Slot2", data = "Slot2" },
    { label = "Slot 4", remote = "Slot4", data = "Slot4" },
}
local accountKey = tostring(localplr.UserId or localplr.Name)
-- V2 intentionally ignores obsolete Slot5 pending records from the earlier map.
local storageFile = "sur_storage_pending_v2_" .. accountKey .. ".json"
local storageMessage = "Ready"
local storagePending
local lastStorageRequest = -math.huge

getgenv().SURStorageStateV2 = getgenv().SURStorageStateV2 or {}
local function persistState(path, value)
    if type(writefile) ~= "function" then
        return false
    end
    local ok = pcall(function()
        writefile(path, jsonservice:JSONEncode(value))
    end)
    if not ok then
        warn("Could not save " .. path)
    end
