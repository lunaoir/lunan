                        if Viewport.Interactive then
                            if
                                (Input.UserInputType == Enum.UserInputType.MouseButton1)
                                or (Input.UserInputType == Enum.UserInputType.Touch and not Pinching)
                            then
                                if Config.WindUI.CurrentInput and Config.WindUI.CurrentInput ~= CurInput2 then
                                    return
                                end

                                Config.WindUI.CurrentInput = CurInput2

                                Dragging = true
                                result = Input.Position
