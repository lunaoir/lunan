            local searchBox = Instance.new("TextBox")
            searchBox.Size = UDim2.new(1, -12, 0, 26)
            searchBox.Position = UDim2.new(0, 6, 0, 6)
            searchBox.BackgroundColor3 = Color3.fromRGB(18, 18, 23)
            searchBox.BorderSizePixel = 0
