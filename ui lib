function Library:SURStandTierBadgeColor(tier, fallback)
    local colors = {
        F = Color3.fromRGB(74, 76, 94),
        E = Color3.fromRGB(91, 82, 108),
        D = Color3.fromRGB(151, 85, 67),
        C = Color3.fromRGB(67, 139, 99),
        B = Color3.fromRGB(117, 184, 52),
        A = Color3.fromRGB(46, 158, 188),
        S = Color3.fromRGB(116, 72, 203),
        SS = Color3.fromRGB(177, 67, 210),
        SSS = Color3.fromRGB(219, 155, 42),
        Q = Color3.fromRGB(218, 73, 123),
        ["Ø"] = Color3.fromRGB(120, 86, 224),
        ["Ω"] = Color3.fromRGB(223, 92, 211),
        ["∞"] = Color3.fromRGB(241, 113, 187),
    }
    local baseTier = tier
    if type(baseTier) == "string" and (baseTier:sub(-1) == "+" or baseTier:sub(-1) == "-") then
        baseTier = baseTier:sub(1, -2)
    end
    return colors[baseTier] or fallback or Color3.fromRGB(72, 55, 123)
end

