        local began = false
        pcall(function()
            abilityInput:FireServer("MouseButton1", "Begin", nil)
            began = true
            m1Remote:FireServer()
        end)
        task.delay(0.08, function()
            if began and abilityInput.Parent then
                pcall(function()
                    abilityInput:FireServer("MouseButton1", "End", nil)
                end)
            end
            lairM1Busy = false
        end)
    end

    local function shutdown()
        if closed then
            return
        end
        closed, Cfg.AutoBossKill, autoM1Enabled = true, false, false
        arrivalBoss, arrivalBossRoot, arrivalCharacterRoot = nil, nil, nil
        auraBoss, auraHumanoid = nil, nil
        lastAuraAt = nil
        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end
        if WasLocking then
            WasLocking = false
            RestoreCollision(LocalPlayer.Character)
        end
    end
    local function active()
        if closed then
            return false
        end
        if getgenv().SURFarmSession ~= hubSession or not engine:IsRunning() then
            shutdown()
            return false
        end
        return true
    end
    local function tryImmediateBossTP()
        if not active() or not Cfg.AutoBossKill then
            return
        end
        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        local myHum = char and char:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHum or myHum.Health <= 0 then
            return
        end
        local boss, bossRoot = GetActiveBoss()
        if not boss or not bossRoot then
            return
        end
        local target = GetLockCFrame(bossRoot)
        if (myRoot.Position - target.Position).Magnitude <= 0.01 then
            return
        end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
        myRoot.CFrame = target
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        -- Do not mark arrival here; Heartbeat must still observe it.
    end
    connections[#connections + 1] = workspace.DescendantAdded:Connect(function(descendant)
        if not Cfg.AutoBossKill then
            return
        end
        local boss = descendant.Name == "Boss" and descendant or descendant.Parent
        if boss and boss.Name == "Boss" and boss:IsA("Model")
            and boss.Parent == workspace:FindFirstChild("Living")
            and (descendant == boss or descendant:IsA("Humanoid") or descendant:IsA("BasePart")) then
            tryImmediateBossTP()
        end
    end)
    connections[#connections + 1] = RunService.Stepped:Connect(function()
        if not active() then
            return
        end
        if not Cfg.AutoBossKill then
            return
        end
        local char = LocalPlayer.Character
        if not char then
            return
        end

        local boss, bossRoot = GetActiveBoss()
        if boss and bossRoot then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
            -- Acquire a new target before physics; Heartbeat still observes
            -- arrival and owns the Aura interval and regular position lock.
            local myRoot = char:FindFirstChild("HumanoidRootPart")
            local myHum = char:FindFirstChildOfClass("Humanoid")
            if myRoot and myHum and myHum.Health > 0
                and (arrivalBoss ~= boss or arrivalBossRoot ~= bossRoot or arrivalCharacterRoot ~= myRoot) then
                myRoot.CFrame = GetLockCFrame(bossRoot)
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)
    connections[#connections + 1] = RunService.Heartbeat:Connect(function()
        if not active() then
            return
        end
        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        local myHum = char and char:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHum or myHum.Health <= 0 then
            arrivalBoss, arrivalBossRoot, arrivalCharacterRoot = nil, nil, nil
            return
        end

        local boss, bossRoot, bossHum = GetActiveBoss()

        -- A. Khi có Boss: Tự động TP tới Boss + Khóa vị trí + Kill Aura
        if Cfg.AutoBossKill and boss and bossRoot and bossHum then
            WasLocking = true

            local lockCFrame = GetLockCFrame(bossRoot)
            -- Observe arrival before writing this frame's TP. A new boss or
            -- character must complete its own TP cycle before Aura can run.
            local arrived = arrivalBoss == boss
                and arrivalBossRoot == bossRoot
                and arrivalCharacterRoot == myRoot
                and (myRoot.Position - lockCFrame.Position).Magnitude <= 2

            -- Khóa vị trí theo khoảng cách Xa/Gần đã chỉnh
            myRoot.CFrame = lockCFrame
            arrivalBoss, arrivalBossRoot, arrivalCharacterRoot = boss, bossRoot, myRoot
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero

            -- A new boss/Humanoid bypasses the previous round's cooldown.
            -- The same boss repeats at the selected interval, after arrival only.
            if auraBoss ~= boss or auraHumanoid ~= bossHum then
                auraBoss, auraHumanoid = boss, bossHum
                lastAuraAt = nil
            end
            local now = os.clock()
            if arrived and (not lastAuraAt or now - lastAuraAt >= Cfg.AuraInterval) then
                lastAuraAt = now
                pcall(function()
                    sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
                    if bossHum.Health > 0 and (myRoot.Position - bossRoot.Position).Magnitude <= 35 then
                        bossHum.Health = 0
                    end
                end)
            end

        -- B. Ngay khi Boss chết/biến mất: Nhả khóa ngay lập tức để chuyển Lair không bị kẹt khoảng không
        else
            arrivalBoss, arrivalBossRoot, arrivalCharacterRoot = nil, nil, nil
            if WasLocking then
                WasLocking = false
                myRoot.AssemblyLinearVelocity = Vector3.zero
                RestoreCollision(char)
                -- Nếu đang ở dưới đất thì nhấc nhân vật lên mặt sàn an toàn
                if Cfg.Mode == "Dưới chân" then
                    myRoot.CFrame += Vector3.new(0, Cfg.Dist + 4, 0)
                end
            end
        end
    end)
    connections[#connections + 1] = RunService.Heartbeat:Connect(function()
        if not active() or not autoM1Enabled then
            return
        end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not myRoot then
            return
        end
        local boss, bossRoot, bossHum = GetActiveBoss()
        if not boss or not bossRoot or not bossHum then
            return
        end
        -- Keep the M1 switch independent; attack only at the selected lock
        -- position, whether reached by TP/Lock or by moving there separately.
        if (myRoot.Position - GetLockCFrame(bossRoot).Position).Magnitude > 2 then
            return
        end
        pressLairM1()
    end)
    engine:OnStop(shutdown)

    
    engine:Define("AuraInterval", {Type="number", Flag="LairAuraIntervalSeconds", Range={0.1,30}, Increment=0.1}, Cfg.AuraInterval, function(value)
        Cfg.AuraInterval = value
    end)
    engine:Define("BossDistance", {Type="number", Flag="LairBossDistanceStuds", Range={1,30}, Increment=0.5}, Cfg.Dist, function(value)
        if Cfg.Dist ~= value then
            arrivalBoss, arrivalBossRoot, arrivalCharacterRoot = nil, nil, nil
        end
        Cfg.Dist = value
    end)

    engine:Define("BossLockAura", {Type="boolean"}, false, function(v)
        if Cfg.AutoBossKill ~= v then
            arrivalBoss, arrivalBossRoot, arrivalCharacterRoot = nil, nil, nil
            auraBoss, auraHumanoid = nil, nil
            lastAuraAt = nil
        end
        Cfg.AutoBossKill = v
        if v then
            tryImmediateBossTP()
        end
        if not v and LocalPlayer.Character then
            WasLocking = false
            RestoreCollision(LocalPlayer.Character)
        end
    end)

    engine:Define("AutoM1", {Type="boolean"}, false, function(value)
        autoM1Enabled = value == true
    end)
end
