    local function parseServerAge(text,allowClock)
        text=string.lower(tostring(text or ""):gsub("<[^>]*>",""))
        local body=text:match("server%s*time%s*:%s*(.+)") or text:match("server%s*age%s*:%s*(.+)")
        if not body and allowClock then body=text end
        if not body then return nil end
        local h,m,s=body:match("^(%d+):(%d+):(%d+)%s*$")
        if h and tonumber(m)<60 and tonumber(s)<60 then return tonumber(h)*3600+tonumber(m)*60+tonumber(s) end
        m,s=body:match("^(%d+):(%d+)%s*$")
        if m and tonumber(s)<60 then return tonumber(m)*60+tonumber(s) end
        local d=body:match("(%d+)%s*days?")
        h=body:match("(%d+)%s*hours?")
        m=body:match("(%d+)%s*minutes?")
        s=body:match("(%d+)%s*seconds?")
        if d or h or m or s then return (tonumber(d) or 0)*86400+(tonumber(h) or 0)*3600+(tonumber(m) or 0)*60+(tonumber(s) or 0) end
        return nil
    end
    local function labelAge(obj)
        if not obj or not obj.Parent or obj:IsDescendantOf(screenGui) then return nil end
        if not obj:IsA("TextLabel") and not obj:IsA("TextButton") then return nil end
        local name=string.lower(obj.Name):gsub("[%s_]","")
        return parseServerAge(obj.Text,name=="servertime" or name=="serverage" or name=="serveruptime")
    end
    local function readServerAge()
        local age=labelAge(serverLabel)
        if age then return age end
        serverLabel=nil
