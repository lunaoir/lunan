	})
	subtitleHolder.Visible = (options.Subtitle or "") ~= ""
	make("Frame", {BackgroundColor3 = C.Line, Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1)}, header)

	local tooltip = textLabel(gui, {
		Name = "Tooltip", Visible = false, ZIndex = 30, BackgroundTransparency = 0, BackgroundColor3 = C.Group,
		TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(100, 26),
	})
	corner(tooltip, 6); stroke(tooltip, C.LineStrong)
	local tipTicket = 0
	local function hideTooltip() tipTicket += 1; tooltip.Visible = false end
	local function tip(button, message)
		button.MouseEnter:Connect(function()
			if touchOnly then return end
			tipTicket += 1
			local ticket = tipTicket
			later(.35, function()
				if ticket ~= tipTicket or not button.Visible then return end
				local view = viewport()
				local widthNeeded = measureWidth(message, F.Regular, 14) + 18
				tooltip.Text, tooltip.Size = message, UDim2.fromOffset(widthNeeded, 26)
				local point, size = button.AbsolutePosition, button.AbsoluteSize
				tooltip.Position = UDim2.fromOffset(
					math.clamp(point.X + size.X / 2 - widthNeeded / 2, 6, math.max(6, view.X - widthNeeded - 6)),
					math.clamp(point.Y + size.Y + 6, 6, math.max(6, view.Y - 32)))
				tooltip.Visible = true
			end)
		end)
		button.MouseLeave:Connect(hideTooltip)
	end

	local function headerButton(x, iconName, message, hoverColor)
		local button = make("TextButton", {
			Text = "", AutoButtonColor = false, BackgroundColor3 = C.White, BackgroundTransparency = 1,
			Position = UDim2.new(1, x, 0, 8), Size = UDim2.fromOffset(30, 30),
		}, header)
		corner(button, 6)
		local glyph = drawIcon(button, iconName, 14, C.Muted)
		glyph.Frame.Position = UDim2.fromOffset(8, 8)
		button.MouseEnter:Connect(function()
			if touchOnly then return end
			animate(button, {BackgroundTransparency = .92}, .1)
			glyph:SetColor(hoverColor or C.Text)
		end)
		button.MouseLeave:Connect(function()
			animate(button, {BackgroundTransparency = 1}, .12)
			glyph:SetColor(C.Muted)
		end)
		button.MouseButton1Down:Connect(function() animate(button, {BackgroundTransparency = .85}, .05) end)
		button.MouseButton1Up:Connect(function() animate(button, {BackgroundTransparency = touchOnly and 1 or .92}, .1) end)
		tip(button, message)
		return button, glyph
	end
	local minimizeButton, minimizeGlyph = headerButton(-72, "minus", "Thu nhỏ")
	local restoreGlyph = drawIcon(minimizeButton, "expand", 14, C.Muted)
	restoreGlyph.Frame.Position = UDim2.fromOffset(8, 8)
	restoreGlyph.Frame.Visible = false
	minimizeButton.MouseEnter:Connect(function() if not touchOnly then restoreGlyph:SetColor(C.Text) end end)
	minimizeButton.MouseLeave:Connect(function() restoreGlyph:SetColor(C.Muted) end)
	local closeButton = headerButton(-38, "close", "Ẩn menu · " .. toggleKey.Name, C.Bad)

	local sidebar = make("Frame", {Name = "Sidebar", BackgroundColor3 = C.Sidebar, Position = UDim2.fromOffset(0, HEADER), Size = UDim2.new(0, L.Nav, 1, -(HEADER + FOOTER))}, body)
	make("Frame", {BackgroundColor3 = C.Line, Position = UDim2.new(1, -1, 0, 0), Size = UDim2.new(0, 1, 1, 0)}, sidebar)
	local navigation = make("ScrollingFrame", {
		Name = "Navigation", BackgroundTransparency = 1, Size = UDim2.new(1, -1, 1, 0), CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.Y,
	}, sidebar)
	make("UIPadding", {PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, navigation)
	make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}, navigation)

	local content = make("Frame", {Name = "Content", BackgroundTransparency = 1, Position = UDim2.fromOffset(L.Nav, HEADER), Size = UDim2.new(1, -L.Nav, 1, -(HEADER + FOOTER))}, body)

	local footer = make("Frame", {Name = "Footer", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -FOOTER), Size = UDim2.new(1, 0, 0, FOOTER)}, body)
	make("Frame", {BackgroundColor3 = C.Line, Size = UDim2.new(1, 0, 0, 1)}, footer)
	local statusDot = make("Frame", {BackgroundColor3 = C.Faint, Position = UDim2.fromOffset(16, 11), Size = UDim2.fromOffset(8, 8), Visible = false}, footer)
	corner(statusDot, 8)
	local statusText = textLabel(footer, {
		Text = options.Footer or "", TextSize = 14, TextColor3 = C.Muted, Position = UDim2.fromOffset(16, 1),
		Size = UDim2.new(1, -150, 1, -1), TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local keyHint = textLabel(footer, {
		Text = toggleKey.Name .. " · Ẩn / hiện", TextSize = 13, TextColor3 = C.Faint, TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -150, 0, 1), Size = UDim2.fromOffset(112, FOOTER - 1),
	})
	local grip = make("TextButton", {Name = "Resize", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Position = UDim2.new(1, -30, 0, 3), Size = UDim2.fromOffset(26, 26)}, footer)
	local gripIcon = drawIcon(grip, "grip", 12, C.Faint)
	gripIcon.Frame.Position = UDim2.fromOffset(9, 9)
	grip.MouseEnter:Connect(function() gripIcon:SetColor(C.Muted) end)
	grip.MouseLeave:Connect(function() gripIcon:SetColor(C.Faint) end)

	function window:SetStatus(value, tone)
		if self.Destroyed then return end
		if value == nil or value == "" then
			statusText.Text = options.Footer or ""
			statusDot.Visible = false
			return
		end
		statusText.Text = tostring(value)
		local color = tone and TONES[string.lower(tostring(tone))]
		statusDot.Visible = color ~= nil
		if color then statusDot.BackgroundColor3 = color end
		statusText.Position = UDim2.fromOffset(color and 32 or 16, 1)
