        local frames = 0
        local lastTick = os.clock()
        connect(RunService.RenderStepped, function()
            frames = frames + 1
            local now = os.clock()
            if now - lastTick >= 0.5 then
                local fps = math.clamp(math.floor(frames / (now - lastTick) + 0.5), 1, 999)
                fpsCounterVal.Text = tostring(fps) .. " FPS"
                frames = 0
                lastTick = now

                local ping = 0
                pcall(function()
