                    end
                local UserInputService2 = cloneref3(game:GetService("UserInputService"))

                local Creator2 = moduleRegistry.load("src/modules/Creator")
                local New2 = Creator2.New

                function ScrollSlider.New(ScrollingFrame, ScrollingFrame2, Parent, Window2, Thickness)
                    local Slider = New2("Frame", {
                        Size = UDim2.new(0, Window2, 1, 0),
                        BackgroundTransparency = 1,
                        Position = UDim2.new(1, 0, 0, 0),
                        AnchorPoint = Vector2.new(1, 0),
                        Parent = ScrollingFrame2,
                        ZIndex = 999,
                        Active = true,
                    })

                    local Thumb = Creator2.NewRoundFrame(Window2 / 2, "Squircle", {
                        Size = UDim2.new(1, 0, 0, 0),
                        ImageTransparency = 0.85,
                        ThemeTag = { ImageColor3 = "Text" },
                        Parent = Slider,
                    })

                    local Hitbox = New2("Frame", {
                        Size = UDim2.new(1, 12, 1, 12),
                        Position = UDim2.new(0.5, 0, 0.5, 0),
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        BackgroundTransparency = 1,
                        Active = true,
                        ZIndex = 999,
                        Parent = Thumb,
                    })

                    local isDragging = Creator2:GenerateUniqueID()
                    local enabled = false
                    local dragOffset, releaseConnection

                    local function updateThumbPosition()
                        local canvasSize = ScrollingFrame.AbsoluteCanvasSize.Y
                        local windowSize = ScrollingFrame.AbsoluteWindowSize.Y

                        if canvasSize <= windowSize then
                            Thumb.Visible = false
                            return
                        end

                        Thumb.Visible = true

                        local maxScroll = math.clamp(windowSize / canvasSize, 0.05, 1)
                        Thumb.Size = UDim2.new(1, 0, maxScroll, 0)

                        local result = canvasSize - windowSize
                        local result2 = 1 - maxScroll

                        if result > 0 then
                            local result3 = ScrollingFrame.CanvasPosition.Y / result
                            Thumb.Position = UDim2.new(0, 0, math.clamp(result3 * result2, 0, result2), 0)
                        else
                            Thumb.Position = UDim2.new(0, 0, 0, 0)
                        end
                    end

                    local function StopDrag()
                        if Thickness.CurrentInput == isDragging then
                            Thickness.CurrentInput = nil
                        end
                        enabled = false
                        ScrollingFrame.ScrollingEnabled = true
                        if dragOffset then
                            dragOffset:Disconnect()
                        end
                        if releaseConnection then
                            releaseConnection:Disconnect()
                        end
                    end

                    Creator2.AddSignal(Hitbox.InputBegan, function(argument)
                        if
                            argument.UserInputType ~= Enum.UserInputType.MouseButton1
                            and argument.UserInputType ~= Enum.UserInputType.Touch
                        then
                            return
                        end
                        if enabled then
                            return
                        end
                        if Thickness.CurrentInput and Thickness.CurrentInput ~= isDragging then
                            return
                        end

                        Thickness.CurrentInput = isDragging

                        enabled = true
                        ScrollingFrame.ScrollingEnabled = false

                        local result = argument.Position.Y
                        local result2 = ScrollingFrame.CanvasPosition.Y

                        dragOffset = UserInputService2.InputChanged:Connect(function(changedInput)
                            if
                                changedInput.UserInputType == Enum.UserInputType.MouseMovement
                                or changedInput.UserInputType == Enum.UserInputType.Touch
                            then
                                local sliderTop = changedInput.Position.Y - result

                                local result3 = ScrollingFrame.AbsoluteCanvasSize.Y
                                local result4 = ScrollingFrame.AbsoluteWindowSize.Y
                                local newThumbPosScale = math.max(result3 - result4, 0)

                                local result5 = Slider.AbsoluteSize.Y
                                local result6 = Thumb.AbsoluteSize.Y
                                local maxThumbPos = math.max(result5 - result6, 1)

                                local result7 = sliderTop * (newThumbPosScale / maxThumbPos)

                                ScrollingFrame.CanvasPosition = Vector2.new(
                                    ScrollingFrame.CanvasPosition.X,
                                    math.clamp(result2 + result7, 0, newThumbPosScale)
                                )
                            end
                        end)

                        releaseConnection = UserInputService2.InputEnded:Connect(function(endInput)
                            if endInput.UserInputType == argument.UserInputType then
                                if Thickness.CurrentInput and Thickness.CurrentInput ~= isDragging then
                                    return
                                end

                                Thickness.CurrentInput = nil

                                StopDrag()
                            end
                        end)
                    end)

                    Creator2.AddSignal(
                        ScrollingFrame:GetPropertyChangedSignal("AbsoluteWindowSize"),
                        updateThumbPosition
                    )
                    Creator2.AddSignal(
                        ScrollingFrame:GetPropertyChangedSignal("AbsoluteCanvasSize"),
                        updateThumbPosition
                    )
                    Creator2.AddSignal(
                        ScrollingFrame:GetPropertyChangedSignal("CanvasPosition"),
                        updateThumbPosition
                    )

                    updateThumbPosition()

                    return Slider
                end

                return ScrollSlider
            end

