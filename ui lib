-- Run this local preview with Luna_UI_Library.lua in the executor workspace.
-- This displays controls only. It does not join, teleport, farm or attack.
assert(type(readfile) == "function" and type(loadstring) == "function", "Preview requires readfile and loadstring")
local chunk, compileError = loadstring(readfile("Luna_UI_Library.lua"), "@Luna_UI_Library.lua")
assert(chunk, compileError)
local UI = chunk()
local window = UI.CreateWindow({
	Title = "LUNA", Subtitle = "Stand Upright Rebooted",
	Footer = "BẢN XEM TRƯỚC · CHƯA KẾT NỐI GAME",
})
local stand = window:Tab({Name = "Stand", Icon = "stand", Description = "Mẫu ô chọn và công tắc."})
stand:Section("ĐIỀU KHIỂN MẪU")
stand:Dropdown({Name = "Vật phẩm", Options = {"Stand Arrow", "Charged Arrow", "Kars Mask"}, Default = "Stand Arrow"})
stand:Toggle({Name = "Stand Farm", Default = false})
local lair = window:Tab({Name = "Lair", Icon = "lair", Description = "Các điều khiển cùng một chỗ."})
lair:Section("VÀO PHÒNG")
lair:Dropdown({Name = "Cấp độ", Options = {"Lv. 200"}, Default = "Lv. 200"})
lair:Toggle({Name = "Join Lair", Hint = "Giữ bật cho đến khi anh tắt.", Default = false})
lair:Section("BÁM MỤC TIÊU")
lair:Toggle({Name = "TP / Lock Boss", Hint = "Mẫu hiển thị trạng thái bật.", Default = true})
lair:Slider({Name = "Khoảng cách", Min = 1, Max = 30, Step = .5, Default = 7, Unit = "stud"})
lair:Slider({Name = "Nhịp Kill Aura", Min = .1, Max = 30, Step = .1, Default = 3, Unit = "giây"})
local settings = window:Tab({Name = "Thiết lập", Icon = "settings", Description = "Mẫu trạng thái và cách hiển thị."})
settings:Section("THƯ VIỆN LUNA")
settings:Label("Bảng màu: than / trắng ngà / cát")
settings:Label("Phím K hoặc nút mèo để thu / mở menu")
settings:Button({Name = "Đóng bản xem trước", Callback = function() window:Destroy() end})
lair:Select()
return window
