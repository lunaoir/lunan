local function drawIcon(parent, name, px, color)
	local holder = make("Frame", {Name = "Icon", BackgroundTransparency = 1, Size = UDim2.fromOffset(px, px)}, parent)
	local canvas = make("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16)}, holder)
	make("UIScale", {Scale = px / 16}, canvas)
	local parts = {}
	for _, poly in ipairs(ICONS[name] or ICONS.stand) do
		for index = 1, #poly - 1 do
			local a, b = poly[index], poly[index + 1]
			local dx, dy = b[1] - a[1], b[2] - a[2]
			parts[#parts + 1] = make("Frame", {
				AnchorPoint = Vector2.new(.5, .5), BackgroundColor3 = color,
				Position = UDim2.fromOffset((a[1] + b[1]) / 2, (a[2] + b[2]) / 2),
				Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + poly.w * .5, poly.w),
				Rotation = math.deg(math.atan2(dy, dx)),
			}, canvas)
		end
	end
	local icon = {Frame = holder}
	function icon:SetColor(new)
		for _, part in ipairs(parts) do part.BackgroundColor3 = new end
	end
	return icon
end

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function callback(fn, value)
	if type(fn) ~= "function" then return end
	local ok, message = pcall(fn, value)
	if not ok then warn("[Luna UI] callback: " .. tostring(message)) end
end

local function clip(value, limit)
	value = tostring(value)
	local ok, cut = pcall(utf8.offset, value, limit + 1)
	if ok and cut then return string.sub(value, 1, cut - 1) .. "…" end
	return value
end

function Library.CreateWindow(options)
	options = options or {}
	local Players = game:GetService("Players")
	local Input = game:GetService("UserInputService")
	local Tweens = game:GetService("TweenService")
	local TextService = game:GetService("TextService")
	local host = options.Parent
	if not host then
		local player = Players.LocalPlayer
		assert(player, "Luna UI requires a client or an explicit Parent")
		host = player:WaitForChild("PlayerGui")
	end
	local identity = options.Id or "LunaUI_05"
	-- A re-run replaces the previous window, which also stops its feature session through OnDestroy.
	for _, child in ipairs(host:GetChildren()) do
		if child:IsA("ScreenGui") and child.Name == identity and child:GetAttribute("LunaUIOwner") == "Design05" then child:Destroy() end
	end
	local gui = make("ScreenGui", {
		Name = identity, ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = options.DisplayOrder or 50,
	}, host)
	gui:SetAttribute("LunaUIOwner", "Design05")

	local HEADER, FOOTER = 46, 30
	local GROUP_PAD, ROW_PAD_X, ROW_PAD_Y = 4, 12, 10
	local toggleKey = options.ToggleKey or Enum.KeyCode.K
	local touchOnly = Input.TouchEnabled and not Input.MouseEnabled

	local window = {Gui = gui, Tabs = {}, Open = options.StartClosed ~= true, Minimized = false, Destroyed = false}
	local connections, pending, destroyHandlers = {}, {}, {}
	local tweens = setmetatable({}, {__mode = "k"})
	local tabs = window.Tabs
	local currentTab = nil
	local drag, scrub, resizing, popup = nil, nil, nil, nil
	local sizePreference = nil
	local launcherCustom, launcherMoved = false, false
	local L = {Width = 780, Height = 540, Nav = 176, PagePad = 24, RowInner = 520, Stack = false, Narrow = false}
	local closePopup, endScrub, endPointer, relayoutTab, applyLayout, setTab, placeLauncher

	local function own(signal, fn)
		local connection = signal:Connect(fn)
		table.insert(connections, connection)
		return connection
	end

	local function later(seconds, fn)
		local thread
		thread = task.delay(options.ReducedMotion and 0 or seconds, function()
			pending[thread] = nil
			if not window.Destroyed then fn() end
		end)
		pending[thread] = true
		return thread
	end

	local function cancelLater(thread)
		if thread and pending[thread] then
			pending[thread] = nil
			task.cancel(thread)
		end
	end

	-- A new tween replaces only running tweens that touch the same properties of the same object.
	local function animate(object, properties, duration, finished, style)
		if window.Destroyed then return end
		local active = tweens[object]
		if active then
			local stale = {}
			for tween, keys in pairs(active) do
				for key in pairs(properties) do
					if keys[key] then table.insert(stale, tween); break end
				end
			end
			for _, tween in ipairs(stale) do active[tween] = nil; tween:Cancel() end
		end
		if options.ReducedMotion or duration <= 0 then
			for key, value in pairs(properties) do object[key] = value end
			if finished then finished() end
			return
		end
		local tween = Tweens:Create(object, TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), properties)
		local keys = {}
		for key in pairs(properties) do keys[key] = true end
		active = tweens[object] or {}
		tweens[object] = active
		active[tween] = keys
		tween.Completed:Once(function(status)
			active[tween] = nil
			if next(active) == nil and tweens[object] == active then tweens[object] = nil end
			if status == Enum.PlaybackState.Completed and not window.Destroyed and finished then finished() end
		end)
		tween:Play()
	end

	local function viewport()
		local size = gui.AbsoluteSize
		if size.X >= 2 and size.Y >= 2 then return size end
		local camera = workspace.CurrentCamera
		return camera and camera.ViewportSize or Vector2.new(800, 600)
	end

	local function measure(value, font, size, available)
		if value == nil or value == "" then return 0 end
		local ok, bounds = pcall(TextService.GetTextSize, TextService, value, size, font, Vector2.new(math.max(24, available), 100000))
		if ok then return math.ceil(bounds.Y) + 1 end
		return size + 4
	end

	local function measureWidth(value, font, size)
		local ok, bounds = pcall(TextService.GetTextSize, TextService, value, size, font, Vector2.new(100000, 100000))
		if ok then return math.ceil(bounds.X) end
		return math.ceil(#value * size * .55)
	end

	-- Hover, pressed and rest tints for transparent list rows. Touch screens skip hover (it would stick).
	local function bindTint(button, rest, hover, pressed)
		button.MouseEnter:Connect(function()
			if not touchOnly then animate(button, {BackgroundTransparency = hover}, .1) end
		end)
		button.MouseLeave:Connect(function() animate(button, {BackgroundTransparency = rest}, .12) end)
		button.MouseButton1Down:Connect(function() animate(button, {BackgroundTransparency = pressed}, .05) end)
		button.MouseButton1Up:Connect(function()
			animate(button, {BackgroundTransparency = touchOnly and rest or hover}, .1)
		end)
	end

