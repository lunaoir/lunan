					end)
					option.MouseLeave:Connect(function()
						if not item.Selected then animate(option, {BackgroundTransparency = 1}, .1) end
					end)
					option.Activated:Connect(function()
						if window.Destroyed or not popup or popup.Group ~= group then return end
						choose(entry)
					end)
				end
				local function reflow()
					local y, shown = 6, 0
					for _, item in ipairs(rows) do
						if item.Match then
							item.Button.Visible = true
							item.Button.Position = UDim2.fromOffset(6, y)
							item.Top = y
							y += item.Height + 2
							shown += 1
						else item.Button.Visible = false end
					end
					contentHeight = y + 4
					list.CanvasSize = UDim2.fromOffset(0, contentHeight)
					emptyLabel.Visible = shown == 0
					if shown == 0 then contentHeight = 50 end
				end
				local function paintOptions()
					for _, item in ipairs(rows) do
						local enabled = isSelected(item.Entry)
						item.Selected = enabled
						item.Button.BackgroundColor3 = enabled and C.AccentSoft or C.White
						animate(item.Button, {BackgroundTransparency = enabled and 0 or 1}, 0)
						item.Check.Frame.Visible = enabled
						item.Label.TextColor3 = enabled and C.Accent or C.Text
					end
				end
				local function place()
					if window.Destroyed or not popup or popup.Group ~= group then return end
					local v = viewport()
					local anchor, anchorSize = buttonNode.AbsolutePosition, buttonNode.AbsoluteSize
					local scrollPosition, scrollSize = tab.Scroll.AbsolutePosition, tab.Scroll.AbsoluteSize
					if anchor.Y + anchorSize.Y < scrollPosition.Y or anchor.Y > scrollPosition.Y + scrollSize.Y then closePopup(); return end
					local desired = top + contentHeight
					local below = v.Y - (anchor.Y + anchorSize.Y) - 14
					local above = anchor.Y - 14
					local useBelow = below >= math.min(desired, 240) or below >= above
					local room = useBelow and below or above
					local height = math.min(desired, 360, math.max(room, 96), v.Y - 16)
					local x = math.clamp(anchor.X + anchorSize.X - menuWidth, 8, math.max(8, v.X - menuWidth - 8))
					local y = useBelow and (anchor.Y + anchorSize.Y + 6) or (anchor.Y - height - 6)
					y = math.clamp(y, 8, math.max(8, v.Y - height - 8))
					group.Size = UDim2.fromOffset(menuWidth, height)
					group.Position = UDim2.fromOffset(x, y)
				end
				popup = {Control = control, Group = group, Scrim = scrim, Tab = tab, Paint = paintOptions, Connections = {}}
				table.insert(popup.Connections, buttonNode:GetPropertyChangedSignal("AbsolutePosition"):Connect(place))
				table.insert(popup.Connections, tab.Scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(place))
				if search then
					search:GetPropertyChangedSignal("Text"):Connect(function()
						local query = string.lower(search.Text)
						for _, item in ipairs(rows) do
							item.Match = query == "" or string.find(item.Lower, query, 1, true) ~= nil
						end
						reflow(); place()
					end)
				end
				reflow(); paintOptions(); place()
				if not multiple then
					for _, item in ipairs(rows) do
						if item.Selected and item.Top then
							list.CanvasPosition = Vector2.new(0, math.max(0, item.Top - 40))
							break
						end
					end
				end
				control.SetOpenVisual(true)
				animate(group, {GroupTransparency = 0}, .12)
			end
			buttonNode.MouseEnter:Connect(function()
				if not touchOnly and not (popup and popup.Control == control) then animate(buttonStroke, {Color = C.LineStrong}, .1) end
			end)
			buttonNode.MouseLeave:Connect(function()
				if not (popup and popup.Control == control) then animate(buttonStroke, {Color = C.Line}, .12) end
			end)
			buttonNode.Activated:Connect(openPopup)
			return register(control)
		end

		function tab:Input(settings)
			local row = addRow(self, {Name = settings.Name, Hint = settings.Hint, ControlW = 236, ControlH = 34, MinH = 54, StackOnNarrow = true})
			local box = make("TextBox", {
				Text = tostring(settings.Default or ""), PlaceholderText = settings.Placeholder or "", PlaceholderColor3 = C.Faint,
				ClearTextOnFocus = false, BackgroundColor3 = C.Input, TextColor3 = C.Text, Font = F.Regular, TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left, ClipsDescendants = true, Size = UDim2.fromScale(1, 1),
			}, row.Slot)
			corner(box, 6)
			local boxStroke = stroke(box, C.Line)
			make("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, box)
			box.Focused:Connect(function() animate(boxStroke, {Color = C.Accent}, .1) end)
			local value = box.Text
			local control = {Element = row.Frame}
			function control:Get() return value end
			function control:IsBusy() return box:IsFocused() end
			function control:Set(new, silent)
				if window.Destroyed or type(new) ~= "string" or new == value then return false end
				value = new; box.Text = value
				if not silent then callback(settings.Callback, value) end
				return true
			end
			box.FocusLost:Connect(function()
				animate(boxStroke, {Color = C.Line}, .12)
				control:Set(box.Text)
			end)
			return register(control)
		end

		function tab:Button(settings)
			local primary = settings.Primary == true or settings.Style == "primary"
			local row = addRow(self, {
				Name = settings.Name, Hint = settings.Hint, MinH = primary and 42 or 44, Interactive = true, NoTint = primary,
				ControlW = (not primary) and 16 or nil, ControlH = (not primary) and 16 or nil,
				NameAlign = primary and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
				NameColor = primary and C.OnAccent or C.Text,
			})
			local enabled = settings.Disabled ~= true
			local arrow
			if primary then
				row.Frame.BackgroundColor3, row.Frame.BackgroundTransparency = C.Accent, 0
				local frame = row.Frame
				frame.MouseEnter:Connect(function() if enabled and not touchOnly then animate(frame, {BackgroundColor3 = C.AccentHover}, .1) end end)
				frame.MouseLeave:Connect(function() animate(frame, {BackgroundColor3 = enabled and C.Accent or C.Rail}, .12) end)
				frame.MouseButton1Down:Connect(function() if enabled then animate(frame, {BackgroundColor3 = C.AccentPress}, .05) end end)
				frame.MouseButton1Up:Connect(function() animate(frame, {BackgroundColor3 = enabled and (touchOnly and C.Accent or C.AccentHover) or C.Rail}, .1) end)
			else
				arrow = drawIcon(row.Slot, "arrow", 16, C.Muted)
			end
			local control = {Element = row.Frame}
			function control:SetEnabled(value)
				if window.Destroyed then return end
				enabled = value ~= false
				row.Name.TextTransparency = enabled and 0 or .55
				if primary then row.Frame.BackgroundColor3 = enabled and C.Accent or C.Rail end
				if arrow then arrow:SetColor(enabled and C.Muted or C.Faint) end
			end
			function control:Set() end
			row.Frame.Activated:Connect(function()
				if enabled and not window.Destroyed then callback(settings.Callback) end
			end)
			if not enabled then control:SetEnabled(false) end
			return register(control)
		end

		if not currentTab then setTab(tab) end
		return tab
	end
	function window:Tab(settings) return newTab(self, settings) end

	---------------------------------------------------------------- pointer + keyboard
	titlebar.InputBegan:Connect(function(input)
		if window.Destroyed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			closePopup(); hideTooltip()
			drag = {Input = input, Start = input.Position, Origin = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset), Target = root}
		end
	end)
	launcherHit.InputBegan:Connect(function(input)
		if window.Destroyed then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			launcherMoved = false
			drag = {Input = input, Start = input.Position, Origin = Vector2.new(launcher.Position.X.Offset, launcher.Position.Y.Offset), Target = launcher}
		end
	end)
	grip.InputBegan:Connect(function(input)
		if window.Destroyed or window.Minimized then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			closePopup(); hideTooltip()
			resizing = {Input = input, Start = input.Position, Origin = Vector2.new(L.Width, L.Height)}
		end
	end)

	local function follows(state, input, mouseMove)
		if not state then return false end
		if input == state.Input then return true end
		return mouseMove and state.Input.UserInputType == Enum.UserInputType.MouseButton1
	end

	own(Input.InputBegan, function(input, processed)
		if window.Destroyed then return end
		if input.KeyCode == Enum.KeyCode.Escape then closePopup() end
		if processed or Input:GetFocusedTextBox() then return end
		if input.KeyCode == toggleKey then window:Toggle() end
	end)

	own(Input.InputChanged, function(input)
		if window.Destroyed then return end
		local mouseMove = input.UserInputType == Enum.UserInputType.MouseMovement
		-- A mouse button released outside the game window never reports InputEnded; stop instead of sticking.
		if mouseMove and (scrub or drag or resizing) and not Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			local touching = (scrub and scrub.Input.UserInputType == Enum.UserInputType.Touch)
				or (drag and drag.Input.UserInputType == Enum.UserInputType.Touch)
				or (resizing and resizing.Input.UserInputType == Enum.UserInputType.Touch)
			if not touching then endPointer(); return end
		end
		if follows(scrub, input, mouseMove) then scrub.Update(input.Position.X) end
		if follows(drag, input, mouseMove) then
			local view = viewport()
			local delta = input.Position - drag.Start
			if drag.Target == launcher then
				if not launcherMoved and delta.Magnitude < 6 then return end
				launcherMoved, launcherCustom = true, true
				hideTooltip()
				launcher.Position = UDim2.fromOffset(
					math.clamp(drag.Origin.X + delta.X, 4, math.max(4, view.X - 48)),
					math.clamp(drag.Origin.Y + delta.Y, 4, math.max(4, view.Y - 48)))
			else
				local x, y = clampRoot(drag.Origin.X + delta.X, drag.Origin.Y + delta.Y)
				root.Position = UDim2.fromOffset(x, y)
			end
		end
		if follows(resizing, input, mouseMove) then
			local delta = input.Position - resizing.Start
			sizePreference = Vector2.new(resizing.Origin.X + delta.X, resizing.Origin.Y + delta.Y)
			applyLayout(false)
		end
	end)

	own(Input.InputEnded, function(input)
		if window.Destroyed then return end
		local mouseEnded = input.UserInputType == Enum.UserInputType.MouseButton1
		if follows(scrub, input, mouseEnded) then endScrub() end
		if follows(drag, input, mouseEnded) then drag = nil end
		if follows(resizing, input, mouseEnded) then resizing = nil end
	end)
	own(Input.WindowFocusReleased, function() endPointer() end)
	own(gui:GetPropertyChangedSignal("AbsoluteSize"), function() applyLayout(false) end)

	applyLayout(true)
	root.Visible = window.Open
	if window.Open then
		body.Position = UDim2.fromOffset(0, 10)
		animate(root, {GroupTransparency = 0}, .22)
		animate(body, {Position = UDim2.fromOffset(0, 0)}, .26)
	else
		launcher.Visible = true
		launcher.GroupTransparency = 0
	end
	return window
end

-- Schema v1: feature identities, captions and data sources are supplied by the engine.
function Library.Mount(api)
    assert(type(api)=="table" and type(api.GetUIDescriptor)=="function"
        and type(api.GetUIData)=="function","Feature engine requires UI Schema v1")
    local descriptor=api:GetUIDescriptor()
    assert(type(descriptor)=="table" and descriptor.Version==1 and type(descriptor.Tabs)=="table","Unsupported UI schema")
    local kinds={Section=true,Label=true,Parameter=true,Button=true,Dropdown=true}
    local parameterKinds={boolean="Toggle",number="Slider",string="Input",selection="Dropdown"}
    for _,tab in ipairs(descriptor.Tabs) do
        assert(type(tab.Name)=="string" and type(tab.Items)=="table","Invalid UI tab")
        for _,item in ipairs(tab.Items) do
            assert(kinds[item.Kind],"Unsupported UI item: "..tostring(item.Kind))
            if item.Kind=="Parameter" then assert(type(item.Parameter)=="string","Missing parameter name") end
            if item.Kind=="Button" or item.Kind=="Dropdown" then assert(type(item.Command)=="string","Missing command name") end
            local schema=item.Parameter and api.Parameters[item.Parameter]
            if schema then assert(parameterKinds[schema.Type],"Unsupported parameter type: "..tostring(schema.Type)) end
        end
    end
    assert(type(api.IsRunning)~="function" or api:IsRunning(),"Feature session stopped before UI mount")
    local windowOptions=descriptor.Window or {StartClosed=true}
    local window=Library.CreateWindow(windowOptions)
    local alive,refreshing=true,false
    local changed,notices
    local entries={}
    local refresh
    window:OnDestroy(function()
        alive=false
        if changed then changed:Disconnect() end
        if notices then notices:Disconnect() end
        api:Destroy()
    end)
    api:OnStop(function()window:Destroy()end)
    local function invoke(command,...)
        if not alive or refreshing then return end
        local ok,err=pcall(api.Call,api,command,...)
        if not ok then
            window:Notify("Không thực hiện được",tostring(err),"error")
            if refresh then refresh() end
        end
    end
    local function readData()
        local data=api:GetUIData()
        assert(type(data)=="table","UI data must be a table")
        return data
    end
    local function options(item,schema,data)
        local values=item.OptionsSource and data[item.OptionsSource] or schema and schema.Options or item.Options
        local choices=type(values)=="table" and table.clone(values) or {}
        if schema and schema.Type=="selection" then
            for _,selected in ipairs(api:Get(item.Parameter)) do
                if not table.find(choices,selected) then choices[#choices+1]=selected end
            end
        end
        return choices
    end
    local function labelValue(item,data)
        local result
        if item.Source then result=data[item.Source] end
        if result==nil then result=item.Text or "" end
        return tostring(result)
    end
    local function value(item,schema,data)
        if schema then
            local result=api:Get(item.Parameter)
            if schema.Type=="selection" and not schema.Multiple then return result[1] end
            return result
        end
        if item.ValueSource then return data[item.ValueSource] end
        return item.Default
    end
    local ok,err=pcall(function()
        local data=readData()
        assert(alive,"Feature session stopped during UI mount")
        for _,definition in ipairs(descriptor.Tabs) do
            local tab=window:Tab(definition)
            for _,item in ipairs(definition.Items) do
                local schema=item.Parameter and api.Parameters[item.Parameter]
                local exists=item.Kind~="Parameter" or schema~=nil
                if item.Command and not api.Commands[item.Command] then exists=false end
                if not exists then continue end
                if item.Kind=="Section" then
                    tab:Section(item.Text or "")
                elseif item.Kind=="Label" then
                    local control=tab:Label(labelValue(item,data),item.Tone)
                    if item.Source then entries[#entries+1]={Control=control,Item=item} end
                else
                    local settings=table.clone(item)
                    local kind=schema and parameterKinds[schema.Type] or item.Kind
                    settings.Name=item.Name or item.Parameter or item.Command
                    settings.Default=value(item,schema,data)
                    if schema then
                        settings.Multiple=schema.Multiple==true
                        settings.Exclusive=schema.Exclusive
                        if schema.Type=="number" then
                            local range=schema.Range or {0,100}
                            settings.Min,settings.Max,settings.Step=range[1],range[2],schema.Increment or 1
                        end
                    end
                    if kind=="Dropdown" then
                        settings.Options=options(item,schema,data)
                        -- The menu must show what the feature really holds, never an assumed first entry.
                        settings.NoAutoSelect=true
                    end
                    settings.Callback=function(new)
                        if schema then invoke(item.Parameter,new)
                        elseif kind=="Button" then invoke(item.Command)
                        elseif item.ArgumentMap then
                            local latest=readData()
                            local map=latest[item.ArgumentMap] or {}
                            local argument=map[new]
                            if argument~=nil or (item.AllowEmpty and new==item.EmptyValue) then invoke(item.Command,argument) end
                        else invoke(item.Command,new) end
                    end
                    local control=tab[kind](tab,settings)
                    if schema or kind=="Dropdown" then
                        entries[#entries+1]={Control=control,Item=item,Schema=schema,Kind=kind,Multiple=settings.Multiple==true}
                    end
                end
            end
        end
        local previousError
        refresh=function()
            if not alive or refreshing then return end
            refreshing=true
            local good,why=pcall(function()
                local latest=readData()
                if not alive then return end
                for _,entry in ipairs(entries) do
                    local item,control=entry.Item,entry.Control
                    if item.Kind=="Label" then
                        control:Set(labelValue(item,latest))
                        if item.ToneSource and control.SetTone then control:SetTone(latest[item.ToneSource]) end
                    else
                        if entry.Kind=="Dropdown" then control:SetOptions(options(item,entry.Schema,latest),true) end
                        local current=value(item,entry.Schema,latest)
                        if entry.Kind=="Dropdown" and not entry.Multiple and current==nil then control:Clear()
                        elseif not (control.IsBusy and control:IsBusy()) then control:Set(current,true) end
                    end
                end
                local status=windowOptions.StatusSource
                if status then window:SetStatus(latest[status],windowOptions.StatusToneSource and latest[windowOptions.StatusToneSource] or nil) end
            end)
            refreshing=false
            if not good and previousError~=tostring(why) then window:Notify("Cập nhật giao diện",tostring(why),"warn") end
            previousError=not good and tostring(why) or nil
        end
        changed=api:Subscribe("Changed",refresh)
        notices=api:Subscribe("Notice",function(notice)
            if alive then window:Notify(notice.Title,notice.Content,notice.Tone or notice.Kind) end
        end)
        refresh()
        if window.Tabs[1] then window.Tabs[1]:Select() end
        api:FlushNotices()
    end)
    if not ok then window:Destroy();error(err,0) end
    return window
end

return Library
