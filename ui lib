    end
    function library:Destroy()
        if window then window:Destroy() else unloadNative(native) end
    end
    function library:CreateWindow()
        local nativeWindow = native:CreateWindow({Title="LUNA HUB",Footer="Valincia UI • K to hide",
            Size=UDim2.fromOffset(560,380),ToggleKeybind=Enum.KeyCode.K,IgnoreGuiInset=true})
