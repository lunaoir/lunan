	---------------------------------------------------------------- notices
	local noticeHost = make("Frame", {
		Name = "Notices", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 320, 1, -32), ZIndex = 40,
	}, gui)
	make("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right,
	}, noticeHost)
	local notices, noticeSequence = {}, 0
	local MAX_NOTICES = 3

	local function dismissNotice(item)
		if item.Gone then return end
		item.Gone = true
		cancelLater(item.Timer)
		local index = table.find(notices, item)
		if index then table.remove(notices, index) end
		animate(item.Group, {GroupTransparency = 1}, .12, function() item.Group:Destroy() end)
		later(.4, function() if item.Group.Parent then item.Group:Destroy() end end)
	end

	function window:Notify(title, message, tone)
		if self.Destroyed then return end
		title, message = clip(title or "", 80), clip(message or "", 240)
		local key = title .. "\0" .. message
		local color = tone and TONES[string.lower(tostring(tone))] or C.Accent
		local lifetime = (tone == "error") and 7 or 5
		for _, item in ipairs(notices) do
			if item.Key == key then
				cancelLater(item.Timer)
				item.Timer = later(lifetime, function() dismissNotice(item) end)
				return
			end
		end
		local view = viewport()
		local noticeWidth = math.max(200, math.min(340, view.X - 32))
		noticeHost.Size = UDim2.new(0, noticeWidth, 1, -32)
		local textWidth = noticeWidth - 30
		local titleHeight = measure(title, F.Bold, 15, textWidth)
		local bodyHeight = measure(message, F.Regular, 14, textWidth)
		local heightNeeded = 20 + titleHeight + (bodyHeight > 0 and bodyHeight + 3 or 0)
		noticeSequence += 1
		local group = make("CanvasGroup", {
			Name = "Notice", BackgroundColor3 = C.Group, GroupTransparency = 1, LayoutOrder = noticeSequence,
			Size = UDim2.fromOffset(noticeWidth, heightNeeded),
		}, noticeHost)
		corner(group, 8); stroke(group, C.LineStrong)
		make("Frame", {BackgroundColor3 = color, Size = UDim2.new(0, 3, 1, 0)}, group)
		textLabel(group, {Text = title, Font = F.Bold, TextSize = 15, TextColor3 = color, TextWrapped = true, Position = UDim2.fromOffset(16, 10), Size = UDim2.fromOffset(textWidth, titleHeight)})
		if bodyHeight > 0 then
			textLabel(group, {Text = message, TextSize = 14, TextColor3 = C.Text, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(16, 13 + titleHeight), Size = UDim2.fromOffset(textWidth, bodyHeight)})
		end
		local item = {Group = group, Key = key}
		local hit = make("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5}, group)
		hit.Activated:Connect(function() dismissNotice(item) end)
		table.insert(notices, item)
		while #notices > MAX_NOTICES do dismissNotice(notices[1]) end
		animate(group, {GroupTransparency = 0}, .16)
		item.Timer = later(lifetime, function() dismissNotice(item) end)
	end

	---------------------------------------------------------------- layout
	local function clampRoot(x, y)
		local view = viewport()
		local h = window.Minimized and HEADER or L.Height
		return math.clamp(x, 0, math.max(0, view.X - L.Width)), math.clamp(y, 0, math.max(0, view.Y - h))
	end

	placeLauncher = function()
		local view = viewport()
		local x, y
		if launcherCustom then
			x, y = launcher.Position.X.Offset, launcher.Position.Y.Offset
		else
			x, y = root.Position.X.Offset + 8, root.Position.Y.Offset + 8
		end
		launcher.Position = UDim2.fromOffset(math.clamp(x, 4, math.max(4, view.X - 48)), math.clamp(y, 4, math.max(4, view.Y - 48)))
	end

	applyLayout = function(initial)
		local view = viewport()
		local maxW, maxH = math.max(280, view.X - 16), math.max(220, view.Y - 16)
		local want = sizePreference or Vector2.new(780, 540)
		local previousInner, previousStack = L.RowInner, L.Stack
		L.Width = math.clamp(want.X, math.min(520, maxW), maxW)
		L.Height = math.clamp(want.Y, math.min(360, maxH), maxH)
		L.Narrow = L.Width < 640
		L.Nav = L.Narrow and 112 or 176
		L.PagePad = L.Narrow and 14 or 24
		L.RowInner = L.Width - L.Nav - 2 * L.PagePad - 2 * GROUP_PAD - 2 * ROW_PAD_X
		L.Stack = L.RowInner < 440
		if initial then
			root.Position = UDim2.fromOffset(math.floor((view.X - L.Width) / 2), math.floor((view.Y - L.Height) / 2))
		end
		animate(root, {Size = UDim2.fromOffset(L.Width, window.Minimized and HEADER or L.Height)}, 0)
		body.Size = UDim2.fromOffset(L.Width, L.Height)
		local x, y = clampRoot(root.Position.X.Offset, root.Position.Y.Offset)
		root.Position = UDim2.fromOffset(x, y)
		sidebar.Size = UDim2.new(0, L.Nav, 1, -(HEADER + FOOTER))
		content.Position = UDim2.fromOffset(L.Nav, HEADER)
		content.Size = UDim2.new(1, -L.Nav, 1, -(HEADER + FOOTER))
		subtitleHolder.Visible = (options.Subtitle or "") ~= "" and L.Width >= 600
		keyHint.Visible = L.Width >= 560
		statusText.Size = UDim2.new(1, keyHint.Visible and -150 or -50, 1, -1)
		for _, tab in ipairs(tabs) do
			tab.NavIcon.Frame.Position = UDim2.fromOffset(L.Narrow and 9 or 12, 12)
			tab.NavLabel.Position = UDim2.fromOffset(L.Narrow and 31 or 38, 0)
			tab.NavLabel.Size = UDim2.new(1, L.Narrow and -34 or -44, 1, 0)
			tab.NavLabel.TextSize = L.Narrow and 14 or 15
			if previousInner ~= L.RowInner or previousStack ~= L.Stack or tab.Width ~= L.Width then tab.Dirty = true end
		end
		if currentTab and currentTab.Dirty then relayoutTab(currentTab) end
		placeLauncher()
		closePopup()
	end

	relayoutTab = function(tab)
		tab.Padding.PaddingLeft, tab.Padding.PaddingRight = UDim.new(0, L.PagePad), UDim.new(0, L.PagePad)
		tab.Padding.PaddingTop, tab.Padding.PaddingBottom = UDim.new(0, 20), UDim.new(0, 24)
		tab.Width = L.Width
		for _, fn in ipairs(tab.Relayouts) do fn() end
		tab.Dirty = false
	end

	---------------------------------------------------------------- window state
	closePopup = function()
		local old = popup
		if not old then return end
		popup = nil
		for _, connection in ipairs(old.Connections) do connection:Disconnect() end
		old.Control.SetOpenVisual(false)
		old.Scrim:Destroy()
		old.Group:Destroy()
	end

	endScrub = function()
		local state = scrub
		scrub = nil
		if state and state.Finish then state.Finish() end
	end

	endPointer = function()
		drag, resizing = nil, nil
		endScrub()
	end

	local function releaseFocus()
		local focused = Input:GetFocusedTextBox()
		if focused and focused:IsDescendantOf(root) then focused:ReleaseFocus() end
	end

	function window:SetOpen(value)
		value = value == true
		if self.Destroyed or self.Open == value then return end
		self.Open = value
		closePopup(); endPointer(); hideTooltip(); releaseFocus()
		if value then
			launcher.Visible = false
			root.Visible = true
			if root.GroupTransparency >= .99 then body.Position = UDim2.fromOffset(0, 8) end
			animate(root, {GroupTransparency = 0}, .16)
			animate(body, {Position = UDim2.fromOffset(0, 0)}, .2)
		else
			placeLauncher()
			launcher.Visible = true
			launcher.GroupTransparency = 1
			animate(launcher, {GroupTransparency = 0}, .16)
			animate(body, {Position = UDim2.fromOffset(0, 6)}, .12)
			animate(root, {GroupTransparency = 1}, .12, function()
				if not window.Open then root.Visible = false end
			end)
		end
	end

	function window:Toggle()
		self:SetOpen(not self.Open)
	end

	function window:SetMinimized(value)
		value = value == true
		if self.Destroyed or self.Minimized == value then return end
		self.Minimized = value
		closePopup(); endPointer(); hideTooltip(); releaseFocus()
		minimizeGlyph.Frame.Visible, restoreGlyph.Frame.Visible = not value, value
		if value then
			animate(root, {Size = UDim2.fromOffset(L.Width, HEADER)}, .16)
			grip.Visible = false
		else
			animate(root, {Size = UDim2.fromOffset(L.Width, L.Height)}, .2)
			grip.Visible = true
		end
		local x, y = clampRoot(root.Position.X.Offset, root.Position.Y.Offset)
		root.Position = UDim2.fromOffset(x, y)
	end

	function window:OnDestroy(fn)
		assert(type(fn) == "function", "Destroy handler must be a function")
		if self.Destroyed then callback(fn) else table.insert(destroyHandlers, fn) end
	end

	function window:Destroy()
		if self.Destroyed then return end
		self.Destroyed = true
		for _, fn in ipairs(destroyHandlers) do callback(fn) end
		table.clear(destroyHandlers)
		for _, connection in ipairs(connections) do connection:Disconnect() end
		for thread in pairs(pending) do task.cancel(thread) end
		local running = {}
		for _, active in pairs(tweens) do
			for tween in pairs(active) do table.insert(running, tween) end
		end
		for _, tween in ipairs(running) do tween:Cancel() end
		table.clear(connections); table.clear(pending); table.clear(tweens); table.clear(notices)
		releaseFocus()
		drag, scrub, resizing, popup = nil, nil, nil, nil
		table.clear(self.Tabs)
		gui:Destroy()
	end
	gui.Destroying:Connect(function() window:Destroy() end)

	minimizeButton.Activated:Connect(function() window:SetMinimized(not window.Minimized) end)
	closeButton.Activated:Connect(function() window:SetOpen(false) end)
	launcherHit.Activated:Connect(function()
		if launcherMoved then return end
		window:SetOpen(true)
	end)

	---------------------------------------------------------------- tabs
	local function paintNav(tab, selected)
		animate(tab.NavButton, {BackgroundTransparency = selected and 0 or 1}, .12)
		animate(tab.NavBar, {Size = UDim2.fromOffset(3, selected and 18 or 0)}, .14)
		tab.NavIcon:SetColor(selected and C.Accent or C.Muted)
		tab.NavLabel.TextColor3 = selected and C.Text or C.Muted
	end

	local function revealNavigation(tab)
		local top = (tab.Index - 1) * 42
		local available = math.max(1, navigation.AbsoluteSize.Y - 20)
		local position = navigation.CanvasPosition.Y
		if top < position then navigation.CanvasPosition = Vector2.new(0, top)
		elseif top + 40 > position + available then navigation.CanvasPosition = Vector2.new(0, math.max(0, top + 40 - available)) end
	end

	setTab = function(tab)
		if window.Destroyed or currentTab == tab then return end
		closePopup(); endScrub(); hideTooltip()
		local previous = currentTab
		currentTab = tab
		if previous then
			animate(previous.Page, {GroupTransparency = 0}, 0)
			previous.Page.Visible = false
		end
		for _, other in ipairs(tabs) do paintNav(other, other == tab) end
		if tab.Dirty then relayoutTab(tab) end
		animate(tab.Page, {GroupTransparency = 1}, 0)
		tab.Page.Visible = true
		animate(tab.Page, {GroupTransparency = 0}, .14)
		revealNavigation(tab)
	end

	local function ensureSection(tab)
		local section = tab.Current
		if not section then
			section = {Count = 0, Collapsed = false, Rows = 0, RowOrder = 0, Group = false, Spacer = false}
			tab.Current = section
		end
		if not section.Group then
			tab.Order += 1
			local frame = make("Frame", {
				Name = "Group", BackgroundColor3 = C.Group, AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, 0, 0, 0), LayoutOrder = tab.Order, Visible = not section.Collapsed,
			}, tab.Scroll)
			corner(frame, 8); stroke(frame, C.Line)
			make("UIPadding", {PaddingTop = UDim.new(0, GROUP_PAD), PaddingBottom = UDim.new(0, GROUP_PAD), PaddingLeft = UDim.new(0, GROUP_PAD), PaddingRight = UDim.new(0, GROUP_PAD)}, frame)
			make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, frame)
			tab.Order += 1
			section.Group = frame
			section.Spacer = make("Frame", {Name = "Spacer", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, section.Collapsed and 4 or 16), LayoutOrder = tab.Order}, tab.Scroll)
		end
		return section
	end

	-- One list row: name + optional hint on the left, an optional control slot on the right
	-- (or underneath on narrow layouts). Heights are measured, never guessed, so long text wraps cleanly.
	local function addRow(tab, spec)
		local section = ensureSection(tab)
		section.RowOrder += 1
		if section.Rows > 0 then
			local divider = make("Frame", {Name = "Divider", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 1), LayoutOrder = section.RowOrder}, section.Group)
			make("Frame", {BackgroundColor3 = C.Line, Position = UDim2.fromOffset(ROW_PAD_X, 0), Size = UDim2.new(1, -2 * ROW_PAD_X, 1, 0)}, divider)
			section.RowOrder += 1
		end
		local properties = {Name = "Row", BackgroundColor3 = C.White, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = section.RowOrder}
		if spec.Interactive then properties.Text = ""; properties.AutoButtonColor = false end
		local frame = make(spec.Interactive and "TextButton" or "Frame", properties, section.Group)
		corner(frame, 6)
		local nameLabel = textLabel(frame, {Text = spec.Name or "", Font = spec.NameFont or F.Semi, TextSize = spec.NameSize or 16, TextWrapped = true, TextColor3 = spec.NameColor or C.Text, TextXAlignment = spec.NameAlign or Enum.TextXAlignment.Left})
		local hintLabel = nil
		if spec.Hint and spec.Hint ~= "" then
			hintLabel = textLabel(frame, {Text = tostring(spec.Hint), TextSize = 14, TextColor3 = C.Muted, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top})
		end
		local slot = spec.ControlW and make("Frame", {Name = "Slot", BackgroundTransparency = 1}, frame) or nil
		local row = {Frame = frame, Name = nameLabel, Hint = hintLabel, Slot = slot}
		function row.Relayout()
			local inner = L.RowInner
			local lead = spec.Lead or 0
			local controlW, controlH = spec.ControlW or 0, spec.ControlH or 0
			local stacked = slot ~= nil and spec.StackOnNarrow == true and L.Stack
			local textW = (stacked or controlW == 0) and (inner - lead) or (inner - lead - controlW - 16)
			local nameH = measure(nameLabel.Text, nameLabel.Font, nameLabel.TextSize, textW)
			local hintH = hintLabel and measure(hintLabel.Text, hintLabel.Font, hintLabel.TextSize, textW) or 0
			local textsH = nameH + (hintH > 0 and hintH + 2 or 0)
			local height, textTop
			if stacked then
				height = ROW_PAD_Y + textsH + 8 + controlH + ROW_PAD_Y
				textTop = ROW_PAD_Y
				slot.AnchorPoint = Vector2.new(0, 0)
				slot.Position = UDim2.fromOffset(ROW_PAD_X, ROW_PAD_Y + textsH + 8)
				slot.Size = UDim2.fromOffset(inner, controlH)
			else
				height = math.max(spec.MinH or 44, textsH + 2 * ROW_PAD_Y, controlH + 2 * ROW_PAD_Y)
				textTop = math.floor((height - textsH) / 2)
				if slot then
					slot.AnchorPoint = Vector2.new(1, .5)
					slot.Position = UDim2.new(1, -ROW_PAD_X, .5, 0)
					slot.Size = UDim2.fromOffset(controlW, controlH)
				end
			end
			frame.Size = UDim2.new(1, 0, 0, height)
			nameLabel.Position = UDim2.fromOffset(ROW_PAD_X + lead, textTop)
			nameLabel.Size = UDim2.fromOffset(textW, nameH)
			if hintLabel then
				hintLabel.Position = UDim2.fromOffset(ROW_PAD_X + lead, textTop + nameH + 2)
				hintLabel.Size = UDim2.fromOffset(textW, hintH)
			end
			row.TextTop = textTop
			if spec.OnLayout then spec.OnLayout(textTop, nameH) end
		end
		table.insert(tab.Relayouts, row.Relayout)
		if spec.Interactive and not spec.NoTint then bindTint(frame, 1, .94, .88) end
		section.Rows += 1
		section.Count += 1
		if section.CountLabel then section.CountLabel.Text = tostring(section.Count) end
		row.Relayout()
		return row
	end

	local function newTab(self, settings)
		assert(not self.Destroyed, "Luna UI window was destroyed")
		if type(settings) == "string" then settings = {Name = settings} end
		settings = settings or {}
		local index = #self.Tabs + 1
		local tab = {Index = index, Controls = {}, Sections = 0, Order = 0, Relayouts = {}, Dirty = true, Width = 0}

		local button = make("TextButton", {
			Name = "Tab", Text = "", AutoButtonColor = false, BackgroundColor3 = C.AccentSoft, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 40), LayoutOrder = index,
		}, navigation)
		corner(button, 7)
		local bar = make("Frame", {BackgroundColor3 = C.Accent, AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(3, 0)}, button)
		corner(bar, 3)
		local navIcon = drawIcon(button, settings.Icon or "stand", 16, C.Muted)
		local navLabel = textLabel(button, {Text = settings.ShortName or settings.Name or "Tab", Font = F.Semi, TextColor3 = C.Muted, TextWrapped = true})
		button.MouseEnter:Connect(function()
			if touchOnly or currentTab == tab then return end
			animate(button, {BackgroundTransparency = .6}, .1)
		end)
		button.MouseLeave:Connect(function()
			if currentTab ~= tab then animate(button, {BackgroundTransparency = 1}, .12) end
		end)
		button.Activated:Connect(function() setTab(tab) end)

		local page = make("CanvasGroup", {Name = "Page", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false}, content)
		local scroll = make("ScrollingFrame", {
			Name = "Scroll", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, ScrollBarImageColor3 = C.Faint,
			ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.Never,
		}, page)
		local padding = make("UIPadding", {}, scroll)
		make("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, scroll)

		local headingRow = make("Frame", {Name = "Heading", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 0}, scroll)
		local titleLabel = textLabel(headingRow, {Text = settings.Name or "Tab", Font = F.Bold, TextSize = 26, TextWrapped = true})
		local descriptionLabel = textLabel(headingRow, {Text = settings.Description or "", TextSize = 15, TextColor3 = C.Muted, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top})
		table.insert(tab.Relayouts, function()
			local available = L.Width - L.Nav - 2 * L.PagePad
			local titleH = measure(titleLabel.Text, F.Bold, 26, available)
			local descH = measure(descriptionLabel.Text, F.Regular, 15, available)
			titleLabel.Size = UDim2.fromOffset(available, titleH)
			descriptionLabel.Position = UDim2.fromOffset(0, titleH + 2)
			descriptionLabel.Size = UDim2.fromOffset(available, descH)
			headingRow.Size = UDim2.new(1, 0, 0, titleH + (descH > 0 and descH + 4 or 0) + 14)
		end)

		tab.Page, tab.Scroll, tab.Padding = page, scroll, padding
		tab.NavButton, tab.NavBar, tab.NavIcon, tab.NavLabel = button, bar, navIcon, navLabel
		table.insert(self.Tabs, tab)
		applyLayout(false)

		local function register(control)
			table.insert(tab.Controls, control)
			return control
		end
		function tab:Select() setTab(self) end

		function tab:Section(label)
			self.Order += 1
			self.Sections += 1
			local section = {Count = 0, Collapsed = false, Rows = 0, RowOrder = 0, Group = false, Spacer = false, CountLabel = false}
			self.Current = section
			local headerButton = make("TextButton", {
				Name = "Section", Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 34), LayoutOrder = self.Order,
			}, scroll)
			local chevron = drawIcon(headerButton, "chevron", 12, C.Muted)
			chevron.Frame.Position = UDim2.fromOffset(2, 11)
			local title = textLabel(headerButton, {Text = tostring(label or ""), Font = F.Semi, TextSize = 14, TextColor3 = C.Muted, Position = UDim2.fromOffset(22, 0), Size = UDim2.new(1, -60, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd})
			section.CountLabel = textLabel(headerButton, {Text = "", Font = F.Mono, TextSize = 12, TextColor3 = C.Faint, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -38, 0, 0), Size = UDim2.fromOffset(34, 34)})
			headerButton.MouseEnter:Connect(function() title.TextColor3 = C.Text; chevron:SetColor(C.Text) end)
			headerButton.MouseLeave:Connect(function() title.TextColor3 = C.Muted; chevron:SetColor(C.Muted) end)
			headerButton.Activated:Connect(function()
				section.Collapsed = not section.Collapsed
				closePopup()
				animate(chevron.Frame, {Rotation = section.Collapsed and -90 or 0}, .12)
				if section.Group then
					section.Group.Visible = not section.Collapsed
					section.Spacer.Size = UDim2.new(1, 0, 0, section.Collapsed and 4 or 16)
				end
			end)
			return self
		end

		function tab:Label(value, tone)
			local toneColor = tone and TONES[string.lower(tostring(tone))] or nil
			local dot
			local row = addRow(self, {
				Name = tostring(value), NameFont = F.Regular, NameSize = 15, MinH = 38, Lead = toneColor and 16 or 0,
				OnLayout = function(textTop) if dot then dot.Position = UDim2.fromOffset(ROW_PAD_X + 1, textTop + 7) end end,
			})
			if toneColor then
				dot = make("Frame", {BackgroundColor3 = toneColor, Size = UDim2.fromOffset(8, 8)}, row.Frame)
				corner(dot, 8)
				row.Relayout()
			end
			local control = {Element = row.Frame}
			function control:Get() return row.Name.Text end
			function control:Set(new)
				if window.Destroyed then return end
				local textValue = tostring(new)
				if textValue ~= row.Name.Text then row.Name.Text = textValue; row.Relayout() end
			end
			function control:SetTone(new)
				local color = new and TONES[string.lower(tostring(new))]
				if dot and color then dot.BackgroundColor3 = color end
			end
			return register(control)
		end

		function tab:Toggle(settings)
			local row = addRow(self, {Name = settings.Name, Hint = settings.Hint, ControlW = 84, ControlH = 24, MinH = 50, Interactive = true})
			local stateLabel = textLabel(row.Slot, {Font = F.Semi, TextSize = 14, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(1, -52, 1, 0)})
			local track = make("Frame", {BackgroundColor3 = C.Rail, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0), Size = UDim2.fromOffset(44, 24)}, row.Slot)
			corner(track, 24)
			local thumb = make("Frame", {BackgroundColor3 = C.Muted, AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 3, .5, 0), Size = UDim2.fromOffset(18, 18)}, track)
			corner(thumb, 18)
			local value = settings.Default == true
			local control = {Element = row.Frame}
			local function paint(animated)
				stateLabel.Text, stateLabel.TextColor3 = value and "Bật" or "Tắt", value and C.Accent or C.Muted
				local trackProps = {BackgroundColor3 = value and C.Accent or C.Rail}
				local thumbProps = {Position = UDim2.new(0, value and 23 or 3, .5, 0), BackgroundColor3 = value and C.OnAccent or C.Muted}
				animate(track, trackProps, animated and .14 or 0)
				animate(thumb, thumbProps, animated and .16 or 0)
			end
			function control:Get() return value end
			function control:Set(new, silent)
				if window.Destroyed or type(new) ~= "boolean" or new == value then return false end
				value = new; paint(true)
				if not silent then callback(settings.Callback, value) end
				return true
			end
			row.Frame.Activated:Connect(function() control:Set(not value) end)
			paint(false)
			return register(control)
		end

		function tab:Slider(settings)
			local minimum, maximum, step = settings.Min or 0, settings.Max or 100, settings.Step or 1
			assert(finite(minimum) and finite(maximum) and maximum > minimum and finite(step) and step > 0, "Invalid slider range")
			local unit = settings.Unit or ""
			local row = addRow(self, {Name = settings.Name, Hint = settings.Hint, ControlW = 268, ControlH = 32, MinH = 54, StackOnNarrow = true})
			local boxWidth = 68
			local hit = make("TextButton", {Name = "Track", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, -(boxWidth + 12), 1, 0)}, row.Slot)
			local rail = make("Frame", {BackgroundColor3 = C.Rail, AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 8, .5, 0), Size = UDim2.new(1, -16, 0, 4)}, hit)
			corner(rail, 4)
			local fill = make("Frame", {BackgroundColor3 = C.Accent, Size = UDim2.fromScale(0, 1)}, rail)
			corner(fill, 4)
			local thumb = make("Frame", {BackgroundColor3 = C.Accent, AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(14, 14), Position = UDim2.fromScale(0, .5)}, rail)
			corner(thumb, 14)
			make("UIStroke", {Color = C.Group, Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, thumb)
			local box = make("TextBox", {
				BackgroundColor3 = C.Input, TextColor3 = C.Text, Font = F.Mono, TextSize = 14, ClearTextOnFocus = false,
				TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0),
				Size = UDim2.fromOffset(boxWidth, 30), Text = "",
			}, row.Slot)
			corner(box, 6)
			local boxStroke = stroke(box, C.Line)
			make("UIPadding", {PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, unit ~= "" and 26 or 8)}, box)
			if unit ~= "" then
				textLabel(box, {Text = unit, TextSize = 13, TextColor3 = C.Muted, Font = F.Regular, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.new(1, 4, 0, 0), Size = UDim2.new(0, 22, 1, 0)})
			end
			box.Focused:Connect(function() animate(boxStroke, {Color = C.Accent}, .1) end)
			local value = minimum
			local control = {Element = row.Frame}
			local function snap(new)
				return math.clamp(minimum + math.floor((new - minimum) / step + .5) * step, minimum, maximum)
			end
			local function paint()
				local fraction = (value - minimum) / (maximum - minimum)
				fill.Size, thumb.Position = UDim2.fromScale(fraction, 1), UDim2.fromScale(fraction, .5)
				if not box:IsFocused() then box.Text = string.format("%.6g", value) end
			end
			function control:Get() return value end
			function control:IsBusy() return box:IsFocused() end
			function control:Set(new, silent)
				if window.Destroyed or not finite(new) then return false end
				new = snap(new)
				if math.abs(new - value) <= step * 1e-7 then paint(); return false end
				value = new; paint()
				if not silent then callback(settings.Callback, value) end
				return true
			end
			local function point(x)
				local railWidth = rail.AbsoluteSize.X
				if railWidth > 0 then control:Set(minimum + math.clamp((x - rail.AbsolutePosition.X) / railWidth, 0, 1) * (maximum - minimum)) end
			end
			hit.InputBegan:Connect(function(input)
				if window.Destroyed then return end
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					endScrub(); closePopup()
					scroll.ScrollingEnabled = false
					animate(thumb, {Size = UDim2.fromOffset(18, 18)}, .1)
					scrub = {Input = input, Update = point, Finish = function()
						if not window.Destroyed then scroll.ScrollingEnabled = true end
						animate(thumb, {Size = UDim2.fromOffset(14, 14)}, .1)
					end}
					point(input.Position.X)
				end
			end)
			box.FocusLost:Connect(function()
				animate(boxStroke, {Color = C.Line}, .12)
				local new = tonumber(box.Text)
				if finite(new) then control:Set(new) end
				paint()
			end)
			value = finite(settings.Default) and snap(settings.Default) or minimum
			paint()
			return register(control)
		end

		function tab:Dropdown(settings)
			local row = addRow(self, {Name = settings.Name, Hint = settings.Hint, ControlW = 236, ControlH = 34, MinH = 54, StackOnNarrow = true})
			local buttonNode = make("TextButton", {Name = "Select", Text = "", AutoButtonColor = false, BackgroundColor3 = C.Input, Size = UDim2.fromScale(1, 1)}, row.Slot)
			corner(buttonNode, 6)
			local buttonStroke = stroke(buttonNode, C.Line)
			local selected = textLabel(buttonNode, {TextSize = 15, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -36, 1, 0)})
			local badge = make("Frame", {BackgroundColor3 = C.AccentSoft, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -30, .5, 0), Size = UDim2.fromOffset(24, 20), Visible = false}, buttonNode)
			corner(badge, 10)
			local badgeText = textLabel(badge, {Font = F.Mono, TextSize = 12, TextColor3 = C.Accent, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1)})
			local chevron = drawIcon(buttonNode, "chevron", 14, C.Muted)
			chevron.Frame.AnchorPoint = Vector2.new(1, .5)
			chevron.Frame.Position = UDim2.new(1, -10, .5, 0)
			local multiple = settings.Multiple == true
			local autoSelect = settings.NoAutoSelect ~= true
			local choices, value = {}, multiple and {} or nil
			local control = {Element = row.Frame}
			local function equal(a, b)
				if type(a) ~= "table" or type(b) ~= "table" then return a == b end
				if #a ~= #b then return false end
				for index, entry in ipairs(a) do if b[index] ~= entry then return false end end
				return true
			end
			local function paint()
				local empty = #choices == 0
				local display, color = nil, C.Text
				if empty then display, color = "Không có dữ liệu", C.Faint
				elseif multiple then
					if #value == 0 then display, color = settings.Placeholder or "Chưa chọn", C.Muted
					else display = table.concat(value, ", ") end
				elseif value == nil then display, color = settings.Placeholder or "Chưa chọn", C.Muted
				else display = value end
				selected.Text, selected.TextColor3 = display, color
				local showBadge = multiple and #value >= 2
				badge.Visible = showBadge
				badgeText.Text = showBadge and tostring(#value) or ""
				selected.Size = UDim2.new(1, showBadge and -62 or -36, 1, 0)
				chevron:SetColor(empty and C.Faint or C.Muted)
				if popup and popup.Control == control and popup.Paint then popup.Paint() end
			end
			function control.SetOpenVisual(open)
				animate(chevron.Frame, {Rotation = open and 180 or 0}, .12)
				animate(buttonStroke, {Color = open and C.Accent or C.Line}, .12)
			end
			function control:Get() return multiple and table.clone(value) or value end
			function control:Set(new, silent)
				if window.Destroyed then return false end
				if multiple then
					if type(new) ~= "table" then return false end
					local normalized = {}
					for _, entry in ipairs(new) do
						if not table.find(choices, entry) then return false end
						if not table.find(normalized, entry) then table.insert(normalized, entry) end
					end
					for _, exclusive in ipairs(settings.Exclusive or {}) do
						local index = table.find(normalized, exclusive)
						if index and #normalized > 1 then
							if table.find(value, exclusive) then table.remove(normalized, index) else normalized = {exclusive} end
						end
					end
					new = normalized
				elseif not table.find(choices, new) then return false end
				if equal(value, new) then return false end
				value = new; paint()
				if not silent then callback(settings.Callback, self:Get()) end
				return true
			end
			-- Silent: shows the "nothing selected" state without calling the feature.
			function control:Clear()
				if window.Destroyed or multiple or value == nil then return false end
				value = nil; paint()
				return true
			end
			function control:IsBusy() return false end
			function control:SetOptions(new, silent)
				if window.Destroyed then return end
				local normalized, seen = {}, {}
				for _, entry in ipairs(new) do
					assert(type(entry) == "string", "Dropdown choices must be strings")
					if not seen[entry] then seen[entry] = true; table.insert(normalized, entry) end
				end
				if equal(choices, normalized) then return end
				if popup and popup.Control == self then closePopup() end
				choices = normalized
				local previous = value
				if multiple then
					value = {}
					for _, entry in ipairs(previous) do if table.find(choices, entry) then table.insert(value, entry) end end
				elseif previous ~= nil and not table.find(choices, previous) then
					value = autoSelect and choices[1] or nil
				elseif previous == nil and autoSelect then
					value = choices[1]
				end
				paint()
				if not silent and not equal(previous, value) then callback(settings.Callback, self:Get()) end
			end
			local function isSelected(entry)
				if multiple then return table.find(value, entry) ~= nil end
				return value == entry
			end
			local function choose(entry)
				if multiple then
					local nextValue = table.clone(value)
					local index = table.find(nextValue, entry)
					if index then table.remove(nextValue, index) else table.insert(nextValue, entry) end
					control:Set(nextValue)
				else control:Set(entry); closePopup() end
			end
			control:SetOptions(settings.Options or {}, true)
			if settings.Default ~= nil then control:Set(settings.Default, true) end
			paint()

			local function openPopup()
				if window.Destroyed then return end
				if popup and popup.Control == control then closePopup(); return end
				closePopup()
				if #choices == 0 then return end
				local view = viewport()
				local menuWidth = math.clamp(math.max(buttonNode.AbsoluteSize.X, 240), 180, math.max(180, math.min(360, view.X - 16)))
				local searchable = #choices > 8
				local top = searchable and 46 or 0
				-- The scrim sits under the popup and over the window: any press outside closes it, so no pointer maths is needed.
				local scrim = make("TextButton", {Name = "PopupScrim", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 15}, gui)
				local group = make("CanvasGroup", {Name = "Popup", BackgroundColor3 = C.Group, GroupTransparency = 1, ZIndex = 20, Size = UDim2.fromOffset(menuWidth, 120)}, gui)
				corner(group, 8); stroke(group, C.LineStrong)
				scrim.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then closePopup() end
				end)
				local search = nil
				if searchable then
					search = make("TextBox", {
						Name = "Search", Text = "", PlaceholderText = "Tìm…", PlaceholderColor3 = C.Faint, ClearTextOnFocus = false,
						BackgroundColor3 = C.Input, TextColor3 = C.Text, Font = F.Regular, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left,
						Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 30),
					}, group)
					corner(search, 6)
					local searchStroke = stroke(search, C.Line)
					make("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)}, search)
					search.Focused:Connect(function() animate(searchStroke, {Color = C.Accent}, .1) end)
					search.FocusLost:Connect(function() animate(searchStroke, {Color = C.Line}, .12) end)
				end
				local list = make("ScrollingFrame", {
					Name = "List", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -top),
					CanvasSize = UDim2.new(), ScrollBarThickness = 4, ScrollBarImageColor3 = C.Faint, ScrollingDirection = Enum.ScrollingDirection.Y,
					ElasticBehavior = Enum.ElasticBehavior.Never,
				}, group)
				local emptyLabel = textLabel(list, {Text = "Không có kết quả", TextColor3 = C.Faint, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 30), Visible = false})
				local rows, contentHeight = {}, 0
				local textWidth = menuWidth - 50
				for _, entry in ipairs(choices) do
					local itemHeight = math.max(34, measure(entry, F.Regular, 15, textWidth) + 14)
					local option = make("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.White, BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, itemHeight)}, list)
					corner(option, 6)
					local labelNode = textLabel(option, {Text = entry, TextWrapped = true, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -38, 1, 0)})
					local check = drawIcon(option, "check", 14, C.Accent)
					check.Frame.AnchorPoint = Vector2.new(1, .5)
					check.Frame.Position = UDim2.new(1, -10, .5, 0)
					local item = {Entry = entry, Button = option, Label = labelNode, Check = check, Height = itemHeight, Match = true, Lower = string.lower(entry), Selected = false}
					rows[#rows + 1] = item
					option.MouseEnter:Connect(function()
