function engine:GetSnapshot()
    local stand, attribute = readStandData()
    local targets, storage = {}, {}
    for index, slot in ipairs(farmSlots) do targets[index] = {Index=index, Description=getSlotDisplayText(slot)} end
    for index, slot in ipairs(storageMap) do
        local record = readStandRecord(slot.data)
        storage[index] = {Label=slot.label, Stand=record and getDisplayName(record.stand) or nil,
            Attribute=record and record.att or nil, Protected=record and checkSlotMatch(record.stand, record.att) or false}
    end
    return {Stand=getDisplayName(stand or "None"), Attribute=attribute or "None", Farming=getgenv().farmstands,
        Targets=targets, StandChoices=featureState.getFilteredStandList(searchQuery), Attributes=table.clone(allAttributes),
        SelectedStand=selectedStandForSlot, SelectedAttributes=table.clone(selectedAttsForSlot), Catalog=catalogSource,
        Storage=storage, StorageMessage=storageMessage, SelectedTargetIndex=selectedRemoveIndex, OrbStatus=orbStatusText(),
        HalloweenStatus=featureState.halloweenStatus}
end
engine:OnStop(function()
    if getgenv().SURFarmSession == hubSession then stopStandFarm();getgenv().SURFarmSession=nil end
    if extrasConnection then extrasConnection:Disconnect(); extrasConnection = nil end
    if respawnConnection then respawnConnection:Disconnect(); respawnConnection = nil end
end)
respawnConnection=localplr.CharacterAdded:Connect(function()
    task.wait(2.5)
    if not engine:IsRunning() then return end
    if getgenv().farmstands and not isFarmingActive then
        notif("Auto Resume","Nhân vật respawn → Tiếp tục Stand Farm...")
        task.spawn(doStandFarm)
    end
end)
local elapsed=0
extrasConnection=game:GetService("RunService").Heartbeat:Connect(function(dt)
    if not engine:IsRunning() then engine:Destroy();return end
    elapsed+=dt
    if elapsed>=1 then
        elapsed=0
        local ok,err=pcall(updateFarmState)
        if not ok then warn("[Luna Features] State update: "..tostring(err)) end
    end
end)

    end)
    if not ok then engine:Destroy();error(err,0) end
    return engine
end

