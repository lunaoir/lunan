local function attachCornerBrackets(parent, armLen, thickness, color, transparency, inset)
    if parent:FindFirstChild("HacBach_Corners") then return end
    armLen = armLen or 8
    thickness = thickness or 1
    color = color or Color3.fromRGB(235, 235, 242)
    transparency = transparency or 0.35
    inset = inset or 2

    local holder = Instance.new("Frame")
    holder.Name = "HacBach_Corners"
    holder.Size = UDim2.new(1, 0, 1, 0)
    holder.BackgroundTransparency = 1
    holder.ZIndex = math.max(parent.ZIndex + 1, 2)
    holder.Active = false
    holder.Parent = parent

    local corners = {
        {ax = 0, ay = 0, px = inset, py = inset},
        {ax = 1, ay = 0, px = -inset, py = inset},
        {ax = 0, ay = 1, px = inset, py = -inset},
        {ax = 1, ay = 1, px = -inset, py = -inset},
    }

    for _, cfg in ipairs(corners) do
        local hBar = Instance.new("Frame")
        hBar.AnchorPoint = Vector2.new(cfg.ax, cfg.ay)
        hBar.Position = UDim2.new(cfg.ax, cfg.px, cfg.ay, cfg.py)
        hBar.Size = UDim2.fromOffset(armLen, thickness)
        hBar.BackgroundColor3 = color
        hBar.BackgroundTransparency = transparency
        hBar.BorderSizePixel = 0
        hBar.ZIndex = holder.ZIndex
        hBar.Parent = holder

        local vBar = Instance.new("Frame")
        vBar.AnchorPoint = Vector2.new(cfg.ax, cfg.ay)
        vBar.Position = UDim2.new(cfg.ax, cfg.px, cfg.ay, cfg.py)
        vBar.Size = UDim2.fromOffset(thickness, armLen)
        vBar.BackgroundColor3 = color
        vBar.BackgroundTransparency = transparency
        vBar.BorderSizePixel = 0
        vBar.ZIndex = holder.ZIndex
        vBar.Parent = holder
    end
    return holder
end

-- 2. Pháp Trận Thái Cực Âm Dương (Procedural Rotating Yin-Yang Emblem)
local function spawnInkRipple(button, clickX, clickY, isDarkRipple)
    if not button or not button:IsA("GuiObject") then return end
    local absPos = button.AbsolutePosition
    local absSize = button.AbsoluteSize
    local relX = clickX and math.clamp(clickX - absPos.X, 0, absSize.X) or (absSize.X * 0.5)
    local relY = clickY and math.clamp(clickY - absPos.Y, 0, absSize.Y) or (absSize.Y * 0.5)

    local holder = Instance.new("Frame")
    holder.Name = "HacBach_InkRipple"
    holder.Size = UDim2.new(1, 0, 1, 0)
    holder.BackgroundTransparency = 1
    holder.ClipsDescendants = true
    holder.ZIndex = math.max(button.ZIndex + 1, 2)
    holder.Active = false
    holder.Parent = button

    local ripple = Instance.new("Frame")
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.Position = UDim2.fromOffset(relX, relY)
    ripple.Size = UDim2.fromOffset(0, 0)
    ripple.BackgroundColor3 = isDarkRipple and Color3.fromRGB(12, 12, 16) or Color3.fromRGB(246, 246, 250)
    ripple.BackgroundTransparency = 0.52
    ripple.BorderSizePixel = 0
    ripple.ZIndex = holder.ZIndex
    ripple.Parent = holder
    Instance.new("UICorner", ripple).CornerRadius = UDim.new(1, 0)

    local ring = Instance.new("UIStroke", ripple)
    ring.Color = isDarkRipple and Color3.fromRGB(35, 35, 42) or Color3.fromRGB(255, 255, 255)
    ring.Thickness = 1.4
    ring.Transparency = 0.25

    local maxRadius = math.max(absSize.X, absSize.Y) * 2.1
    tween(ripple, {
        Size = UDim2.fromOffset(maxRadius, maxRadius),
        BackgroundTransparency = 1
    }, 0.48, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    tween(ring, {Transparency = 1}, 0.48, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

    task.delay(0.50, function()
        if holder and holder.Parent then
            holder:Destroy()
        end
    end)
end

local function brightSurface(inst)
    while inst and not inst:IsA("ScreenGui") do
        if inst:IsA("GuiObject") and inst.BackgroundTransparency < 0.5 then
            local c = inst.BackgroundColor3
            return c.R > 0.72 and c.G > 0.72 and c.B > 0.72
        end
        inst = inst.Parent
    end
    return false
end

local function createRipple(button, clickPosX, clickPosY)
    spawnInkRipple(button, clickPosX, clickPosY, brightSurface(button))
end

