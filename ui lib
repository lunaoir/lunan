local function checkSlotMatch(standValue, attValue, standOnly)
    if not standValue or standValue == "None" or not attValue then
        return false, nil
    end
    local displayStand = getDisplayName(standValue)
    for i, slot in ipairs(farmSlots) do
        local sm
        if slot.stand == "Any" then
            sm = true
        elseif slot.standId then
            sm = slot.standId == standValue
        else
            sm = nameKey(slot.stand) == nameKey(standValue)
                or nameKey(getDisplayName(slot.stand)) == nameKey(displayStand)
        end
        -- Optional query: can ANY attribute make this Stand worth keeping?
        -- Normal two-argument callers still require Stand AND Attribute.
        if sm and standOnly then
            return true, i
        end
        local am = false
        if type(slot.att) == "table" then
            for _, a in ipairs(slot.att) do
                if a == "Any" or a == attValue then
                    am = true
                    break
                end
            end
        else
            am = (slot.att == "Any") or (slot.att == attValue)
        end
        if sm and am then
            return true, i
        end
    end
    return false, nil
end

function featureState.isNamedTargetStand(standValue)
    if not standValue or standValue == "None" then
        return false
    end
    local displayStand = getDisplayName(standValue)
    for _, slot in ipairs(farmSlots) do
        if slot.stand ~= "Any" then
            if
                slot.standId == standValue
                or nameKey(slot.stand) == nameKey(standValue)
                or nameKey(getDisplayName(slot.stand)) == nameKey(displayStand)
            then
                return true
            end
        end
    end
    return false
end

