function Library:ApplyHacBach(gui)
    connect(gui.DescendantAdded,function(inst)
        task.defer(function()
            if gui.Parent and inst.Parent then reworkWorkspaceInstance(inst) end
        end)
    end)
    for _,inst in ipairs(gui:GetDescendants()) do reworkWorkspaceInstance(inst) end
end

function Library:CreateWindow(Config)
    local configSaving = Config and Config.ConfigurationSaving
    if type(configSaving) == "table" and configSaving.Enabled then
        self._compat.config = {
            FolderName = configSaving.FolderName or "LunaHub_SUR",
            FileName = configSaving.FileName or "LunaHub_Settings"
        }
    else
        self._compat.config = nil
    end

    return self:MakeWindow({
        Name = "HẮC BẠCH VÔ THƯỜNG",
        Subtitle = "THÁI CỰC SONG ĐIỆN  •  STAND UPRIGHT REBOOTED",
        LogoID = (Config and Config.LogoID)
            or ((Config and Config.Icon and Config.Icon ~= 0) and tostring(Config.Icon))
            or UI_CONFIG.LogoID,
        StartHidden = false,
        ToggleKeybind = (Config and Config.ToggleUIKeybind) or "K",
    })
end

function Library:SaveConfiguration()
    local cfg = self._compat.config
    if not cfg then return true end
    if type(writefile) ~= "function" then
        return false, "Configuration saver is unavailable."
    end
    if type(isfolder) == "function" and type(makefolder) == "function" then
        local exists = false
        local ok = pcall(function() exists = isfolder(cfg.FolderName) end)
        if ok and not exists then pcall(makefolder, cfg.FolderName) end
    end
    local flagsToSave = {}
    for flag, value in pairs(self._compat.flags) do
        if flag ~= "WebhookMentionsEnabled" and flag ~= "WebhookTagAtts" then
            flagsToSave[flag] = value
        end
    end
    local okEncode, encoded = pcall(function()
        return HttpService:JSONEncode({ flags = flagsToSave })
    end)
    if not okEncode then return false, encoded end
    local okWrite, err = pcall(function()
        writefile(cfg.FolderName .. "/" .. cfg.FileName .. ".json", encoded)
    end)
    if not okWrite then return false, err end
    return true
end

function Library:LoadConfiguration()
    local cfg = self._compat.config
    if not cfg then return true end
    if type(readfile) ~= "function" or type(isfile) ~= "function" then
        return false, "Configuration loader is unavailable."
    end
    local path = cfg.FolderName .. "/" .. cfg.FileName .. ".json"
    local exists = false
    local okExists = pcall(function() exists = isfile(path) end)
    if not okExists or not exists then return true end
    local okRead, raw = pcall(function() return readfile(path) end)
    if not okRead then return false, raw end
    local okDecode, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okDecode then return false, data end
    if type(data) ~= "table" or type(data.flags) ~= "table" then return true end
    for flag, value in pairs(data.flags) do
        if flag ~= "WebhookMentionsEnabled" and flag ~= "WebhookTagAtts" then
            self:_setFlag(flag, value, true)
        end
    end
    return true
end

return Library
end


