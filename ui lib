            if not cfg then
                return true
            end
            if type(isfile) ~= "function" or type(readfile) ~= "function" then
                return false, "Configuration loader is unavailable."
            end
            local path = cfg.FolderName .. "/" .. cfg.FileName .. ".json"
            local ok, data = pcall(function()
                if not isfile(path) then
                    return nil
                end
                return HttpService:JSONDecode(readfile(path))
            end)
            if not ok then
                return false, tostring(data)
            end
            if data == nil then
                return true
            end
            if type(data) ~= "table" or type(data.flags) ~= "table" then
                return false, "Invalid configuration format."
            end
            local excluded = {}
            for _, key in ipairs(cfg.ExcludedFlags or {}) do
                excluded[key] = true
            end
            local keys = {}
            for key, value in pairs(data.flags) do
                local control = self._controls[key]
                if control and not excluded[key] then
                    local valid, err = control:Validate(value)
                    if not valid then
                        return false, "Invalid setting " .. key .. ": " .. tostring(err)
                    end
                    table.insert(keys, key)
                end
            end
            -- Set scalar/options first, then toggles that can start a worker.
            table.sort(keys, function(a, b)
                local ta, tb = self._kinds[a] == "Toggle", self._kinds[b] == "Toggle"
                if ta ~= tb then
                    return not ta
                end
                return a < b
            end)
            for _, key in ipairs(keys) do
                local applied, err = pcall(function()
                    self:_setFlag(key, data.flags[key])
                end)
                if not applied then
                    return false, "Could not apply " .. key .. ": " .. tostring(err)
                end
            end
            return true
        end
        function Library:CreateWindow(config)
            assert(not window, "Create a separate library instance for another window.")
            config = config or {}
            local cfg = config.ConfigurationSaving
            if cfg and cfg.Enabled ~= false then
                self._compat.config = {
                    FolderName = cfg.FolderName or "LunaHub",
                    FileName = cfg.FileName or tostring(game.PlaceId),
                    ExcludedFlags = cfg.ExcludedFlags,
                }
            end
            local env = type(getgenv) == "function" and getgenv() or _G
            env.LunaWindUIWindows = env.LunaWindUIWindows or {}
            local registry = env.LunaWindUIWindows
            local identity = config.Id
                or (
                    tostring(game.PlaceId)
                    .. ":"
                    .. (cfg and cfg.FolderName or "")
                    .. ":"
                    .. (cfg and cfg.FileName or config.Name or "Luna")
                )
            if registry[identity] then
                registry[identity]:Destroy()
            end
            local native = WindUI:CreateWindow({
                Title = config.Name or "Luna Hub",
                Author = config.LoadingSubtitle or "",
                Folder = cfg and cfg.FolderName or "LunaHub",
                Theme = config.Theme or "Dark",
                Size = config.Size or UDim2.fromOffset(680, 500),
                MinSize = Vector2.new(340, 300),
                ToggleKey = Enum.KeyCode[config.ToggleUIKeybind or "K"],
                StartHidden = config.StartHidden ~= false,
                HideSearchBar = false,
                NewElements = true,
                Transparent = false,
            })
            assert(native, "WindUI did not create a window.")
            WindUI.ScreenGui.DisplayOrder = 10000
            WindUI.DropdownGui.DisplayOrder = 10001
            WindUI.TooltipGui.DisplayOrder = 10002
            WindUI.NotificationGui.DisplayOrder = 10003
            window = { Native = native, _tabs = {}, _destroyCallbacks = {}, _connections = {} }
            Library.Window = window
            local cleaning = false
            local function shutdown()
                if not alive or cleaning then
                    return
                end
                cleaning = true
                for _, callback in ipairs(window._destroyCallbacks) do
                    local ok, err = pcall(callback)
                    if not ok then
                        warn("[Luna UI] Cleanup failed: " .. tostring(err))
                    end
                end
                alive = false
                for _, connection in ipairs(window._connections) do
                    connection:Disconnect()
                end
                table.clear(window._connections)
                if registry[identity] == window then
                    registry[identity] = nil
                end
            end
            function window:OnDestroy(callback)
                table.insert(self._destroyCallbacks, callback)
            end
            function window:Connect(signal, callback)
                local connection = signal:Connect(function(...)
                    if alive then
                        callback(...)
                    end
                end)
                table.insert(self._connections, connection)
                return connection
            end
            function window:IsAlive()
                return alive
            end
            function window:Destroy()
                shutdown()
                if not native.Destroyed then
                    native:Destroy()
                end
            end
            function window:Open()
                if alive then
                    native:Open()
                end
            end
            function window:Close()
                if alive then
                    native:Close()
                end
            end
            function window:Toggle()
                if alive then
                    native:Toggle()
                end
            end
            function window:SelectTab(index)
                if alive then
                    native:SelectTab(index)
                end
            end
            native:OnDestroy(shutdown)
            window:Connect(WindUI.ScreenGui.Destroying, shutdown)
            registry[identity] = window

            function window:CreateTab(title, icon)
                local tabNative = native:Tab({ Title = title, Icon = icon })
                local index = #self._tabs + 1
                local tab = { Native = tabNative, Index = index }
                table.insert(self._tabs, tab)
                function tab:Select()
                    window:SelectTab(index)
                end
                function tab:CreateSection(text)
                    local current = tostring(text or "")
                    local paragraph = tabNative:Paragraph({ Title = current })
                    return {
                        Set = function(_, value)
                            value = tostring(value or "")
                            if alive and value ~= current then
                                current = value
                                paragraph:SetTitle(value)
                            end
                        end,
                        Native = paragraph,
                    }
                end
                function tab:CreateLabel(title, initial)
                    local paragraph = tabNative:Paragraph({ Title = title, Desc = tostring(initial or "") })
                    local value = tostring(initial or "")
                    return setmetatable({ Native = paragraph }, {
                        __index = function(_, key)
                            if key == "Text" then
                                return value
                            end
                        end,
                        __newindex = function(obj, key, new)
                            if key == "Text" then
                                new = tostring(new or "")
                                if alive and new ~= value then
                                    value = new
                                    paragraph:SetDesc(new)
                                end
                            else
                                rawset(obj, key, new)
                            end
                        end,
                    })
                end
                function tab:CreateButton(options)
                    local button = tabNative:Button({
                        Title = options.Name or "Button",
                        Desc = options.Description,
                        Icon = options.Icon,
                        Callback = function()
                            if alive then
                                invoke(options.Callback)
                            end
                        end,
                    })
                    return {
                        Native = button,
                        Fire = function()
                            if alive then
                                invoke(options.Callback)
                            end
                        end,
                    }
                end
                local function makeControl(kind, options)
                    local value
                    local control = {}
                    local nativeControl
                    local function normalize(raw)
                        if kind == "Toggle" then
                            if type(raw) ~= "boolean" then
                                return nil, "Expected boolean"
                            end
                            return raw
                        elseif kind == "Slider" then
                            local number = tonumber(raw)
                            if not number or number ~= number or math.abs(number) == math.huge then
                                return nil, "Expected finite number"
                            end
                            local range = options.Range or { 0, 100 }
                            local step = options.Increment or 1
                            return math.clamp(
                                range[1] + math.floor((number - range[1]) / step + 0.5) * step,
                                range[1],
                                range[2]
                            )
                        elseif kind == "Input" then
                            if type(raw) ~= "string" then
                                return nil, "Expected string"
                            end
                            return raw
                        end
                        if raw == nil then
                            raw = {}
                        end
                        if type(raw) == "string" then
                            raw = { raw }
                        end
                        if type(raw) ~= "table" then
                            return nil, "Expected selected options"
                        end
                        local result, seen = {}, {}
                        for _, item in ipairs(raw) do
                            if type(item) ~= "string" then
                                return nil, "Expected option names"
                            end
                            if not seen[item] then
                                table.insert(result, item)
                                seen[item] = true
                            end
                            if not options.MultipleOptions then
                                break
                            end
                        end
                        for _, exclusive in ipairs(options.ExclusiveOptions or {}) do
                            if seen[exclusive] and #result > 1 then
                                if type(value) == "table" and table.find(value, exclusive) then
                                    table.remove(result, table.find(result, exclusive))
                                else
                                    result = { exclusive }
                                end
                            end
                        end
                        return result
                    end
                    function control:Validate(raw)
                        local normalized, err = normalize(raw)
                        return err == nil, err, normalized
                    end
                    local function paint()
                        if not nativeControl or native.Destroyed then
                            return
                        end
                        if kind == "Dropdown" then
                            nativeControl:Select(options.MultipleOptions and clone(value) or value[1])
                        elseif kind == "Toggle" then
                            -- WindUI queues toggle callbacks; suppress the programmatic echo.
                            nativeControl:Set(value, false)
                        else
                            nativeControl:Set(value)
                        end
                    end
                    function control:Set(raw, skipCallback)
                        if not alive then
                            return
                        end
                        local nextValue, err = normalize(raw)
                        assert(not err, err)
                        local changedValue = not same(value, nextValue)
                        value = clone(nextValue)
                        if options.Flag then
                            Library._compat.flags[options.Flag] = clone(value)
                        end
                        if changedValue then
                            paint()
                        end
                        if not skipCallback then
                            invoke(options.Callback, clone(value))
                        end
                        return clone(value)
                    end
                    function control:Get()
                        return clone(value)
                    end
                    local initial = kind == "Dropdown" and (options.CurrentOption or {})
                        or options.CurrentValue
                    if initial == nil then
                        if kind == "Toggle" then
                            initial = false
                        elseif kind == "Slider" then
                            initial = 0
                        else
                            initial = ""
                        end
                    end
                    local err
                    value, err = normalize(initial)
                    assert(not err, err)
                    local function changed(raw)
                        if not alive then
                            return
                        end
                        local nextValue, problem = normalize(raw)
                        if problem then
                            warn("[Luna UI] Invalid control value: " .. problem)
                            return
                        end
                        local changedValue = not same(value, nextValue)
                        -- Native input has already painted itself. Only repaint if
                        -- canonicalization corrected it (e.g. exclusive Any or rounding).
                        local nativeValue = raw
                        if kind == "Dropdown" then
                            if raw == nil then
                                nativeValue = {}
                            elseif type(raw) == "string" then
                                nativeValue = { raw }
                            end
                        elseif kind == "Slider" then
                            nativeValue = tonumber(raw)
                        end
                        local needsCorrection = not same(nativeValue, nextValue)
                        value = clone(nextValue)
                        if options.Flag then
                            Library._compat.flags[options.Flag] = clone(value)
                        end
                        if needsCorrection then
                            paint()
                        end
                        if changedValue then
                            invoke(options.Callback, clone(value))
                        end
                    end
                    local params =
                        { Title = options.Name or kind, Desc = options.Description, Callback = changed }
                    if kind == "Dropdown" then
                        params.Values = options.Options or {}
                        params.Multi = options.MultipleOptions == true
                        params.Value = params.Multi and clone(value) or value[1]
                        params.SearchBarEnabled = true
                        params.AllowNone = true
                        nativeControl = tabNative:Dropdown(params)
                        local displayedOptions = clone(options.Options or {})
                        function control:Refresh(values)
                            local nextOptions = clone(values or {})
                            options.Options = nextOptions
                            if same(displayedOptions, nextOptions) then
                                return
                            end
                            displayedOptions = clone(nextOptions)
                            if alive and not native.Destroyed then
                                nativeControl:Refresh(nextOptions)
                            end
                        end
                    elseif kind == "Slider" then
                        local range = options.Range or { 0, 100 }
                        params.Value = { Min = range[1], Max = range[2], Default = value }
                        params.Step = options.Increment or 1
                        nativeControl = tabNative:Slider(params)
                    elseif kind == "Input" then
                        params.Value = value
                        params.Placeholder = options.PlaceholderText or ""
                        params.ClearTextOnFocus = false
                        nativeControl = tabNative:Input(params)
                    else
                        params.Value = value
                        nativeControl = tabNative:Toggle(params)
                    end
                    control.Native = nativeControl
                    if options.Flag then
                        assert(
                            not Library._controls[options.Flag],
                            "Duplicate control flag: " .. options.Flag
                        )
                        Library._controls[options.Flag] = control
                        Library._kinds[options.Flag] = kind
                        Library:_bindFlag(options.Flag, value, function(raw)
                            return control:Set(raw)
                        end)
                    end
                    return control
                end
                function tab:CreateToggle(options)
                    return makeControl("Toggle", options)
                end
                function tab:CreateInput(options)
                    return makeControl("Input", options)
                end
                function tab:CreateDropdown(options)
                    return makeControl("Dropdown", options)
                end
                function tab:CreateSlider(options)
                    return makeControl("Slider", options)
                end
                return tab
            end
            return window
        end
        return Library
    end

    return createLunaWindAdapter(WindUI)
end

