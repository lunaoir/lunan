-- ĐỔI CHỦ ĐỀ HẮC BẠCH (THEME SWITCHER)
--============================================================================--
function Library:ChangeTheme(themeName)
    local NEW_COLORS = Library.THEMES[themeName]
    if not NEW_COLORS then return end
    local OLD_COLORS = Library.COLORS

    local colorMap = {}
    for key, oldColor in pairs(OLD_COLORS) do
        if typeof(oldColor) == "Color3" and typeof(NEW_COLORS[key]) == "Color3" then
            colorMap[oldColor:ToHex()] = NEW_COLORS[key]
        end
    end

    local gui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("TienTaiStandHub")
    if gui then
        for _, obj in ipairs(gui:GetDescendants()) do
            if not isHacBachInternal(obj) then
                if obj:IsA("GuiObject") then
                    local hex = obj.BackgroundColor3:ToHex()
                    if colorMap[hex] then tween(obj, {BackgroundColor3 = colorMap[hex]}, 0.32) end
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        local tHex = obj.TextColor3:ToHex()
                        if colorMap[tHex] then tween(obj, {TextColor3 = colorMap[tHex]}, 0.32) end
                    end
                elseif obj:IsA("UIStroke") then
                    local sHex = obj.Color:ToHex()
                    if colorMap[sHex] then tween(obj, {Color = colorMap[sHex]}, 0.32) end
                end
            end
        end
    end
    Library.COLORS = NEW_COLORS
end

