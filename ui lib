local function make(className, parent, properties)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do object[key] = value end
    object.Parent = parent
    return object
end

local function rounded(frame, radius)
    make("UICorner", frame, { CornerRadius = UDim.new(0, radius or 9) })
end

local function button(parent, text, height)
    local control = make("TextButton", parent, {
        Size = UDim2.new(1, 0, 0, height or 38), BackgroundColor3 = palette.control,
        BorderSizePixel = 0, AutoButtonColor = true, Font = Enum.Font.GothamMedium,
        Text = text or "", TextColor3 = palette.text, TextSize = 14,
    })
    rounded(control)
    return control
end

local function cloneList(value)
    if type(value) ~= "table" then return value and { value } or {} end
    local result = {}
    for _, item in ipairs(value) do result[#result + 1] = item end
    return result
end

local function listContains(values, item)
    for _, value in ipairs(values) do if value == item then return true end end
    return false
end


local function createLunaInterface()
    palette = { panel=Color3.fromRGB(25,25,25), control=Color3.fromRGB(40,40,40),
        accent=Color3.fromRGB(96,130,255), text=Color3.fromRGB(235,235,235), muted=Color3.fromRGB(160,160,160) }
    local native = createValinciaLibrary()
    local unloadNative = native.Unload
    local library = {}
    library.NativeRayfield = library
    local window, serial
    serial = 0
    local function flag(options)
        serial += 1
        return options.Flag or ("LunaControl_" .. serial)
    end
    function library:IsVisible()
        return window and window.Alive and window.Gui.Enabled and window.Main.Visible
    end
    function library:Notify(data)
        if window and window.Alive then
            native:Notify({Text=tostring(data.Title or "Luna Hub") .. " • " .. tostring(data.Content or ""),
                Duration=data.Duration or 5})
