local function targetOptions(state)
    local options={}
    local needle=listQuery:lower():gsub("[^%w]","")
    for _,target in ipairs(state.Targets) do
        if needle=="" or target.Description:lower():gsub("[^%w]",""):find(needle,1,true) then
            table.insert(options,"Target "..target.Index..": "..target.Description)
        end
    end
    if #options==0 then options={"-- No matching targets --"} end
    return options
end
local function invoke(id,value)
    if not uiAlive or refreshing then return end
    if id=="Targets_Input_2" then listQuery=value;updateView();return end
    if id=="Targets_Dropdown_4" then
        local selected=type(value)=="table" and value[1] or value
        api:Call("SelectTarget",tonumber(tostring(selected or ""):match("^Target (%d+):")))
        return
    end
    local name=ActionNames[id]
    if name then api:Call(name,value) end
end
for _,id in ipairs(ControlOrder) do
    local overrides={}
    local name=ActionNames[id]
    local parameter=name and api.Parameters[name]
    if parameter then
        if parameter.Type=="selection" then overrides.CurrentOption=api:Get(name)
        else overrides.CurrentValue=api:Get(name) end
    end
    if id=="Targets_Dropdown_2" then overrides.Options=snapshot.StandChoices
    elseif id=="Targets_Dropdown_3" then overrides.Options=snapshot.Attributes
    elseif id=="Targets_Dropdown_4" then overrides.Options=targetOptions(snapshot)
    elseif id=="Targets_Section_4" then overrides.Arg1="Catalog: "..tostring(snapshot.Catalog)
    elseif id=="Targets_Section_7" then overrides.Arg1="Loading targets..."
    elseif id=="Dashboard_Section_5" then overrides.Arg1="Targets"
    elseif id=="Dashboard_Section_8" then overrides.Arg1="Ready"
    elseif id=="Farm_Label_4" then
        for _,title in ipairs({"Total CArrows","Today","This Week","This Month"}) do
            table.insert(stats,Rayfield:BindSURControl(id,nil,{Arg1=title}))
        end
