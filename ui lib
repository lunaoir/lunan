    --================== HỆ THỐNG FLAGS & CONFIG COMPATIBILITY ==================--
    function Library:_setFlag(flag, value, fromLoad)
        if not flag or flag == "" then return end
        self._compat.flags[flag] = value
        local setter = self._compat.bindings[flag]
        if setter then setter(value, fromLoad) end
    end

    function Library:_bindFlag(flag, defaultValue, setter)
        if not flag or flag == "" then return end
        if self._compat.flags[flag] == nil then
            self._compat.flags[flag] = defaultValue
        end
        self._compat.bindings[flag] = setter
    end

    -- Bộ chuyển đổi màu tự động ép các Workspace cũ (Tím/Xanh) sang tông Hắc Bạch Bento
    local function toBentoMonochrome(c, role)
        if typeof(c) ~= "Color3" then return c end
        local r, g, b = c.R * 255, c.G * 255, c.B * 255
        local lum = 0.299 * r + 0.587 * g + 0.114 * b
        if role == "bg" then
            if lum < 22 then return PALETTE.bg
            elseif lum < 42 then return PALETTE.panel
            elseif lum < 85 then
                if r > 85 and b > 145 then return PALETTE.accent end
                return PALETTE.card
            else return PALETTE.accent end
        elseif role == "stroke" then
            if lum > 95 or (r > 100 and b > 160) then return PALETTE.borderLight end
            return PALETTE.border
        elseif role == "text" then
            if lum > 185 then return PALETTE.text
            else return PALETTE.textSub end
        end
        return PALETTE.text
    end

    local styledSet = setmetatable({}, {__mode = "k"})
    local function restyleChildToBento(inst)
        if not inst or not inst.Parent or styledSet[inst] then return end
        styledSet[inst] = true
        if inst:IsA("GuiObject") then
            if inst.BackgroundTransparency < 0.98 then
                inst.BackgroundColor3 = toBentoMonochrome(inst.BackgroundColor3, "bg")
            end
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                local bright = (inst.BackgroundTransparency < 0.5) and (inst.BackgroundColor3.R > 0.75)
                inst.TextColor3 = bright and PALETTE.textDark or toBentoMonochrome(inst.TextColor3, "text")
            end
            if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
                if inst.Name ~= "RealAvatarImg" and inst.Name ~= "RealGameIcon" then
                    inst.ImageColor3 = toBentoMonochrome(inst.ImageColor3, "text")
                end
            end
        elseif inst:IsA("UIStroke") then
            inst.Color = toBentoMonochrome(inst.Color, "stroke")
        end
    end

