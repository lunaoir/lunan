        -- Logic Hover mở/đóng mượt không bị nhấp nháy
        local drawerShown = false
        local function updateHoverCheck()
            if not root.Visible then return end
            local mPos = UserInputService:GetMouseLocation()
            local rPos, rSize = arrowCircle.AbsolutePosition, arrowCircle.AbsoluteSize
            local nPos, nSize = notchBadge.AbsolutePosition, notchBadge.AbsoluteSize

            local nearArrow = (mPos.X >= rPos.X - 18 and mPos.X <= rPos.X + rSize.X + 18)
                          and (mPos.Y >= nPos.Y - 12 and mPos.Y <= rPos.Y + rSize.Y + 35)

            local nearDrawer = false
            if drawerShown then
                local dPos, dSize = infoDrawer.AbsolutePosition, infoDrawer.AbsoluteSize
                nearDrawer = (mPos.X >= dPos.X - 12 and mPos.X <= dPos.X + dSize.X + 12)
                         and (mPos.Y >= rPos.Y - 10 and mPos.Y <= dPos.Y + dSize.Y + 16)
            end

            local shouldOpen = nearArrow or nearDrawer
            if shouldOpen ~= drawerShown then
                drawerShown = shouldOpen
                if drawerShown then
                    infoDrawer.Visible = true
                    tween(infoDrawer, {Size = UDim2.fromOffset(MENU_W - 40, 80)}, 0.25, Enum.EasingStyle.Exponential)
                    tween(arrowSymbol, {Rotation = 180}, 0.22)
                    tween(arrowCircle, {BackgroundColor3 = PALETTE.accent}, 0.22)
                    tween(arrowSymbol, {TextColor3 = PALETTE.textDark}, 0.22)
                else
                    tween(arrowSymbol, {Rotation = 0}, 0.22)
                    tween(arrowCircle, {BackgroundColor3 = PALETTE.card}, 0.22)
                    tween(arrowSymbol, {TextColor3 = PALETTE.accent}, 0.22)
                    local t = tween(infoDrawer, {Size = UDim2.fromOffset(MENU_W - 40, 0)}, 0.20, Enum.EasingStyle.Quart)
                    t.Completed:Connect(function()
                        if not drawerShown then infoDrawer.Visible = false end
                    end)
                end
            end
        end
        connect(UserInputService.InputChanged, function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseMovement then
                updateHoverCheck()
            end
        end)

