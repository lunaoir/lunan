    local enabled=api:Get("WhiteMode")
    if enabled then
        if not whiteScreenGui then
            whiteScreenGui=Rayfield:CreateSURWhiteScreen(localplr,function()api:Call("WhiteMode",false)end)
        end
        whiteScreenGui.Enabled=true
        for _,gui in ipairs(localplr:WaitForChild("PlayerGui"):GetChildren()) do
            if gui:IsA("ScreenGui") and gui~=whiteScreenGui then
                if hiddenMenuGuis[gui]==nil then hiddenMenuGuis[gui]=gui.Enabled end
                gui.Enabled=false
