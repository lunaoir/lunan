local function toMonochromeColor(c, role)
    if typeof(c) ~= "Color3" then return c end
    local r, g, b = c.R * 255, c.G * 255, c.B * 255
    local maxC, minC = math.max(r, g, b), math.min(r, g, b)
    local sat = (maxC == 0) and 0 or ((maxC - minC) / maxC)
    local lum = 0.299 * r + 0.587 * g + 0.114 * b

    if sat < 0.12 or maxC-minC<8 then return c end

    if role == "bg" then
        if lum < 20 then return Color3.fromRGB(8, 8, 10)
        elseif lum < 35 then return Color3.fromRGB(14, 14, 18)
        elseif lum < 58 then return Color3.fromRGB(21, 21, 26)
        elseif lum < 120 then
            -- Các nút Tím chủ đạo (Add Target, Active Toggle, Selected Mode) -> Chuyển sang Bạch Ngọc
            if r > 85 and b > 145 then
                return Color3.fromRGB(242, 242, 248)
            end
            return Color3.fromRGB(34, 34, 40)
        else
            return Color3.fromRGB(246, 246, 250)
        end
    elseif role == "stroke" then
        if lum > 90 or (r > 100 and b > 165) then
            return Color3.fromRGB(218, 218, 228)
        end
        return Color3.fromRGB(52, 52, 60)
    elseif role == "text" then
        if lum > 190 then return Color3.fromRGB(248, 248, 252)
        elseif lum > 130 then return Color3.fromRGB(182, 182, 192)
        else return Color3.fromRGB(118, 118, 128) end
    elseif role == "image" then
        return Color3.fromRGB(238, 238, 244)
    end
    local v = math.clamp(math.floor(lum), 12, 248)
    return Color3.fromRGB(v, v, v)
end
Library.MonochromeColor = toMonochromeColor

