                track.Size = UDim2.new(0.42, 0, 0, 6)
                track.Position = UDim2.new(0.40, 0, 0.5, -3)
                track.BackgroundColor3 = PALETTE.bg
                track.Parent = row
                makeCorner(track, 3)

                local fill = Instance.new("Frame")
                fill.Size = UDim2.new(0, 0, 1, 0)
                fill.BackgroundColor3 = PALETTE.accent
                fill.Parent = track
                makeCorner(fill, 3)

                local hit = Instance.new("TextButton")
                hit.Size = UDim2.new(1, 0, 1, 14)
                hit.Position = UDim2.fromOffset(0, -7)
                hit.BackgroundTransparency = 1
                hit.Text = ""
                hit.Parent = track

                local sliding = false
                local function setVal(v)
                    v = math.clamp(tonumber(v) or min, min, max)
                    local step = min + math.floor(((v - min) / inc) + 0.5) * inc
                    step = math.clamp(step, min, max)
                    local pct = (max == min) and 0 or ((step - min) / (max - min))
                    fill.Size = UDim2.new(pct, 0, 1, 0)
                    valLbl.Text = tostring(step) .. suf
                    if flag then Library._compat.flags[flag] = step end
                    pcall(callback, step)
                end

                local function updateFromX(x)
                    local pct = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                    setVal(min + (max - min) * pct)
                end

                hit.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        updateFromX(inp.Position.X)
                    end
                end)
                connect(UserInputService.InputChanged, function(inp)
                    if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                        updateFromX(inp.Position.X)
                    end
                end)
                connect(UserInputService.InputEnded, function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)

                if flag then Library:_bindFlag(flag, cur, setVal) end
                setVal(cur)
                return { Set = function(_, v) setVal(v) end }
            end

            function TabObject:CreateInput(InputConfig)
                InputConfig = InputConfig or {}
                local titleText = InputConfig.Name or "Input"
                local cur = tostring(InputConfig.CurrentValue or "")
                local callback = InputConfig.Callback or function() end
                local flag = InputConfig.Flag

                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, 0, 0, 38)
                row.BackgroundColor3 = PALETTE.card
                row.Parent = page
                makeCorner(row, 8)
                makeStroke(row, PALETTE.border, 1, 0.4)

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(0.36, -8, 1, 0)
                lbl.Position = UDim2.fromOffset(12, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = titleText
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 12
                lbl.TextColor3 = PALETTE.text
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = row

                local box = Instance.new("TextBox")
                box.Size = UDim2.new(0.62, -12, 0, 24)
                box.Position = UDim2.new(0.38, 0, 0.5, -12)
                box.BackgroundColor3 = PALETTE.bg
                box.Text = cur
                box.PlaceholderText = tostring(InputConfig.PlaceholderText or "")
                box.ClearTextOnFocus = false
                box.Font = Enum.Font.Gotham
                box.TextSize = 11
                box.TextColor3 = PALETTE.text
                box.PlaceholderColor3 = PALETTE.textSub
                box.Parent = row
                makeCorner(box, 6)

                local function applyTxt(v)
                    cur = tostring(v or "")
                    box.Text = cur
                    if flag then Library._compat.flags[flag] = cur end
                    pcall(callback, cur)
                end
                if flag then Library:_bindFlag(flag, cur, applyTxt) end
                box.FocusLost:Connect(function() applyTxt(box.Text) end)
                return { Set = function(_, v) applyTxt(v) end }
            end

            function TabObject:CreateDropdown(DropConfig)
                DropConfig = DropConfig or {}
                local titleText = DropConfig.Name or "Dropdown"
                local options = cloneArray(DropConfig.Options)
                local current = cloneArray(DropConfig.CurrentOption)
                local multiple = (DropConfig.MultipleOptions == true)
                local callback = DropConfig.Callback or function() end
                local flag = DropConfig.Flag

                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, 0, 0, 38)
                row.BackgroundColor3 = PALETTE.card
                row.Parent = page
                makeCorner(row, 8)
                makeStroke(row, PALETTE.border, 1, 0.4)

                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(0.36, -8, 1, 0)
                lbl.Position = UDim2.fromOffset(12, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = titleText
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 12
                lbl.TextColor3 = PALETTE.text
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = row

                local selBtn = Instance.new("TextButton")
                selBtn.Size = UDim2.new(0.62, -12, 0, 24)
                selBtn.Position = UDim2.new(0.38, 0, 0.5, -12)
                selBtn.BackgroundColor3 = PALETTE.bg
                selBtn.Font = Enum.Font.GothamBold
                selBtn.TextSize = 11
                selBtn.TextColor3 = PALETTE.text
                selBtn.TextXAlignment = Enum.TextXAlignment.Left
                selBtn.TextTruncate = Enum.TextTruncate.AtEnd
                selBtn.AutoButtonColor = false
                selBtn.Parent = row
                makeCorner(selBtn, 6)

                local function updateText()
                    selBtn.Text = "  " .. (#current > 0 and table.concat(current, ", ") or "Chọn...")
                end
                local function applySel(nextList)
                    current = cloneArray(nextList)
                    if flag then Library._compat.flags[flag] = cloneArray(current) end
                    updateText()
                    pcall(callback, cloneArray(current))
                end

                selBtn.MouseButton1Click:Connect(function()
                    if #options == 0 then return end
                    local idx = 1
                    for i, v in ipairs(options) do
                        if v == current[1] then idx = (i % #options) + 1; break end
                    end
                    if multiple then
                        local found = nil
                        for i, v in ipairs(current) do
                            if v == options[idx] then found = i; break end
                        end
                        local nextSel = cloneArray(current)
                        if found then table.remove(nextSel, found) else table.insert(nextSel, options[idx]) end
                        applySel(nextSel)
                    else
                        applySel({options[idx]})
                    end
                end)

                if flag then
                    Library:_bindFlag(flag, current, function(v)
                        applySel(type(v) == "table" and v or {v})
                    end)
                end
                updateText()
                return {
                    Refresh = function(_, newOpts) options = cloneArray(newOpts); updateText() end,
                    Set = function(_, v) applySel(type(v) == "table" and v or {v}) end
                }
            end

            TabObject.CreateToggle = TabObject.AddToggle
            TabObject.CreateButton = TabObject.AddButton
            TabObject.CreateSlider = TabObject.AddSlider
            TabObject.AddInput = TabObject.CreateInput
            TabObject.AddDropdown = TabObject.CreateDropdown

            return TabObject
        end

        function WindowObject:CreateTab(TabName, Icon)
            return self:MakeTab({Name = TabName, Icon = Icon})
        end

        return WindowObject
    end

    function Library:CreateWindow(Config)
        local configSaving = Config and Config.ConfigurationSaving
        if type(configSaving) == "table" and configSaving.Enabled then
            self._compat.config = {
                FolderName = configSaving.FolderName or "LunaHub_SUR",
                FileName = configSaving.FileName or "LunaHub_Settings"
            }
        end
        return self:MakeWindow(Config)
    end

    function Library:SaveConfiguration()
        local cfg = self._compat.config
        if not cfg or type(writefile) ~= "function" then return true end
        local ok, err = pcall(function()
            if type(isfolder) == "function" and not isfolder(cfg.FolderName) then
                makefolder(cfg.FolderName)
            end
            writefile(cfg.FolderName .. "/" .. cfg.FileName .. ".json", HttpService:JSONEncode({flags = self._compat.flags}))
        end)
        return ok, err
    end

    function Library:LoadConfiguration()
        local cfg = self._compat.config
        if not cfg or type(readfile) ~= "function" or type(isfile) ~= "function" then return true end
        local path = cfg.FolderName .. "/" .. cfg.FileName .. ".json"
        if isfile(path) then
            local ok, err = pcall(function()
                local data = HttpService:JSONDecode(readfile(path))
                if type(data) == "table" and type(data.flags) == "table" then
                    for k, v in pairs(data.flags) do self:_setFlag(k, v, true) end
                end
            end)
            return ok, err
        end
        return true
    end

    return Library
end

return createEmbeddedLunaUI()
