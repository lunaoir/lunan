-- Luna Hub UI: compact, event-driven renderer with a Sleek-style palette.
-- This implementation is original; gameplay remains in LunaHub_Features.lua.
local palette

local function make(className, parent, properties)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do object[key] = value end
    object.Parent = parent
    return object
end

local function rounded(frame, radius)
    make("UICorner", frame, { CornerRadius = UDim.new(0, radius or 9) })
end

local function label(parent, text, size, color)
    return make("TextLabel", parent, {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, size + 12),
        Font = Enum.Font.GothamMedium, Text = text or "", TextSize = size,
        TextColor3 = color or palette.text, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    })
end

local function button(parent, text, height)
    local control = make("TextButton", parent, {
        Size = UDim2.new(1, 0, 0, height or 38), BackgroundColor3 = palette.control,
        BorderSizePixel = 0, AutoButtonColor = true, Font = Enum.Font.GothamMedium,
        Text = text or "", TextColor3 = palette.text, TextSize = 14,
    })
    rounded(control)
    return control
end

local function row(parent, height)
    local frame = make("Frame", parent, {
        Size = UDim2.new(1, -12, 0, height or 40), BackgroundTransparency = 1,
        BorderSizePixel = 0,
    })
    return frame
end

local function wrapper(node)
    return setmetatable({
        Set = function(_, value) node.Text = tostring(value or "") end,
    }, {
        __newindex = function(self, key, value)
            if key == "Text" then node.Text = tostring(value or "") else rawset(self, key, value) end
        end,
        __index = function(self, key)
            if key == "Text" then return node.Text end
            return rawget(self, key)
        end,
    })
end

local function cloneList(value)
    if type(value) ~= "table" then return value and { value } or {} end
    local result = {}
    for _, item in ipairs(value) do result[#result + 1] = item end
    return result
end

local function listContains(values, item)
    for _, value in ipairs(values) do if value == item then return true end end
    return false
end

local function createLunaInterface()
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    palette = {
        background = Color3.fromRGB(20, 21, 28),
        panel = Color3.fromRGB(27, 29, 38),
        control = Color3.fromRGB(36, 39, 50),
        accent = Color3.fromRGB(154, 105, 237),
        text = Color3.fromRGB(240, 240, 246),
        muted = Color3.fromRGB(170, 171, 186),
    }
    local library = { NativeRayfield = nil, _surTabs = nil }
    library.NativeRayfield = library
    local window

    function library:IsVisible()
        return window ~= nil and window.Alive and window.Gui.Enabled and window.Main.Visible
    end

    function library:Notify(data)
        if not window or not window.Alive then return end
        local toast = make("Frame", window.Gui, {
            AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
            Size = UDim2.fromOffset(310, 70), BackgroundColor3 = palette.panel,
            BorderSizePixel = 0, ZIndex = 20,
        })
        rounded(toast)
        local title = label(toast, tostring(data.Title or "Luna Hub"), 14, palette.accent)
        title.Position = UDim2.fromOffset(12, 5)
        title.Size = UDim2.new(1, -24, 0, 20)
        local content = label(toast, tostring(data.Content or ""), 12, palette.text)
        content.Position = UDim2.fromOffset(12, 28)
        content.Size = UDim2.new(1, -24, 0, 34)
        task.delay(tonumber(data.Duration) or 5, function()
            if toast.Parent then toast:Destroy() end
        end)
    end

    function library:CreateWindow(_settings)
        local player = assert(Players.LocalPlayer, "Luna UI requires a local player")
        local playerGui = player:WaitForChild("PlayerGui")
        local old = playerGui:FindFirstChild("LunaHubRebuiltUI")
        if old then old:Destroy() end
        local gui = make("ScreenGui", playerGui, {
            Name = "LunaHubRebuiltUI", ResetOnSpawn = false, IgnoreGuiInset = true,
            DisplayOrder = 100000,
        })
        local main = make("Frame", gui, {
            Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.92, 0, 0.82, 0),
            BackgroundColor3 = palette.background, BorderSizePixel = 0,
        })
        make("UISizeConstraint", main, { MaxSize = Vector2.new(720, 460) })
        rounded(main, 14)
        make("UIStroke", main, { Color = palette.accent, Transparency = 0.45, Thickness = 1 })
        local title = label(main, "LUNA HUB", 21, palette.text)
        title.Position = UDim2.fromOffset(18, 9)
        title.Size = UDim2.new(1, -74, 0, 37)
        title.Active = true
        local close = button(main, "×", 32)
        close.Size = UDim2.fromOffset(32, 32)
        close.Position = UDim2.new(1, -45, 0, 13)
        local sidebar = make("ScrollingFrame", main, {
            Position = UDim2.fromOffset(12, 56), Size = UDim2.new(0, 153, 1, -68),
            BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
        })
        make("UIListLayout", sidebar, { Padding = UDim.new(0, 7) })
        local content = make("Frame", main, {
            Position = UDim2.fromOffset(177, 56), Size = UDim2.new(1, -189, 1, -68),
            BackgroundColor3 = palette.panel, BorderSizePixel = 0,
        })
        rounded(content, 10)
        local launcher = button(gui, "🐈", 46)
        launcher.Name = "Launcher"
        launcher.Size = UDim2.fromOffset(46, 46)
        launcher.Position = UDim2.new(0, 16, 0.5, -23)
        launcher.BackgroundColor3 = palette.panel
        launcher.ZIndex = 5

        window = {
            Alive = true, Gui = gui, Main = main, Sidebar = sidebar,
            Content = content, Tabs = {}, Connections = {}, DestroyCallbacks = {},
        }

        function window:Connect(signal, callback)
            local connection = signal:Connect(callback)
            self.Connections[#self.Connections + 1] = connection
            return connection
        end
        function window:OnDestroy(callback)
            self.DestroyCallbacks[#self.DestroyCallbacks + 1] = callback
        end
        function window:Destroy()
            if not self.Alive then return end
            self.Alive = false
            for _, connection in ipairs(self.Connections) do connection:Disconnect() end
            for _, callback in ipairs(self.DestroyCallbacks) do
                local ok, err = pcall(callback)
                if not ok then warn("[Luna UI] Destroy: " .. tostring(err)) end
            end
            if self.Gui.Parent then self.Gui:Destroy() end
        end
        function window:SelectTab(index)
            for i, tab in ipairs(self.Tabs) do
                tab.Page.Visible = i == index
                tab.Button.BackgroundColor3 = i == index and palette.accent or palette.control
            end
        end

        local pointerStart, frameStart
        window:Connect(title.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                pointerStart, frameStart = input.Position, main.Position
            end
        end)
        window:Connect(UserInputService.InputChanged, function(input)
            if not pointerStart or (input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch) then return end
            local delta = input.Position - pointerStart
            main.Position = UDim2.new(frameStart.X.Scale, frameStart.X.Offset + delta.X,
                frameStart.Y.Scale, frameStart.Y.Offset + delta.Y)
        end)
        window:Connect(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                pointerStart, frameStart = nil, nil
            end
        end)

        local function toggle()
            if not window.Alive then return end
            local tween = TweenService:Create(launcher, TweenInfo.new(0.28, Enum.EasingStyle.Quad), {
                Rotation = (launcher.Rotation or 0) + 360,
            })
            tween:Play()
            main.Visible = not main.Visible
        end
        window:Connect(launcher.MouseButton1Click, toggle)
        window:Connect(close.MouseButton1Click, toggle)
        window:Connect(UserInputService.InputBegan, function(input, processed)
            if not processed and input.KeyCode == Enum.KeyCode.K then toggle() end
        end)
        return window
    end

    local function createTab(windowObject, name)
        local tabButton = button(windowObject.Sidebar, name, 39)
        local page = make("ScrollingFrame", windowObject.Content, {
            Name = name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
        })
        make("UIPadding", page, {
            PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
            PaddingTop = UDim.new(0, 11), PaddingBottom = UDim.new(0, 11),
        })
        make("UIListLayout", page, { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
        local tab = { Page = page, Button = tabButton }
        windowObject.Tabs[#windowObject.Tabs + 1] = tab
        local index = #windowObject.Tabs
        windowObject:Connect(tabButton.MouseButton1Click, function() windowObject:SelectTab(index) end)

        function tab:CreateSection(text)
            local item = label(page, tostring(text or ""), 13, palette.accent)
            item.Size = UDim2.new(1, -12, 0, 29)
            return wrapper(item)
        end
        function tab:CreateLabel(first, second)
            local item = label(page, tostring(second or first or ""), 13, palette.muted)
            item.Size = UDim2.new(1, -12, 0, 36)
            return wrapper(item)
        end
        function tab:CreateButton(options)
            local item = button(page, tostring(options.Name or "Action"), 38)
            item.Size = UDim2.new(1, -12, 0, 38)
            windowObject:Connect(item.MouseButton1Click, function()
                if options.Callback then options.Callback() end
            end)
            return { Set = function() end }
        end
        function tab:CreateToggle(options)
            local item = button(page, "", 38)
            item.Size = UDim2.new(1, -12, 0, 38)
            item.TextXAlignment = Enum.TextXAlignment.Left
            local indicator = make("TextLabel", item, {
                Position = UDim2.new(1, -36, 0.5, -15), Size = UDim2.fromOffset(30, 30),
                BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
                TextSize = 25, TextColor3 = palette.muted,
            })
            local value = options.CurrentValue == true
            local function render()
                item.Text = "   " .. tostring(options.Name or "Toggle")
                indicator.Text = value and "●" or "○"
                indicator.TextColor3 = value and palette.accent or palette.muted
            end
            local control = {}
            function control:Set(raw, silent)
                value = raw == true
                render()
                if not silent and options.Callback then options.Callback(value) end
            end
            windowObject:Connect(item.MouseButton1Click, function() control:Set(not value) end)
            render()
            return control
        end
        function tab:CreateInput(options)
            local frame = row(page, 67)
            local title = label(frame, tostring(options.Name or "Input"), 12, palette.muted)
            title.Size = UDim2.new(1, 0, 0, 23)
            local box = make("TextBox", frame, {
                Position = UDim2.fromOffset(0, 25), Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = palette.control, BorderSizePixel = 0,
                ClearTextOnFocus = false, Text = tostring(options.CurrentValue or ""),
                PlaceholderText = tostring(options.PlaceholderText or ""),
                TextColor3 = palette.text, PlaceholderColor3 = palette.muted,
                Font = Enum.Font.Gotham, TextSize = 13,
            })
            rounded(box)
            local control = {}
            function control:Set(raw, _silent)
                local text = tostring(raw or "")
                if box.Text ~= text then box.Text = text end
            end
            windowObject:Connect(box.FocusLost, function()
                if options.Callback then options.Callback(box.Text) end
            end)
            return control
        end
        function tab:CreateDropdown(options)
            local item = button(page, "", 39)
            item.Size = UDim2.new(1, -12, 0, 39)
            local choices = cloneList(options.Options)
            local selected = cloneList(options.CurrentOption)
            local open = false
            local optionButtons = {}
            local optionsFrame = make("Frame", page, {
                Size = UDim2.new(1, -12, 0, 0), BackgroundTransparency = 1,
                Visible = false, AutomaticSize = Enum.AutomaticSize.Y,
            })
            make("UIListLayout", optionsFrame, { Padding = UDim.new(0, 3) })
            local function render()
                item.Text = tostring(options.Name or "Select") .. ": " .. (#selected > 0 and table.concat(selected, ", ") or "—")
            end
            local updateOptions
            local control = {}
            function control:Set(raw, silent)
                selected = cloneList(raw)
                render()
                if open then updateOptions() end
                if not silent and options.Callback then options.Callback(cloneList(selected)) end
            end
            function control:Refresh(raw)
                local nextChoices = cloneList(raw)
                if #nextChoices == #choices then
                    local same = true
                    for index, choice in ipairs(nextChoices) do
                        if choices[index] ~= choice then same = false; break end
                    end
                    if same then return end
                end
                choices = nextChoices
                if open then updateOptions() end
            end
            updateOptions = function()
                for index, choice in ipairs(choices) do
                    local option = optionButtons[index]
                    if not option then
                        option = button(optionsFrame, "", 32)
                        optionButtons[index] = option
                        option.MouseButton1Click:Connect(function()
                            local chosen = choices[index]
                            if not chosen then return end
                            if options.MultipleOptions then
                                local nextValues = cloneList(selected)
                                local existing = table.find(nextValues, chosen)
                                if existing then table.remove(nextValues, existing) else
                                    if listContains(options.ExclusiveOptions or {}, chosen) then
                                        nextValues = { chosen }
                                    else
                                        for _, exclusive in ipairs(options.ExclusiveOptions or {}) do
                                            local selectedIndex = table.find(nextValues, exclusive)
                                            if selectedIndex then table.remove(nextValues, selectedIndex) end
                                        end
                                        nextValues[#nextValues + 1] = chosen
                                    end
                                end
                                control:Set(nextValues)
                            else
                                control:Set({ chosen })
                                open = false
                                optionsFrame.Visible = false
                            end
                        end)
                    end
                    option.Text = (listContains(selected, choice) and "✓  " or "   ") .. choice
                end
                for index = #optionButtons, #choices + 1, -1 do
                    optionButtons[index]:Destroy()
                    optionButtons[index] = nil
                end
            end
            function control:Open() updateOptions() end
            windowObject:Connect(item.MouseButton1Click, function()
                open = not open
                optionsFrame.Visible = open
                if open then control:Open() end
            end)
            render()
            return control
        end
        function tab:CreateSlider(options)
            local frame = row(page, 64)
            local title = label(frame, tostring(options.Name or "Value"), 12, palette.muted)
            title.Size = UDim2.new(1, 0, 0, 22)
            local minus = button(frame, "−", 37)
            minus.Position = UDim2.fromOffset(0, 24)
            minus.Size = UDim2.fromOffset(38, 37)
            local plus = button(frame, "+", 37)
            plus.Position = UDim2.new(1, -38, 0, 24)
            plus.Size = UDim2.fromOffset(38, 37)
            local box = make("TextBox", frame, {
                Position = UDim2.fromOffset(44, 24), Size = UDim2.new(1, -88, 0, 37),
                BackgroundColor3 = palette.control, BorderSizePixel = 0,
                TextColor3 = palette.text, Font = Enum.Font.GothamMedium, TextSize = 14,
                ClearTextOnFocus = false, Text = "",
            })
            rounded(box)
            local value = tonumber(options.CurrentValue) or 0
            local control = {}
            function control:Set(raw, silent)
                local number = tonumber(tostring(raw):match("[+-]?%d+%.?%d*"))
                if not number then box.Text = tostring(value) .. tostring(options.Suffix or ""); return end
                local range = options.Range or { 0, 100 }
                local increment = options.Increment or 1
                number = math.clamp(range[1] + math.floor((number - range[1]) / increment + 0.5) * increment, range[1], range[2])
                number = math.round(number * 1000) / 1000
                value = number
                box.Text = tostring(value) .. tostring(options.Suffix or "")
                if not silent and options.Callback then options.Callback(value) end
            end
            windowObject:Connect(box.FocusLost, function() control:Set(box.Text) end)
            windowObject:Connect(minus.MouseButton1Click, function()
                control:Set(value - (options.Increment or 1))
            end)
            windowObject:Connect(plus.MouseButton1Click, function()
                control:Set(value + (options.Increment or 1))
            end)
            control:Set(value, true)
            return control
        end
        return tab
    end

    function library:CreateSURWindow()
        return self:CreateWindow({})
    end
    function library:CreateSURNavigation(windowObject)
        local tabs = {}
        local names = {
            { "Farm", "Stand Farm" }, { "Dashboard", "Home" },
            { "Targets", "Targets" }, { "Storage", "Storage & Orb" },
            { "Lair", "Auto Lair" }, { "Utilities", "Utilities" },
            { "Settings", "Settings" },
        }
        for _, pair in ipairs(names) do tabs[pair[1]] = createTab(windowObject, pair[2]) end
        self._surTabs = tabs
        return tabs
    end
    function library:CreateSURBootstrap(player)
        local playerGui = player:WaitForChild("PlayerGui")
        local old = playerGui:FindFirstChild("LunaHubBootStatus")
        if old then old:Destroy() end
        local gui = make("ScreenGui", playerGui, { Name = "LunaHubBootStatus", ResetOnSpawn = false, DisplayOrder = 100001 })
        local note = make("TextLabel", gui, {
            AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12),
            Size = UDim2.fromOffset(420, 38), BackgroundColor3 = palette.panel,
            TextColor3 = palette.text, Font = Enum.Font.GothamMedium,
            TextSize = 14, Text = "Luna Hub  •  Starting...",
        })
        rounded(note)
        return {
            Gui = gui,
            SetStatus = function(_, status, failed)
                note.Text = "Luna Hub  •  " .. tostring(status)
                note.TextColor3 = failed and Color3.fromRGB(255, 130, 150) or palette.text
            end,
        }
    end
    function library:CreateSURWhiteScreen(player, onClose)
        local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), {
            Name = "SURWhiteScreen", ResetOnSpawn = false, IgnoreGuiInset = true,
            DisplayOrder = 999999,
        })
        local frame = make("Frame", gui, {
            Name = "MainFrame", Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(248, 248, 248), BorderSizePixel = 0,
        })
        local close = button(frame, "×", 36)
        close.Size = UDim2.fromOffset(36, 36)
        close.Position = UDim2.new(1, -52, 0, 16)
        close.MouseButton1Click:Connect(onClose)
        make("TextLabel", frame, {
            Name = "InfoText", BackgroundTransparency = 1,
            Position = UDim2.fromOffset(28, 76), Size = UDim2.new(1, -56, 1, -96),
            TextColor3 = Color3.fromRGB(28, 28, 28), Font = Enum.Font.GothamSemibold,
            TextSize = 22, TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top, Text = "Loading...",
        })
        return gui
    end
    function library:SetSURWhiteScreenText(gui, value)
        local frame = gui and gui:FindFirstChild("MainFrame")
        local text = frame and frame:FindFirstChild("InfoText")
        if text then text.Text = value end
    end
    return library
end

