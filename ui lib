                        if cloneref3(game:GetService("Workspace")).CurrentCamera then
                            for index, child in
                                pairs(cloneref3(game:GetService("Workspace")).CurrentCamera:GetChildren())
                            do
                                register(child)
                            end
                        end
                    end

                    registerDefaults()
                    Acrylic2.Enable()
                end

                return Acrylic2
            end

