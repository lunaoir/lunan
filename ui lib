function Library:BindSURControl(id, callback, overrides)
    local spec = assert(SURControls[id], "Unknown SUR control: " .. tostring(id))
    local tab = assert(self._surTabs and self._surTabs[spec.Tab], "SUR navigation is not ready")
    local options = copySURValue(spec.Options)
    for key, value in pairs(overrides or {}) do
        options[key] = value
    end
    if spec.Kind == "Section" then
        return tab:CreateSection(options.Arg1)
    end
    if spec.Kind == "Label" then
        return tab:CreateLabel(options.Arg1, options.Arg2)
    end
    options.Callback = callback
    return tab["Create" .. spec.Kind](tab, options)
end

return Library
end

