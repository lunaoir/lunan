                        query = query or ""

                        local result = Search(query)

                        ScrollingFrame.Visible = true
                        SearchFrame.Frame.Results.Frame.Visible = true
                        for index, item in next, ScrollingFrame:GetChildren() do
                            if item.ClassName ~= "UIListLayout" and item.ClassName ~= "UIPadding" then
                                item:Destroy()
                            end
                        end

                        if result and next(result) ~= nil then
                            for tabindex, item in next, result do
                                local TabIcon = SearchBarModule.Icons.Tab
                                local TabMainElement = CreateSearchTab(
                                    item.Title,
                                    nil,
                                    TabIcon,
                                    ScrollingFrame,
                                    true,
                                    function()
                                        SearchBarModule:Close()
                                        TabModule:SelectTab(tabindex)
                                    end
                                )
                                if item.Elements and next(item.Elements) ~= nil then
                                    for elemindex, item2 in next, item.Elements do
                                        local ElementIcon = SearchBarModule.Icons[item2.__type]
                                        CreateSearchTab(
                                            item2.Title,
                                            item2.Desc,
                                            ElementIcon,
                                            TabMainElement:FindFirstChild("ParentContainer")
                                                    and TabMainElement.ParentContainer.Frame
                                                or nil,
                                            false,
                                            function()
                                                SearchBarModule:Close()
                                                TabModule:SelectTab(tabindex)
                                                if item.Tab.ScrollToTheElement then
                                                    item.Tab:ScrollToTheElement(item2.Index)
                                                end
                                            end
                                        )
                                    end
                                end
                            end
                        elseif query ~= "" then
