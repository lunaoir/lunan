                        local position = Main.CanvasGroup.Viewport.AbsolutePosition
                        local position2 = Main.CanvasGroup.Viewport.AbsoluteSize

                        return argument.X >= position.X
                            and argument.X <= position.X + position2.X
                            and argument.Y >= position.Y
                            and argument.Y <= position.Y + position2.Y
                    end

