local function newFeatureEngine()
    local engine = {Version=1, Values={}, Parameters={}, Commands={}, Flags={}, FlagNames={}, Listeners={}, StopHandlers={}, Alive=true}
    local function copy(value)
        if type(value) ~= "table" then return value end
        local result={}
        for key,item in pairs(value) do result[key]=copy(item) end
        return result
    end
    function engine:IsRunning()
        return self.Alive and (not self.SessionToken or getgenv().SURFarmSession == self.SessionToken)
    end
    function engine:Emit(event, data)
        if not self.Alive then return end
        for _,entry in ipairs(self.Listeners[event] or {}) do
            if entry.Connected then
                local ok,err=pcall(entry.Callback,copy(data))
                if not ok then warn("[Luna Features] Observer: "..tostring(err)) end
            end
        end
    end
    function engine:Subscribe(event, callback)
        assert(type(callback)=="function","Observer must be a function")
        local entry={Connected=true,Callback=callback}
        function entry:Disconnect() self.Connected=false end
        self.Listeners[event]=self.Listeners[event] or {}
        table.insert(self.Listeners[event],entry)
        return entry
    end
    function engine:OnStop(callback) table.insert(self.StopHandlers,callback) end
    function engine:Destroy()
        if not self.Alive or self.Stopping then return end
        self.Stopping=true
        for _,callback in ipairs(self.StopHandlers) do
            local ok,err=pcall(callback)
            if not ok then warn("[Luna Features] Stop: "..tostring(err)) end
        end
        self.Alive=false
        table.clear(self.Listeners)
        table.clear(self.StopHandlers)
        if getgenv().LunaFeatureSession==self then getgenv().LunaFeatureSession=nil end
    end
    function engine:Notify(title, content)
        self.PendingNotifications=self.PendingNotifications or {}
        local data={Title=tostring(title),Content=tostring(content or title)}
        if #(self.Listeners.Notice or {})==0 then
            table.insert(self.PendingNotifications,data)
            if #self.PendingNotifications>50 then table.remove(self.PendingNotifications,1) end
        else self:Emit("Notice",data) end
    end
    function engine:FlushNotices()
        local pending=self.PendingNotifications or {}
        self.PendingNotifications={}
        for _,data in ipairs(pending) do self:Emit("Notice",data) end
    end
    function engine:SetPromptHandler(callback) self.PromptHandler=callback end
    function engine:Ask(text,title,style)
        if self.PromptHandler then return self.PromptHandler(text,title,style) end
        self:Notify(title or "SUR",text)
    end
    local function normalize(schema, raw, previous)
        if schema.Type=="boolean" then
            assert(type(raw)=="boolean","Expected boolean")
        elseif schema.Type=="number" then
            raw=tonumber(raw)
            assert(raw and raw==raw and math.abs(raw)~=math.huge,"Expected finite number")
            local range=schema.Range or {0,100};local step=schema.Increment or 1
            raw=math.clamp(range[1]+math.floor((raw-range[1])/step+0.5)*step,range[1],range[2])
        elseif schema.Type=="string" then
            assert(type(raw)=="string","Expected string")
        elseif schema.Type=="selection" then
            if type(raw)=="string" then raw={raw} end
            assert(type(raw)=="table","Expected selected values")
            local values,seen={},{}
            for _,item in ipairs(raw) do
                assert(type(item)=="string","Expected option names")
                if not seen[item] then table.insert(values,item);seen[item]=true end
                if not schema.Multiple then break end
            end
            for _,exclusive in ipairs(schema.Exclusive or {}) do
                if seen[exclusive] and #values>1 then
                    if type(previous)=="table" and table.find(previous,exclusive) then
                        table.remove(values,table.find(values,exclusive))
                    else values={exclusive} end
                end
            end
            raw=values
        end
        return copy(raw)
    end
    function engine:Register(name, callback)
        assert(not self.Commands[name],"Duplicate command: "..name)
        self.Commands[name]=callback
    end
    function engine:Define(name,schema,initial,callback)
        self.Parameters[name]=schema
        self:Register(name,callback)
        self.Values[name]=normalize(schema,initial)
        if schema.Flag then self.FlagNames[schema.Flag]=name;self.Flags[schema.Flag]=copy(self.Values[name]) end
    end
    function engine:Get(name) return copy(self.Values[name]) end
    function engine:Set(name,value,silent)
        assert(self.Alive,"Feature session has stopped")
        local schema=assert(self.Parameters[name],"Unknown parameter: "..tostring(name))
        value=normalize(schema,value,self.Values[name]);self.Values[name]=value
        if schema.Flag then self.Flags[schema.Flag]=copy(value) end
        if not silent then self.Commands[name](copy(value)) end
        if schema.Flag then self.Flags[schema.Flag]=copy(self.Values[name]) end
        self:Emit("Changed")
        return self:Get(name)
    end
    function engine:Call(name,...)
        if not self.Alive then return false,"Feature session has stopped" end
        if self.Parameters[name] then return self:Set(name,...) end
        local command=assert(self.Commands[name],"Unknown command: "..tostring(name))
        local results=table.pack(command(...))
        self:Emit("Changed")
        return table.unpack(results,1,results.n)
    end
    return engine
end
