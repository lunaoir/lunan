do
    local selectedLairLevel = "Lv 200"
    local joinEnabled = false
    local joinRun = nil
    local joinConnection = nil
    local useLairNPCName = "i_stabman"
    local targetedLairNPC = nil
    local lastLairAttempt = 0

    local function joinSessionActive(run)
        return joinEnabled
            and joinRun == run
            and getgenv().SURFarmSession == hubSession
            and engine:IsRunning()
    end

    local function getInstanceRootPart(instance)
        if not instance then
            return nil
        end
        if instance:IsA("Model") then
            return instance.PrimaryPart
                or instance:FindFirstChild("HumanoidRootPart")
                or instance:FindFirstChild("Torso")
                or instance:FindFirstChild("UpperTorso")
        end
        if instance:IsA("BasePart") then
            return instance
        end
        return nil
    end

    local function getInstancePosition(instance)
        local root = getInstanceRootPart(instance)
        return root and root.Position or nil
    end

    local function findTargetedLairNPC()
        local npc = targetedLairNPC
        local map = game.Workspace:FindFirstChild("Map")
        local npcsFolder = map and map:FindFirstChild("NPCs")
        if npc and npc.Parent and npc.Name == useLairNPCName and npc:FindFirstChild("Done") then
            return npc
        end
        if not npcsFolder then
            targetedLairNPC = nil
            return nil
        end
        npc = nil
        local char = localplr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local referencePos = hrp and hrp.Position
        local closestDist = math.huge
        for _, candidate in ipairs(npcsFolder:GetChildren()) do
            if candidate.Name == useLairNPCName and candidate:FindFirstChild("Done") then
                local pos = getInstancePosition(candidate)
                if pos then
                    local dist
                    if useLairNPCName == "i_stabman" then
                        dist = (pos - STABMAN_NPC_COORD).Magnitude
                    elseif referencePos then
                        dist = (pos - referencePos).Magnitude
                    end
                    if dist and dist < closestDist then
                        closestDist = dist
                        npc = candidate
                    end
                end
                npc = npc or candidate
            end
        end
        targetedLairNPC = npc
        return npc
    end

    local function tryEnterLair()
        local now = os.clock()
        -- Five attempts per second is still immediate, but avoids flooding the same
        -- server remote every rendered frame while a Lair transition is pending.
        if now - lastLairAttempt < 0.2 then
            return
        end
        local npc = findTargetedLairNPC()
        if not npc then
            return
        end
        local doneRemote = npc:FindFirstChild("Done")
        if not doneRemote or not doneRemote:IsA("RemoteEvent") then
            return
        end
        lastLairAttempt = now
        pcall(function()
            doneRemote:FireServer(localplr.Character)
        end)
    end

    local function stopJoinConnection()
        if joinConnection then
            joinConnection:Disconnect()
            joinConnection = nil
        end
        targetedLairNPC = nil
        lastLairAttempt = 0
    end
    engine:OnStop(function()
        joinEnabled = false
        joinRun = nil
        stopJoinConnection()
    end)

    
    engine:Define("LairLevel", {Type="selection"}, {selectedLairLevel}, function(values)
        selectedLairLevel = values[1] == "Lv 200" and values[1] or "Lv 200"
    end)
    engine:Define("JoinLair", {Type="boolean"}, false, function(value)
        local enabled = value == true
        if joinEnabled == enabled then
            return
        end
        joinEnabled = enabled
        joinRun = nil
        stopJoinConnection()
        if not enabled then
            return
        end
        local run = {}
        joinRun = run
        local connection
        connection = game:GetService("RunService").Heartbeat:Connect(function()
            if not joinSessionActive(run) then
                connection:Disconnect()
                if joinConnection == connection then
                    joinConnection = nil
                end
                return
            end
            -- Match the official entry caller's character readiness checks.
            local char = localplr.Character
            if not char then
                return
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                return
            end
            tryEnterLair()
        end)
        joinConnection = connection
    end)
end

