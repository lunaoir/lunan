-- One idle listener per session; no polling worker or held mouse input.
do
    local connection: RBXScriptConnection? = nil
    local function stopAntiAFK()
        if connection then
            connection:Disconnect()
            if getgenv().SURAntiAfkConnection == connection then
                getgenv().SURAntiAfkConnection = nil
            end
            connection = nil
        end
    end
    local function reportFailure(err)
        stopAntiAFK()
        engine.Values.AntiAFK = false
        engine:Emit("Changed")
        engine:Notify("Anti AFK", "Khong the mo phong thao tac: "..tostring(err))
