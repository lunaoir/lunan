	---------------------------------------------------------------- launcher
	local launcher = make("CanvasGroup", {
		Name = "Launcher", BackgroundColor3 = C.Sidebar, GroupTransparency = 1, Visible = false, ZIndex = 6,
		Size = UDim2.fromOffset(44, 44),
	}, gui)
	corner(launcher, 12)
