    -- Generic control/configuration bridge. Game callbacks belong to the caller.
    local function createLunaWindAdapter(WindUI)
        local HttpService = game:GetService("HttpService")
        local Library =
            { WindUI = WindUI, _compat = { flags = {}, bindings = {}, config = nil }, _kinds = {}, _controls = {} }
        local alive = true
        local window
        local function clone(v)
            return type(v) == "table" and table.clone(v) or v
        end
        local function same(a, b)
            if type(a) ~= type(b) then
                return false
            end
            if type(a) ~= "table" then
                return a == b
            end
            if #a ~= #b then
                return false
            end
            for i, v in ipairs(a) do
                if v ~= b[i] then
                    return false
                end
            end
            return true
        end
        local function invoke(callback, ...)
            if not callback then
                return
            end
            local ok, err = pcall(callback, ...)
            if not ok then
                warn("[Luna UI] Control callback failed: " .. tostring(err))
                error(err, 0)
            end
        end
        function Library:_setFlag(flag, value)
            local setter = self._compat.bindings[flag]
            if setter then
                return setter(clone(value))
            end
        end
        function Library:_bindFlag(flag, value, setter)
            self._compat.flags[flag] = clone(value)
            self._compat.bindings[flag] = setter
        end
        function Library:Notify(config)
            if alive then
                return WindUI:Notify(config)
            end
        end
        function Library:ChangeTheme(theme)
            return WindUI:SetTheme(theme)
        end
        function Library:SaveConfiguration()
            local cfg = self._compat.config
            if not cfg then
                return true
            end
            if type(writefile) ~= "function" then
                return false, "Configuration saver is unavailable."
            end
            local excluded = {}
            for _, key in ipairs(cfg.ExcludedFlags or {}) do
                excluded[key] = true
            end
            local flags = {}
            for key, value in pairs(self._compat.flags) do
                if not excluded[key] then
                    flags[key] = clone(value)
                end
            end
            local ok, err = pcall(function()
                if
                    type(isfolder) == "function"
                    and type(makefolder) == "function"
                    and not isfolder(cfg.FolderName)
                then
                    makefolder(cfg.FolderName)
                end
                writefile(
                    cfg.FolderName .. "/" .. cfg.FileName .. ".json",
                    HttpService:JSONEncode({ flags = flags })
                )
            end)
            return ok, not ok and tostring(err) or nil
        end
        function Library:LoadConfiguration()
