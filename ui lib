            menuScroll.BorderSizePixel = 0
            menuScroll.ScrollBarThickness = 2
            menuScroll.ScrollBarImageColor3 = Library.COLORS.accent1
            menuScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
            menuScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            menuScroll.Visible = false
            menuScroll.ZIndex = 46
            menuScroll.Parent = menu

            local menuLayout = Instance.new("UIListLayout", menuScroll)
            menuLayout.Padding = UDim.new(0, 4)

            local function updateSummary()
                if #current == 0 then
                    selector.Text = "  Chọn mục..."
                else
                    local summary = table.concat(current, ", ")
                    if #summary > 28 then
                        summary = string.sub(summary, 1, 25) .. "..."
                    end
                    selector.Text = "  " .. summary
                end
            end

            local function applySelection(nextSelection)
                current = cloneArray(nextSelection)
                if flag then
                    Library._compat.flags[flag] = cloneArray(current)
                end
                updateSummary()
                pcall(callback, cloneArray(current))
            end

            local function positionPopup(totalHeight)
                local menuWidth = math.max(120, math.min(row.AbsoluteSize.X / fitScale, content.AbsoluteSize.X / fitScale - 12))
                local relX = (row.AbsolutePosition.X - content.AbsolutePosition.X) / fitScale
                local relY = (row.AbsolutePosition.Y - content.AbsolutePosition.Y) / fitScale
                local maxX = math.max(layout.contentInset, content.AbsoluteSize.X / fitScale - menuWidth - layout.contentInset)
                local finalX = math.clamp(relX, layout.contentInset, maxX)
                local openAbove = (relY + row.AbsoluteSize.Y / fitScale + totalHeight > content.AbsoluteSize.Y / fitScale - layout.contentInset) and (relY > totalHeight)
                local finalY = openAbove and (relY - totalHeight - 6) or (relY + row.AbsoluteSize.Y / fitScale + 6)
                menu.Position = UDim2.fromOffset(finalX, finalY)
                tween(menu, {Size = UDim2.fromOffset(menuWidth, totalHeight)}, 0.18, Enum.EasingStyle.Exponential)
            end

            local setOpen
            local closeDropdown

            local function rebuildOptions()
                for _, child in ipairs(menuScroll:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                for _, optionValue in ipairs(options) do
                    local optionText = tostring(optionValue)
                    if searchText ~= "" and not string.find(string.lower(optionText), string.lower(searchText), 1, true) then
                        continue
                    end
                    local isSelected = false
                    for _, sel in ipairs(current) do
                        if sel == optionValue then isSelected = true; break end
                    end

                    local optionBtn = Instance.new("TextButton")
                    optionBtn.Size = UDim2.new(1, 0, 0, 26)
                    optionBtn.BackgroundColor3 = isSelected and Color3.fromRGB(242, 242, 248) or Color3.fromRGB(18, 18, 22)
                    optionBtn.BorderSizePixel = 0
                    optionBtn.Text = (isSelected and "  ◈  " or "  •  ") .. optionText
                    optionBtn.TextXAlignment = Enum.TextXAlignment.Left
                    optionBtn.Font = isSelected and Enum.Font.GothamBold or Enum.Font.Gotham
                    optionBtn.TextSize = 11
                    optionBtn.TextColor3 = isSelected and Color3.fromRGB(10, 10, 13) or Library.COLORS.text
                    optionBtn.TextTruncate = Enum.TextTruncate.AtEnd
                    optionBtn.AutoButtonColor = false
                    optionBtn.ZIndex = 47
                    optionBtn.Parent = menuScroll
                    corner(5).Parent = optionBtn

                    optionBtn.MouseEnter:Connect(function()
                        if not isSelected then
                            tween(optionBtn, {BackgroundColor3 = Color3.fromRGB(34, 34, 42)}, 0.12)
                        end
                    end)
                    optionBtn.MouseLeave:Connect(function()
                        if not isSelected then
                            tween(optionBtn, {BackgroundColor3 = Color3.fromRGB(18, 18, 22)}, 0.12)
                        end
                    end)

                    optionBtn.MouseButton1Click:Connect(function()
                        if multiple then
                            local nextSelection = cloneArray(current)
                            local existingIndex = nil
                            for index, existing in ipairs(nextSelection) do
                                if existing == optionValue then existingIndex = index; break end
                            end
                            if existingIndex then
                                table.remove(nextSelection, existingIndex)
                            else
                                table.insert(nextSelection, optionValue)
                            end
                            applySelection(nextSelection)
                            rebuildOptions()
                        else
                            applySelection({optionValue})
                            setOpen(false)
                        end
                    end)
                end
            end

            searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                searchText = searchBox.Text or ""
                rebuildOptions()
            end)

            setOpen = function(state)
                open = state
                if open then
                    menu.Visible = true
                    searchBox.Visible = true
                    menuScroll.Visible = true
                    rebuildOptions()
                    local visibleCount = 0
                    for _, child in ipairs(menuScroll:GetChildren()) do
                        if child:IsA("TextButton") then visibleCount = visibleCount + 1 end
                    end
                    local listHeight = math.max(30, math.min(visibleCount, 6) * 30)
                    local totalHeight = 44 + listHeight + 8
                    menuScroll.Position = UDim2.new(0, 6, 0, 38)
                    menuScroll.Size = UDim2.new(1, -12, 0, listHeight)
                    positionPopup(totalHeight)
                else
                    searchBox.Visible = false
                    menuScroll.Visible = false
                    searchBox.Text = ""
                    searchText = ""
                    menu.Size = UDim2.fromOffset(0, 0)
                    menu.Visible = false
                end
            end

            closeDropdown = function()
                if open then setOpen(false) end
            end
            table.insert(dropdownClosers, closeDropdown)

            page:GetPropertyChangedSignal("CanvasPosition"):Connect(closeDropdown)
            page:GetPropertyChangedSignal("Visible"):Connect(function()
                if not page.Visible then closeDropdown() end
            end)

            selector.MouseButton1Click:Connect(function()
                if open then
                    setOpen(false)
                else
                    closeAllDropdowns(closeDropdown)
                    setOpen(true)
                end
            end)

            connect(UserInputService.InputBegan, function(input, gp)
                if gp or not open then return end
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
                local inputPos = Vector2.new(input.Position.X, input.Position.Y)
                local function isInside(guiObject)
                    local absPos, absSize = guiObject.AbsolutePosition, guiObject.AbsoluteSize
                    return inputPos.X >= absPos.X and inputPos.X <= absPos.X + absSize.X
                        and inputPos.Y >= absPos.Y and inputPos.Y <= absPos.Y + absSize.Y
                end
                if not isInside(menu) and not isInside(selector) then
                    setOpen(false)
                end
            end)

            if flag then
                Library:_bindFlag(flag, current, function(value)
                    if type(value) == "table" then applySelection(value)
                    elseif value == nil then applySelection({})
                    else applySelection({value}) end
                end)
            end

            rebuildOptions()
            updateSummary()

            return {
                Refresh = function(_, newOptions)
                    options = cloneArray(newOptions)
                    updateSearchTarget(dropdownSearchEntry, titleText, options)
                    rebuildOptions()
                    setOpen(false)
                end,
                Set = function(_, value)
                    if type(value) == "table" then applySelection(value)
                    elseif value == nil then applySelection({})
                    else applySelection({value}) end
                end
            }
        end

        TabObject.CreateToggle = TabObject.AddToggle
        TabObject.CreateButton = TabObject.AddButton
        TabObject.CreateSlider = TabObject.AddSlider
        TabObject.AddInput = TabObject.CreateInput
        TabObject.AddDropdown = TabObject.CreateDropdown

        TabObject._page = page
        TabObject._searchEntries = pageSearchEntries
        TabObject.Select = function()
            setActiveTab(TabName)
        end
        return TabObject
    end

