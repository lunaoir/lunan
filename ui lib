                    local function GetImageExtension(url)
                        if not url or typeof(url) ~= "string" then
                            return ".png"
                        end
                        local cleanUrl = url:match("^([^?#]+)") or url
                        local ext = cleanUrl:match("%.(%w+)$")
                        if ext then
                            ext = ext:lower()
                            if ext == "jpg" or ext == "jpeg" or ext == "png" or ext == "webp" then
                                return "." .. ext
                            end
                        end
                        return ".png"
                    end

