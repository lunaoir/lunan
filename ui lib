                end
            end)
            connect(UserInputService.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            if flag then
                Library:_bindFlag(flag, currentValue, function(value) applyValue(value) end)
            end
            applyValue(default)

            return { Set = function(_, value) applyValue(value) end }
        end

