            dockSize = isMobile and 46 or 50,
            dockInset = isMobile and 12 or 16,
            titleTextSize = isMobile and 12 or 13,
            subtitleTextSize = 7,
        }
    end

    local layout = buildLayout()

    local function centeredRootPosition(offsetY)
        local baseYOffset = layout.isMobile and -6 or -10
        return UDim2.new(0.5, -math.floor(layout.width / 2), 0.5, -math.floor(layout.height / 2) + baseYOffset + (offsetY or 0))
    end

    local root = Instance.new("Frame")
    root.Name = "Root"
