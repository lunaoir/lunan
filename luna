			exampleBadge.BorderSizePixel = 0
			exampleBadge.Text = standName == "Any" and "Any" or "Select"
			exampleBadge.Font = Enum.Font.GothamSemibold
			exampleBadge.TextSize = 7
			exampleBadge.TextColor3 = Color3.fromRGB(211, 197, 244)
			exampleBadge.ZIndex = 33
			exampleBadge.Parent = option
			rounded(exampleBadge, 4)
			option.MouseButton1Click:Connect(function()
				if standName == "-- No matches --" then return end
				selectedStandForSlot = standName
				executiveUI.rememberStandSelection(standName)
				setFieldText(standField, standName)
				standSearch.Text = standName == "Any" and "" or standName
				pickerSearch.Text = ""
				standPicker.Visible = false
			end)
		end
	end
