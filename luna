						if d.ClassName == 'Humanoid' and d.Parent and d.Parent.Name ~= game.Players.LocalPlayer.Name then
							d.Health = 0
						end
					end
				end
			end)
		else
			resetAutoLairState()
			getgenv().G = false
		end
	end,
})

