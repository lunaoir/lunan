local function cleanText(value)
	return type(value) == "string" and value:match("^%s*(.-)%s*$") or ""
end

local function nameKey(value)
	return cleanText(value):lower()
end

local function isDiscordWebhookUrl(value)
	value = cleanText(value)
	return value:match("^https://discord%.com/api/webhooks/%d+/[%w_-]+$") ~= nil
		or value:match("^https://discordapp%.com/api/webhooks/%d+/[%w_-]+$") ~= nil
end

local function firstOption(options, default)
	local value = type(options) == "table" and options[1] or options
	value = cleanText(value)
	return value ~= "" and value or default
end

local function normalizeAttributes(values)
	if type(values) == "string" then values = {values} end
	local result, seen = {}, {}
	if type(values) == "table" then
		for _, value in ipairs(values) do
			value = cleanText(value)
			if value == "Any" then return {"Any"} end
			if value ~= "" and not seen[value] then
				seen[value] = true
				table.insert(result, value)
			end
		end
	end
	return #result > 0 and result or {"Any"}
end

local function rebuildStandOptions()
	local names, seen = {}, {any = true, none = true}
	local function add(name)
		local key = nameKey(name)
		if key ~= "" and not seen[key] then
			seen[key] = true
			table.insert(names, name)
		end
	end
	if catalogSource == "live" then
		for _, display in pairs(displayById) do add(display) end
	else
		for _, name in ipairs(fallbackStandNames) do add(name) end
	end
	table.sort(names, function(a, b)
		local ka, kb = nameKey(a), nameKey(b)
		return ka == kb and a < b or ka < kb
	end)
	standOptions = {"Any"}
	for _, name in ipairs(names) do table.insert(standOptions, name) end
end

local function scanStandCatalog(timeout)
	if catalogBusy then return false, "A scan is already running." end
	catalogBusy = true
	local ok, scanOk, detail = pcall(function()
		local deadline = os.clock() + (timeout or 5)
		local target
		repeat
			target = ReplicatedStorage:FindFirstChild("StandNameConvert", true)
			if target then break end
			task.wait(0.1)
		until os.clock() >= deadline
		if not target then return false, "StandNameConvert was not found." end
		local newMap, newReverse = {}, {}
		local function add(internal, display)
			internal, display = cleanText(internal), cleanText(display)
			if internal == "" or nameKey(internal) == "none" or nameKey(internal) == "any"
				or internal == "PackageLink" then return end
			if display == "" then display = internal end
			if nameKey(display) == "none" or nameKey(display) == "any" then return end
			newMap[internal] = display
		end
		if target:IsA("ModuleScript") then
			local done, required, data = false, false, nil
			local worker = task.spawn(function()
				required, data = pcall(require, target)
				done = true
			end)
			local moduleDeadline = os.clock() + 5
			while not done and os.clock() < moduleDeadline do task.wait(0.05) end
			if not done then
				pcall(task.cancel, worker)
				return false, "StandNameConvert module timed out."
			end
			if not required or type(data) ~= "table" then
				return false, "StandNameConvert did not return a readable table."
			end
			for internal, display in pairs(data) do
				if type(internal) == "string" and type(display) == "string" then
					add(internal, display)
				elseif type(internal) == "number" and type(display) == "string" then
					add(display, display)
				end
			end
		else
			-- Give replicated children a bounded opportunity to arrive.
			repeat
				for _, item in ipairs(target:GetChildren()) do
					if item.Name ~= "PackageLink" and not item:IsA("PackageLink") then
						if item:IsA("StringValue") then add(item.Name, item.Value)
						else add(item.Name, item.Name) end
					end
				end
				if next(newMap) then break end
				task.wait(0.1)
			until os.clock() >= deadline
		end
		if not next(newMap) then return false, "StandNameConvert has no usable stand names." end
		for internal, display in pairs(newMap) do
			local key = nameKey(display)
			newReverse[key] = newReverse[key] or {}
			table.insert(newReverse[key], internal)
		end
		displayById, idsByDisplay = newMap, newReverse
		catalogSource = "live"
		rebuildStandOptions()
		return true, tostring(#standOptions - 1) .. " stands loaded."
	end)
	catalogBusy = false
	if not ok then return false, tostring(scanOk) end
	return scanOk, detail
end

