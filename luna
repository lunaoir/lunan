local function orbAmount(item)
	local ok, amount = pcall(function() return item:GetAttribute("ItemAmount") end)
	return ok and type(amount) == "number" and amount or nil
end

local function checkOrbConsumption()
	if not orbState.pending then return end
	if orbPendingItem and localplr.Character == orbPendingCharacter then
		local hum = orbPendingCharacter and orbPendingCharacter:FindFirstChildOfClass("Humanoid")
		local currentAmount = orbAmount(orbPendingItem)
		local consumed = orbPendingItem.Parent == nil
			or (orbPendingAmount and currentAmount and currentAmount < orbPendingAmount)
		if hum and hum.Health > 0 and consumed then
			orbState.pending = false
			orbState.expiresAt = orbState.requestedAt + 1800
			orbPendingItem, orbPendingCharacter, orbPendingAmount = nil, nil, nil
			farmStats.orbs = (farmStats.orbs or 0) + 1
			orbMessage = "Use confirmed"
			saveOrbState()
			return
		end
	end
	-- Without confirmation do not consume another orb during the possible buff window.
	if os.time() - orbState.requestedAt >= 1800 then
		orbState.pending = false
		orbPendingItem, orbPendingCharacter, orbPendingAmount = nil, nil, nil
		orbMessage = "Previous unconfirmed-use window ended"
		saveOrbState()
	end
end

local function ensureOrb(running, stand, att)
	checkOrbConsumption()
	if not autoUseOrb or not running() or orbRemaining() > 0 or orbState.pending or os.clock() < orbNextTry then return end
	local item = findFarmItem("2x Orb")
	if not item then
		orbMessage = "No 2x Orb - farming without Orb"
		orbNextTry = os.clock() + 5
		return
	end
	local char = localplr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	local using = item:FindFirstChild("Using")
	if using and using.Value == true then
		orbMessage = "Orb already in use; waiting"
		orbNextTry = os.clock() + 2
		return
	end
	local remote = getUseItemRemote(item)
	if not remote then
		orbMessage = "UseItem unavailable - farming without Orb"
		orbNextTry = os.clock() + 30
		return
	end
	local fired = false
	local ok, err = pcall(function()
		hum:EquipTool(item)
		task.wait(0.1)
		local s, a = readStandData()
		if not running() or not autoUseOrb or localplr.Character ~= char or hum.Health <= 0
			or item.Parent ~= char or s ~= stand or a ~= att or #farmSlots == 0 then return end
		orbState = {pending = true, requestedAt = os.time(), expiresAt = 0}
		orbPendingItem, orbPendingCharacter, orbPendingAmount = item, char, orbAmount(item)
		saveOrbState()
		s, a = readStandData()
		if not running() or not autoUseOrb or localplr.Character ~= char or hum.Health <= 0
			or item.Parent ~= char or s ~= stand or a ~= att or #farmSlots == 0 then
			orbState.pending = false
			orbPendingItem, orbPendingCharacter, orbPendingAmount = nil, nil, nil
			saveOrbState()
			return
		end
		fired = true
		orbMessage = "Using 2x Orb..."
		remote:FireServer()
		local deadline = os.clock() + 10
		while running() and os.clock() < deadline do
			checkOrbConsumption()
			if not orbState.pending then return end
			task.wait(0.1)
		end
		orbMessage = "Use not confirmed - automatic reuse held"
	end)
	returnFarmItem(item)
	if not ok then
		orbMessage = "Orb error - farming continues"
		warn("Orb: " .. tostring(err))
		if not fired then
			orbState.pending = false
			orbPendingItem, orbPendingCharacter, orbPendingAmount = nil, nil, nil
			saveOrbState()
		end
	end
	orbNextTry = os.clock() + 30
end

local function orbStatusText()
	local remaining = math.ceil(orbRemaining())
	if remaining > 0 then
		return string.format("2x Orb: ACTIVE (estimated) %02d:%02d | Auto: %s",
			math.floor(remaining / 60), remaining % 60, autoUseOrb and "ON" or "OFF")
	end
	if orbState.pending then return "2x Orb: use unconfirmed; automatic reuse held" end
	if orbState.expiresAt > 0 then
		return "2x Orb: EXPIRED | Auto: " .. (autoUseOrb and "ON" or "OFF")
	end
	return "2x Orb: " .. orbMessage .. " | Auto: " .. (autoUseOrb and "ON" or "OFF")
end

