    local function buildSearchText(...)
        local parts = {}
        for index = 1, select("#", ...) do
            local value = select(index, ...)
            if type(value) == "table" then
                for _, nested in ipairs(value) do
                    table.insert(parts, tostring(nested))
                end
            elseif value ~= nil and value ~= "" then
                table.insert(parts, tostring(value))
            end
        end
        return string.lower(table.concat(parts, " "))
    end

    local function matchesSearchQuery(text, query)
        if query == nil or query == "" then
            return true
        end
        return string.find(text or "", query, 1, true) ~= nil
    end

    local function setActiveTab(tabName)
        activeTabName = tabName
        for name, dat in pairs(Pages) do
            local isActive = name == tabName and dat.Btn.Visible ~= false
            dat.Page.Visible = isActive
            if isActive then
                tween(dat.Btn, {BackgroundColor3 = Library.COLORS.navHover, BackgroundTransparency = 0.04}, 0.2)
                tween(dat.Label, {TextColor3 = Library.COLORS.text}, 0.2)
                tween(dat.Icon, {ImageColor3 = Color3.fromRGB(245, 226, 255)}, 0.2)
                tween(dat.IconTile, {BackgroundColor3 = Color3.fromRGB(91, 45, 163), BackgroundTransparency = 0.08}, 0.2)
                tween(dat.IconStroke, {Color = Library.COLORS.accent2, Transparency = 0.12}, 0.2)
                tween(dat.Marker, {BackgroundTransparency = 0}, 0.2)
                tween(dat.Label, {Position = UDim2.new(0, 36, 0, 0)}, 0.2)
            else
                tween(dat.Btn, {BackgroundColor3 = Library.COLORS.panel, BackgroundTransparency = 1}, 0.2)
                tween(dat.Label, {TextColor3 = Library.COLORS.muted}, 0.2)
                tween(dat.Icon, {ImageColor3 = Color3.fromRGB(164, 120, 230)}, 0.2)
                tween(dat.IconTile, {BackgroundColor3 = Color3.fromRGB(37, 27, 70), BackgroundTransparency = 0.34}, 0.2)
                tween(dat.IconStroke, {Color = Color3.fromRGB(104, 64, 168), Transparency = 0.38}, 0.2)
                tween(dat.Marker, {BackgroundTransparency = 1}, 0.2)
                tween(dat.Label, {Position = UDim2.new(0, 34, 0, 0)}, 0.2)
            end
        end
