            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.TextTruncate = Enum.TextTruncate.AtEnd
            lbl.Parent = row
            
            local valLbl = Instance.new("TextLabel")
            valLbl.Size = UDim2.new(0, 54, 0, 14)
            valLbl.Position = UDim2.new(1, -56, 0, 6)
            valLbl.BackgroundTransparency = 1
            valLbl.Text = tostring(default)
            valLbl.Font = Enum.Font.GothamBold
            valLbl.TextSize = 11
            valLbl.TextColor3 = Library.COLORS.accent1
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.Parent = row
            
            local track = Instance.new("Frame")
            track.Size = UDim2.new(0.58, -20, 0, 5)
            track.Position = UDim2.new(0.36, 0, 0.5, 2)
            track.BackgroundColor3 = Library.COLORS.navHover
            track.Parent = row
            corner(3).Parent = track
            
            local fill = Instance.new("Frame")
            local startPct = math.clamp((default - min)/(max - min), 0, 1)
            fill.Size = UDim2.new(startPct, 0, 1, 0)
            fill.BackgroundColor3 = Library.COLORS.accent1
            fill.Parent = track
            corner(3).Parent = fill
            
            local dragBtn = Instance.new("TextButton")
            dragBtn.Size = UDim2.new(1, 0, 1, 14)
            dragBtn.Position = UDim2.new(0, 0, 0, -5)
            dragBtn.BackgroundTransparency = 1
            dragBtn.Text = ""
            dragBtn.Parent = track
            
            local dragging = false
            local currentValue = default

            local function normalizeValue(value)
                value = math.clamp(tonumber(value) or min, min, max)
                local stepped = min + math.floor(((value - min) / increment) + 0.5) * increment
                return math.clamp(stepped, min, max)
            end

            local function applyValue(value, fromLoad)
                currentValue = normalizeValue(value)
                local percent = max == min and 0 or ((currentValue - min) / (max - min))
                tween(fill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.1)
                valLbl.Text = tostring(currentValue) .. suffix
                if flag then
                    Library._compat.flags[flag] = currentValue
                end
                pcall(callback, currentValue)
            end

            local function updateSlider(input)
                local posX = math.clamp(input.Position.X - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
                local percent = posX / track.AbsoluteSize.X
                local value = min + ((max - min) * percent)
                applyValue(value, false)
            end
            
            dragBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(input)
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            
            if flag then
                Library:_bindFlag(flag, currentValue, function(value)
                    applyValue(value, true)
                end)
            end

            applyValue(default, true)

            row.MouseEnter:Connect(function() tween(rStroke, {Color = Library.COLORS.muted}, 0.2) end)
            row.MouseLeave:Connect(function() tween(rStroke, {Color = Library.COLORS.navHover}, 0.2) end)

            return {
                Set = function(_, value)
                    applyValue(value, true)
                end
            }
        end

