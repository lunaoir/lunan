-- LUNA · Moonlit edition. Home cards, animated controls, original farm callbacks.
-- LUNA UI: local, asset-free Roblox interface compatible with the hub's controls.
local LunaUI = {Options = {}, Tabs = {}, Theme = "Luna", ReducedMotion = false, Connections = {}, Loops = {}, Version = "1.0.1"}
do
    local Tween = game:GetService("TweenService")
    local Input = game:GetService("UserInputService")
    local Players = game:GetService("Players")
    local C = {
        Night = Color3.fromRGB(10, 13, 25), Panel = Color3.fromRGB(17, 21, 39),
        Card = Color3.fromRGB(24, 29, 50), Hover = Color3.fromRGB(34, 40, 67),
        Line = Color3.fromRGB(62, 68, 100), Text = Color3.fromRGB(240, 240, 255),
        Muted = Color3.fromRGB(150, 160, 190), Lavender = Color3.fromRGB(182, 161, 255),
        Blue = Color3.fromRGB(132, 204, 236), Mint = Color3.fromRGB(145, 219, 197),
    }
    LunaUI.Palette = C
    local serial = 0
    local function create(class, props, parent)
        local node = Instance.new(class)
        for k, v in pairs(props or {}) do node[k] = v end
        node.Parent = parent
        return node
    end
    local function corner(node, radius) create("UICorner", {CornerRadius = UDim.new(0, radius or 12)}, node) end
    local function line(node, color, transparency)
        return create("UIStroke", {Color = color or C.Line, Transparency = transparency or 0.4, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, node)
    end
    local function frame(parent, props)
        props = props or {}; props.BorderSizePixel = 0
        if props.BackgroundColor3 == nil then props.BackgroundColor3 = C.Card end
        return create("Frame", props, parent)
    end
    local function text(parent, value, size, color, props)
        props = props or {}; props.Text = value; props.TextSize = size or 14
        props.TextColor3 = color or C.Text; props.BackgroundTransparency = 1
        props.Font = props.Font or Enum.Font.Gotham
        props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
        props.BorderSizePixel = 0
        return create("TextLabel", props, parent)
    end
    local function connect(signal, fn)
        local connection = signal:Connect(fn)
        table.insert(LunaUI.Connections, connection)
        return connection
    end
    local function animate(node, props, duration)
        if LunaUI.ReducedMotion then for k,v in pairs(props) do node[k] = v end; return end
        local tween = Tween:Create(node, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
        tween:Play(); return tween
    end
    local function pulse(node, duration, props)
        local tween = Tween:Create(node, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), props)
        table.insert(LunaUI.Loops, tween)
        if not LunaUI.ReducedMotion then tween:Play() end
    end
    local function button(parent, title, props, action, hoverEffects)
        props = props or {}; props.Text = title or ""; props.AutoButtonColor = false
        props.Font = Enum.Font.GothamMedium; props.TextSize = props.TextSize or 13
        props.TextColor3 = props.TextColor3 or C.Text; props.BorderSizePixel = 0
        props.BackgroundColor3 = props.BackgroundColor3 or C.Card
        local node = create("TextButton", props, parent); corner(node, 10)
        local base = node.BackgroundColor3
        if hoverEffects ~= false then
            connect(node.MouseEnter, function() animate(node, {BackgroundColor3 = C.Hover}, 0.16) end)
            connect(node.MouseLeave, function() animate(node, {BackgroundColor3 = base}, 0.2) end)
        end
        if action then connect(node.Activated, action) end
        local scale = create("UIScale", {Scale = 1}, node)
        connect(node.MouseButton1Down, function() animate(scale, {Scale = 0.965}, 0.1) end)
        connect(node.MouseButton1Up, function() animate(scale, {Scale = 1}, 0.2) end)
        connect(node.MouseLeave, function() animate(scale, {Scale = 1}, 0.2) end)
        return node
    end
    local function moon(parent, size, position, background)
        local disc = frame(parent, {Name = "Moon", Size = UDim2.fromOffset(size, size), Position = position, BackgroundColor3 = C.Lavender, ClipsDescendants = true})
        corner(disc, size)
        local cut = frame(disc, {Size = UDim2.fromScale(0.88, 0.88), Position = UDim2.fromScale(0.31, -0.05), BackgroundColor3 = background or C.Panel})
        corner(cut, size)
        return disc
    end
    local function scroll(parent, props)
        props = props or {}; props.BackgroundTransparency = 1; props.BorderSizePixel = 0
        props.ScrollBarThickness = 3; props.ScrollBarImageColor3 = C.Lavender
        props.CanvasSize = UDim2.fromOffset(0, 0); props.AutomaticCanvasSize = Enum.AutomaticSize.Y
        props.ScrollingDirection = Enum.ScrollingDirection.Y
        return create("ScrollingFrame", props, parent)
    end
    local function list(parent, padding)
        return create("UIListLayout", {Padding = UDim.new(0, padding or 10), SortOrder = Enum.SortOrder.LayoutOrder}, parent)
    end
    function LunaUI:SafeCallback(callback, ...)
        if not callback then return end
        local args = table.pack(...)
        local ok, message = pcall(function() callback(table.unpack(args, 1, args.n)) end)
        if not ok then
            warn("[LUNA] " .. tostring(message))
            self:Notify({Title = "Action unavailable", Content = tostring(message), Duration = 5})
        end
    end
    function LunaUI:SetReducedMotion(value)
        self.ReducedMotion = not not value
        for _, tween in ipairs(self.Loops) do if self.ReducedMotion then tween:Pause() else tween:Play() end end
    end
    function LunaUI:Notify(config)
        if not self.Toasts or not self.Toasts.Parent then return end
        local toast = create("CanvasGroup", {Name = "Notification", Size = UDim2.fromOffset(310, 86), BackgroundColor3 = C.Card, BorderSizePixel = 0, GroupTransparency = 1}, self.Toasts)
        corner(toast, 14); line(toast, C.Lavender, 0.55)
        frame(toast, {Size = UDim2.new(0, 3, 1, -28), Position = UDim2.fromOffset(0, 14), BackgroundColor3 = C.Lavender})
        text(toast, config.Title or "LUNA", 13, C.Text, {Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -28, 0, 20), Font = Enum.Font.GothamBold})
        text(toast, config.Content or "", 11, C.Muted, {Position = UDim2.fromOffset(16, 34), Size = UDim2.new(1, -28, 0, 40), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top})
        animate(toast, {GroupTransparency = 0}, 0.25)
        task.delay(config.Duration or 4, function()
            if not toast.Parent then return end
            animate(toast, {GroupTransparency = 1}, 0.2)
            task.delay(0.25, function() if toast.Parent then toast:Destroy() end end)
        end)
    end
    local descriptions = {
        ["Farming & Quests"] = "Your next chapter", ["Auto Farm"] = "Progress, on autopilot",
        ["Boss Farm"] = "Challenge the powerful", ["Stand Farm"] = "Find your perfect stand",
        ["Shop"] = "Supplies for the journey", ["Dungeon Farm"] = "Beyond the moonlit gate",
        ["Items Farm"] = "Collect what matters", ["Settings"] = "Make this space yours",
    }
    local glyphs = {["Farming & Quests"] = "\226\151\135", ["Auto Farm"] = "\226\134\151", ["Boss Farm"] = "\226\156\167", ["Stand Farm"] = "\226\156\166", ["Shop"] = "\226\150\177", ["Dungeon Farm"] = "\226\152\190", ["Items Farm"] = "\226\172\161", ["Settings"] = "\226\151\140"}

    function LunaUI:CreateWindow(config)
        if self.Window then return self.Window end
        local gui = create("ScreenGui", {Name = "LunaHub", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 80, ZIndexBehavior = Enum.ZIndexBehavior.Sibling})
        local parented = pcall(function() gui.Parent = game:GetService("CoreGui") end)
        if not parented then gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end
        self.GUI = gui
        local holder = frame(gui, {Name = "WindowPosition", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(700, 580), BackgroundTransparency = 1})
        local fit = create("UIScale", {Scale = 1}, holder)
        local panel = create("CanvasGroup", {Name = "LunaWindow", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Panel, BorderSizePixel = 0, GroupColor3 = Color3.fromRGB(255, 255, 255), GroupTransparency = 1}, holder)
        corner(panel, 20); line(panel, C.Lavender, 0.62)
        local appear = create("UIScale", {Scale = 0.96}, panel)
        -- A gradient on CanvasGroup tints its entire flattened texture, including text.
        -- Keep it on a white background Frame so only the background receives color.
        local surface = frame(panel, {Name = "LunaBackground", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(255, 255, 255), ZIndex = 0})
        corner(surface, 20)
        create("UIGradient", {Color = ColorSequence.new(C.Panel, C.Night), Rotation = 90}, surface)
        local win = {Root = panel, Holder = holder, Tabs = self.Tabs, Minimized = false, HomeVisible = true, Sequence = 0}
        self.Window = win
        local camera = workspace.CurrentCamera
        local function resize()
            local size = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
            fit.Scale = math.clamp(math.min((size.X - 24) / 700, (size.Y - 32) / 580), 0.3, 1)
        end
        resize(); if camera then connect(camera:GetPropertyChangedSignal("ViewportSize"), resize) end
        local top = frame(panel, {Name = "TopBar", Size = UDim2.new(1, 0, 0, 62), BackgroundTransparency = 1})
        moon(top, 25, UDim2.fromOffset(24, 18), C.Panel)
        text(top, "L U N A", 15, C.Text, {Position = UDim2.fromOffset(63, 13), Size = UDim2.fromOffset(140, 22), Font = Enum.Font.GothamBold})
        text(top, "STAND UPRIGHT", 8, C.Muted, {Position = UDim2.fromOffset(64, 36), Size = UDim2.fromOffset(150, 12)})
        local search = create("TextBox", {Name = "Search", Size = UDim2.fromOffset(200, 32), Position = UDim2.new(1, -308, 0, 15), BackgroundColor3 = C.Card, Text = "", PlaceholderText = "Search your orbit...", PlaceholderColor3 = C.Muted, TextColor3 = C.Text, TextSize = 11, Font = Enum.Font.Gotham, ClearTextOnFocus = false, BorderSizePixel = 0}, top)
        corner(search, 10); line(search, C.Line, 0.6)
        frame(panel, {Position = UDim2.fromOffset(24, 62), Size = UDim2.new(1, -48, 0, 1), BackgroundColor3 = C.Line, BackgroundTransparency = 0.65})
        local home = frame(panel, {Name = "Home", Position = UDim2.fromOffset(24, 78), Size = UDim2.new(1, -48, 1, -126), BackgroundTransparency = 1})
        local hero = frame(home, {Name = "LunarBanner", Size = UDim2.new(1, 0, 0, 126), BackgroundColor3 = Color3.fromRGB(255, 255, 255), ClipsDescendants = true})
        corner(hero, 16); line(hero, C.Lavender, 0.75)
        create("UIGradient", {Color = ColorSequence.new(Color3.fromRGB(37, 33, 65), Color3.fromRGB(20, 31, 48)), Rotation = 20}, hero)
        text(hero, "YOUR WORLD, IN A NEW LIGHT", 9, C.Lavender, {Position = UDim2.fromOffset(22, 18), Size = UDim2.fromOffset(370, 16), Font = Enum.Font.GothamMedium})
        text(hero, "Welcome to Luna.", 27, C.Text, {Position = UDim2.fromOffset(20, 41), Size = UDim2.fromOffset(400, 34), Font = Enum.Font.GothamBold})
        text(hero, "Find your rhythm. Explore your universe.", 11, C.Muted, {Position = UDim2.fromOffset(22, 83), Size = UDim2.fromOffset(370, 21)})
        local orbit = frame(hero, {Size = UDim2.fromOffset(156, 156), Position = UDim2.new(1, -187, 0, -16), BackgroundTransparency = 1, Rotation = -22})
        corner(orbit, 100); line(orbit, C.Lavender, 0.8)
        local orb = moon(hero, 68, UDim2.new(1, -139, 0, 28), Color3.fromRGB(24, 30, 51))
        pulse(orb, 3.4, {Position = UDim2.new(1, -139, 0, 21)})
        for i = 1, 14 do
            local star = text(hero, i % 4 == 0 and "\226\156\166" or "\194\183", i % 4 == 0 and 13 or 18, i % 2 == 0 and C.Blue or C.Lavender, {Position = UDim2.new(0.61 + ((i * 17) % 35) / 100, 0, 0.08 + ((i * 13) % 78) / 100, 0), Size = UDim2.fromOffset(16, 18), TextTransparency = 0.2})
            pulse(star, 1.6 + (i % 4) * 0.7, {TextTransparency = 0.85})
        end
        text(home, "EXPLORE YOUR ORBIT", 9, C.Muted, {Position = UDim2.fromOffset(2, 145), Size = UDim2.fromOffset(280, 14), Font = Enum.Font.GothamMedium})
        local grid = scroll(home, {Name = "CategoryGrid", Position = UDim2.fromOffset(0, 174), Size = UDim2.new(1, 0, 1, -174)})
        create("UIGridLayout", {CellSize = UDim2.new(0.5, -8, 0, 58), CellPadding = UDim2.fromOffset(12, 10), SortOrder = Enum.SortOrder.LayoutOrder}, grid)
        local pageHost = frame(panel, {Name = "Pages", Position = UDim2.fromOffset(24, 78), Size = UDim2.new(1, -48, 1, -126), BackgroundTransparency = 1, Visible = false})
        local back = button(pageHost, "\226\128\185", {Name = "Back", Size = UDim2.fromOffset(34, 34), TextSize = 24}, function() win:ShowHome() end)
        local heading = text(pageHost, "", 22, C.Text, {Position = UDim2.fromOffset(49, -2), Size = UDim2.new(1, -80, 0, 31), Font = Enum.Font.GothamBold})
        local subheading = text(pageHost, "", 10, C.Muted, {Position = UDim2.fromOffset(50, 29), Size = UDim2.new(1, -80, 0, 18)})
        local footer = frame(panel, {Position = UDim2.new(0, 24, 1, -35), Size = UDim2.new(1, -48, 0, 22), BackgroundTransparency = 1})
        text(footer, "\226\151\143", 9, C.Mint, {Size = UDim2.fromOffset(18, 22)})
        local status = text(footer, "ALL SYSTEMS READY", 9, C.Muted, {Position = UDim2.fromOffset(17, 0), Size = UDim2.fromOffset(320, 22)})
        text(footer, "RCTRL  /  SHOW & HIDE", 9, C.Muted, {AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(165, 22), TextXAlignment = Enum.TextXAlignment.Right})
        function self:UpdateStatus()
            local count = 0; for _, option in pairs(self.Options) do if option.Type == "Toggle" and option.Value and not option.InterfaceOnly then count = count + 1 end end
            status.Text = count > 0 and (tostring(count) .. " ACTIVE CONTROLS") or "ALL SYSTEMS READY"
        end
        function win:ShowHome()
            self.HomeVisible = true; self.ActiveTab = nil
            for _, tab in ipairs(self.Tabs) do tab.Container.Visible = false end
            pageHost.Visible = false; home.Visible = true; search.Text = ""
            home.Position = UDim2.fromOffset(24, 86); animate(home, {Position = UDim2.fromOffset(24, 78)}, 0.25)
        end
        function win:SelectTab(index)
            local tab = type(index) == "number" and self.Tabs[index] or index
            if not tab then return self:ShowHome() end
            self.HomeVisible = false; self.ActiveTab = tab
            home.Visible = false; pageHost.Visible = true; search.Text = ""
            heading.Text = tab.Title; subheading.Text = descriptions[tab.Title] or "A little closer to your next adventure."
            for _, other in ipairs(self.Tabs) do other.Container.Visible = other == tab end
            tab.Container.CanvasPosition = Vector2.new(0, 0)
            pageHost.Position = UDim2.fromOffset(34, 78); animate(pageHost, {Position = UDim2.fromOffset(24, 78)}, 0.22)
        end
        function win:Minimize(value)
            LunaUI:CloseDropdown()
            if value == nil then self.Minimized = not self.Minimized else self.Minimized = not not value end
            self.Sequence = self.Sequence + 1; local sequence = self.Sequence
            if self.Minimized then
                animate(panel, {GroupTransparency = 1}, 0.2); animate(appear, {Scale = 0.96}, 0.2)
                task.delay(0.22, function() if self.Sequence == sequence then holder.Visible = false end end)
            else
                holder.Visible = true; animate(panel, {GroupTransparency = 0}, 0.25); animate(appear, {Scale = 1}, 0.3)
            end
        end
        button(top, "\226\128\148", {Name = "Minimize", Position = UDim2.new(1, -92, 0, 15), Size = UDim2.fromOffset(32, 32)}, function() win:Minimize(true) end)
        button(top, "\195\151", {Name = "Hide", Position = UDim2.new(1, -51, 0, 15), Size = UDim2.fromOffset(32, 32), TextSize = 20}, function() win:Minimize(true) end)
        local dock = button(gui, "", {Name = "LunaDock", Position = UDim2.new(0, 22, 0.5, -24), Size = UDim2.fromOffset(48, 48)}, function() win:Minimize(not win.Minimized) end)
        corner(dock, 24); line(dock, C.Lavender, 0.35); moon(dock, 23, UDim2.fromOffset(12, 12), C.Card)
        local dragging, startInput, startPosition, dragObject
        connect(top.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; startInput = input.Position; startPosition = holder.Position; dragObject = input
            end
        end)
        connect(Input.InputChanged, function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input == dragObject) then
                local delta = input.Position - startInput
                holder.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
            end
        end)
        connect(Input.InputEnded, function(input) if input == dragObject or input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
        connect(Input.InputBegan, function(input, processed)
            if not processed and input.KeyCode == Enum.KeyCode.RightControl then win:Minimize(not win.Minimized) end
            if not processed and input.KeyCode == Enum.KeyCode.Escape then self:CloseDropdown() end
        end)
        connect(search:GetPropertyChangedSignal("Text"), function()
            local query = string.lower(search.Text)
            for _, tab in ipairs(self.Tabs) do
                tab.Card.Visible = string.find(string.lower(tab.Title .. " " .. (descriptions[tab.Title] or "")), query, 1, true) ~= nil
                for _, row in ipairs(tab.Rows) do row.Frame.Visible = string.find(string.lower(row.Search), query, 1, true) ~= nil end
            end
        end)
        self.Toasts = frame(gui, {Name = "Notifications", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20), Size = UDim2.fromOffset(310, 400), BackgroundTransparency = 1})
        create("UIListLayout", {Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom}, self.Toasts)
        win.Grid = grid; win.PageHost = pageHost
        animate(panel, {GroupTransparency = 0}, 0.35); animate(appear, {Scale = 1}, 0.4)
        return win
    end

    function LunaUI:CloseDropdown()
        if self.DropdownOverlay then self.DropdownOverlay:Destroy(); self.DropdownOverlay = nil end
        if self.DropdownConnections then for _, c in ipairs(self.DropdownConnections) do c:Disconnect() end end
        self.DropdownConnections = nil
    end
    local function fireOption(option)
        LunaUI:SafeCallback(option.Callback, option.Value)
        LunaUI:SafeCallback(option.Changed, option.Value)
        LunaUI:UpdateStatus()
    end
    local function optionBase(tab, id, config, kind, height)
        serial = serial + 1
        local row = frame(tab.Container, {Name = id or ("Action" .. serial), Size = UDim2.new(1, -5, 0, height or 65), LayoutOrder = serial})
        corner(row, 12); line(row, C.Line, 0.6)
        local label = text(row, config.Title or "", 13, C.Text, {Position = UDim2.fromOffset(16, config.Description and 12 or 21), Size = UDim2.new(0.58, -16, 0, 22), Font = Enum.Font.GothamMedium, TextTruncate = Enum.TextTruncate.AtEnd})
        local desc = text(row, config.Description or "", 10, C.Muted, {Position = UDim2.fromOffset(16, 35), Size = UDim2.new(0.58, -16, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd})
        local option = {Type = kind, Frame = row, Callback = config.Callback, Search = (config.Title or "") .. " " .. (config.Description or ""), ID = id}
        function option:OnChanged(fn) self.Changed = fn; LunaUI:SafeCallback(fn, self.Value); return self end
        function option:SetTitle(value) label.Text = value; self.Search = value end
        function option:SetDesc(value) desc.Text = value end
        function option:Destroy() row:Destroy(); if id then LunaUI.Options[id] = nil end end
        table.insert(tab.Rows, option)
        if id then LunaUI.Options[id] = option end
        return option
    end
    local Tab = {}
    function Tab:AddButton(config)
        local option = optionBase(self, nil, config, "Button")
        local action = button(option.Frame, "OPEN  \226\134\151", {Name = "Action", Position = UDim2.new(1, -113, 0.5, -16), Size = UDim2.fromOffset(96, 32), TextColor3 = C.Lavender}, function() LunaUI:SafeCallback(config.Callback) end)
        line(action, C.Lavender, 0.72)
        return option
    end
    function Tab:AddToggle(id, config)
        local option = optionBase(self, id, config, "Toggle")
        option.Value = not not config.Default
        local hit = button(option.Frame, "", {Name = "Switch", Position = UDim2.new(1, -66, 0.5, -13), Size = UDim2.fromOffset(48, 26)}, nil, false)
        corner(hit, 20); line(hit, C.Line, 0.2)
        local knob = frame(hit, {Name = "Knob", Position = UDim2.fromOffset(4, 4), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = C.Muted}); corner(knob, 20)
        local function draw()
            animate(hit, {BackgroundColor3 = option.Value and C.Lavender or C.Card}, 0.18)
            animate(knob, {Position = UDim2.fromOffset(option.Value and 26 or 4, 4), BackgroundColor3 = option.Value and C.Night or C.Muted}, 0.22)
        end
        function option:SetValue(value)
            value = not not value
            if self.Value == value then draw(); return end
            self.Value = value; draw(); fireOption(self)
        end
        connect(hit.Activated, function() option:SetValue(not option.Value) end)
        draw(); LunaUI:SafeCallback(option.Callback, option.Value)
        return option
    end
    function Tab:AddDropdown(id, config)
        local option = optionBase(self, id, config, "Dropdown")
        option.Values = config.Values or {}; option.Multi = not not config.Multi; option.Value = option.Multi and {} or nil
        local default = config.Default
        if option.Multi then
            if type(default) == "table" then for _, value in pairs(default) do if table.find(option.Values, value) then option.Value[value] = true end end end
        else option.Value = type(default) == "number" and option.Values[default] or (table.find(option.Values, default) and default or nil) end
        local display = button(option.Frame, "", {Name = "Dropdown", Position = UDim2.new(0.58, 0, 0.5, -17), Size = UDim2.new(0.42, -16, 0, 34), TextColor3 = C.Lavender})
        local valueLabel = text(display, "", 11, C.Lavender, {Position = UDim2.fromOffset(11, 0), Size = UDim2.new(1, -34, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd})
        text(display, "\226\140\132", 16, C.Muted, {Position = UDim2.new(1, -24, 0, 0), Size = UDim2.fromOffset(20, 34)})
        local function redraw()
            if option.Multi then local selected = {}; for _, value in ipairs(option.Values) do if option.Value[value] then table.insert(selected, tostring(value)) end end; valueLabel.Text = #selected == 0 and "Select..." or table.concat(selected, ", ")
            else valueLabel.Text = option.Value and tostring(option.Value) or "Select..." end
        end
        function option:SetValue(value)
            if self.Multi then
                local result = {}; if type(value) == "table" then for key, yes in pairs(value) do if yes and table.find(self.Values, key) then result[key] = true end end end
                self.Value = result
            elseif value == nil or table.find(self.Values, value) then self.Value = value else return end
            redraw(); fireOption(self)
        end
        function option:SetValues(values) if values then self.Values = values end; redraw(); LunaUI:CloseDropdown() end
        function option:Open()
            LunaUI:CloseDropdown()
            local overlay = frame(LunaUI.Window.Root, {Name = "DropdownOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Night, BackgroundTransparency = 0.3, ZIndex = 80, Active = true})
            LunaUI.DropdownOverlay = overlay; LunaUI.DropdownConnections = {}
            local function modalConnect(signal, callback) local c = signal:Connect(callback); table.insert(LunaUI.DropdownConnections, c); return c end
            local sheet = frame(overlay, {Name = "DropdownSheet", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(440, 392), BackgroundColor3 = C.Panel}); corner(sheet, 16); line(sheet, C.Lavender, 0.5)
            text(sheet, config.Title, 17, C.Text, {Position = UDim2.fromOffset(20, 16), Size = UDim2.fromOffset(350, 25), Font = Enum.Font.GothamBold})
