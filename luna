local function setHitboxVisible(part, enabled)
	if not part or not part:IsA("BasePart") then
		return
	end
	if enabled then
		if shownHitboxes[part] == nil then
			shownHitboxes[part] = part.Transparency
		end
		part.Transparency = 0.5
	else
		local original = shownHitboxes[part]
		if original ~= nil then
			part.Transparency = original
			shownHitboxes[part] = nil
		end
	end
end

local function applyHitboxVisibility(enabled)
	local hitboxes = game.Workspace:FindFirstChild("Hitboxes")
	if not hitboxes then
		return
	end
	for _, child in ipairs(hitboxes:GetChildren()) do
		setHitboxVisible(child, enabled)
	end
end

