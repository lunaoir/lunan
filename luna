				local x = 64
				local attributes = normalizeAttributes(slot.att)
				if #attributes == 1 and attributes[1] == "Any" then
					x = x + makeBadge(row, "Any", x, Color3.fromRGB(73, 48, 125))
				else
					for a = 1, math.min(3, #attributes) do
