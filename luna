local function updateExecutiveDashboard()
	local stand, att = readStandData()
	if executiveUI.dashboardFarmSection then
		executiveUI.dashboardFarmSection:Set("Stand Farm  •  " .. (getgenv().farmstands and "RUNNING" or "OFF"))
	end
	if executiveUI.dashboardLairSection then
		local phase = autolairToggle and "RUNNING" or "OFF"
		executiveUI.dashboardLairSection:Set("Auto Lair  •  " .. phase)
	end
	if executiveUI.dashboardCurrentSection then
		executiveUI.dashboardCurrentSection:Set("Current  •  " .. getDisplayName(stand or "None") .. "  /  " .. tostring(att or "None"))
	end
	if executiveUI.dashboardTargetSection then
		executiveUI.dashboardTargetSection:Set("Targets  •  " .. #farmSlots .. " configured")
	end
	if executiveUI.dashboardOrbSection then
		executiveUI.dashboardOrbSection:Set(orbStatusText())
	end
end

task.wait(0.5)
refreshUI()
updateFarmExtrasUI()
updateExecutiveDashboard()
local extrasElapsed = 0
local extrasConnection
extrasConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
	if getgenv().SURFarmSession ~= hubSession then extrasConnection:Disconnect(); return end
	extrasElapsed = extrasElapsed + dt
	if extrasElapsed >= 1 then
		extrasElapsed = 0
		local ok, err = pcall(updateFarmExtrasUI)
		if not ok then warn("Storage/Orb display: " .. tostring(err)) end
		local dashboardOk, dashboardErr = pcall(updateExecutiveDashboard)
		if not dashboardOk then warn("Dashboard display: " .. tostring(dashboardErr)) end
	end
end)

