local function isNPC(char)

    if not char or char == character then return false end

    local playerFromChar = game.Players:GetPlayerFromCharacter(char)

    return playerFromChar == nil and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart")

end

local function killNPC(npc)

    local humanoid = npc:FindFirstChild("Humanoid")

    if humanoid and humanoid.Health > 0 then

        pcall(function()

            humanoid.Health = 0

        end)

        pcall(function()

            humanoid:TakeDamage(humanoid.MaxHealth)

        end)

        pcall(function()

            humanoid:ChangeState(Enum.HumanoidStateType.Dead)

        end)

        killCount = killCount + 1

        updateStats()

    end

end

