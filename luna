		setFieldText(attributeField, display)
		if executiveUI.dashboardAttrField then
			executiveUI.dashboardAttrField.Text = "  " .. display
		end
	end

	local function renderAttributePicker()
		for _, child in ipairs(attributeList:GetChildren()) do
			if child:IsA("GuiObject") then child:Destroy() end
		end
		local selected = {}
		for _, value in ipairs(normalizeAttributes(selectedAttsForSlot)) do
			selected[value] = true
		end
		for index, attributeName in ipairs(allAttributes) do
			local active = selected[attributeName] == true
			local option = Instance.new("TextButton")
			option.Size = UDim2.new(1, 0, 0, 27)
			option.LayoutOrder = index
			option.BackgroundColor3 = active and Color3.fromRGB(51, 37, 91) or Color3.fromRGB(20, 23, 45)
			option.BorderSizePixel = 0
			option.AutoButtonColor = false
			option.Text = ""
			option.ZIndex = 42
