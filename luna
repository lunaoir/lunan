            local on = initial
            local knobOuter = Instance.new("Frame")
            knobOuter.Size = UDim2.fromOffset(36, 20)
            knobOuter.Position = UDim2.new(1, -44, 0.5, -10)
            knobOuter.BackgroundColor3 = on and Library.COLORS.accent1 or Library.COLORS.navHover
            knobOuter.Parent = row
            corner(9).Parent = knobOuter

            local knobInner = Instance.new("Frame")
            knobInner.Size = UDim2.fromOffset(14, 14)
            knobInner.Position = UDim2.new(0, on and 19 or 3, 0.5, -7)
            knobInner.BackgroundColor3 = Library.COLORS.text
            knobInner.Parent = knobOuter
            corner(6).Parent = knobInner

            local shade = Instance.new("UIStroke", knobOuter)
            shade.Color = Library.COLORS.glow
            shade.Transparency = on and 0.45 or 1
            shade.Thickness = 1

            row.MouseEnter:Connect(function() 
                tween(rStroke, {Color = Library.COLORS.muted}, 0.2) 
            end)
            row.MouseLeave:Connect(function() 
                tween(rStroke, {Color = Library.COLORS.navHover}, 0.2) 
            end)

            local function applyToggle(nextValue, fromLoad)
                on = nextValue == true
                createRipple(row, Mouse.X, Mouse.Y) 
                if on then
                    tween(knobOuter, {BackgroundColor3 = Library.COLORS.accent1}, 0.25)
                    tween(knobInner, {Position = UDim2.new(0, 19, 0.5, -7)}, 0.25, Enum.EasingStyle.Back)
                    tween(shade, {Transparency = 0.45}, 0.25)
                else
                    tween(knobOuter, {BackgroundColor3 = Library.COLORS.navHover}, 0.25)
                    tween(knobInner, {Position = UDim2.new(0, 3, 0.5, -7)}, 0.25, Enum.EasingStyle.Quart)
                    tween(shade, {Transparency = 1}, 0.25)
                end

                tween(knobInner, {Size = UDim2.fromOffset(16, 14)}, 0.1).Completed:Connect(function()
                    tween(knobInner, {Size = UDim2.fromOffset(14, 14)}, 0.15)
                end)

                if flag then
                    Library._compat.flags[flag] = on
                end
                if not fromLoad then
                    pcall(callback, on)
                else
                    pcall(callback, on)
                end
            end

            if flag then
                Library:_bindFlag(flag, on, function(value)
                    applyToggle(value, true)
                end)
            end

            row.MouseButton1Click:Connect(function()
                applyToggle(not on, false)
            end)

            if on then
                pcall(callback, on)
            end

            return {
                Set = function(_, value)
                    applyToggle(value, true)
                end
            }
        end

