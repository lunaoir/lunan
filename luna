function webhook(text, stand, color, attValue, isSlotMatch)
	if webhookurl == "" then return false, "Webhook URL is empty." end
	if not requestFunction then
		warn("Webhook disabled: no supported HTTP request function was found.")
		return false, "HTTP request function unavailable."
	end

	local function getItemAmount(item)
		if not item then return 0 end
		local attrAmount = item:GetAttribute("ItemAmount")
		if type(attrAmount) == "number" then
			return math.floor(attrAmount)
		end
		return 1
	end

	local function countItemByName(itemName)
		local total = 0
		local function scan(parent)
			if not parent then return end
			for _, item in ipairs(parent:GetChildren()) do
				if item.Name == itemName then
					total = total + getItemAmount(item)
				end
			end
		end
		scan(localplr:FindFirstChild("Backpack"))
		scan(localplr.Character)
		return total
	end

	text = tostring(text)
	local displayStand = stand and getDisplayName(stand) or "Unknown"
	local displayAtt = tostring(attValue or "Unknown")

	if convtoname and stand then
		pcall(function()
			text = string.gsub(text, stand:upper(), displayStand:upper())
		end)
	end

	local title = "Selina Hub | Stand Update"
	if string.find(text, "MATCH", 1, true) then
		title = "Selina Hub | Match Found"
	elseif string.find(text, "ROKA", 1, true) then
		title = "Selina Hub | Roka Used"
	end

	local standArrowCount = countItemByName("Stand Arrow")
	local chargedArrowCount = countItemByName("Charged Arrow")
	local rokaCount = countItemByName("Rokakaka")
	local statsText = "Arrows Used: " .. tostring(farmStats and farmStats.arrows or 0) .. " | Rokakaka Used: " .. tostring(farmStats and farmStats.rokas or 0)
	local quantityText = "Stand Arrow: " .. tostring(standArrowCount) .. " | Charged Arrow: " .. tostring(chargedArrowCount) .. " | Rokakaka: " .. tostring(rokaCount)
	local fields = {
		{
			["name"] = "Stand",
			["value"] = "`" .. tostring(displayStand) .. "`",
			["inline"] = true
		},
		{
			["name"] = "Attribute",
			["value"] = "`" .. tostring(displayAtt) .. "`",
			["inline"] = true
		},
		{
			["name"] = "Status",
			["value"] = text,
			["inline"] = false
		},
		{
			["name"] = "Item Quantity",
			["value"] = quantityText,
			["inline"] = false
		},
		{
			["name"] = "Stats",
			["value"] = statsText,
			["inline"] = false
		}
	}

	if isSlotMatch then
		table.insert(fields, 3, {
			["name"] = "Matched Slot",
			["value"] = "`Yes`",
			["inline"] = true
		})
	end

	local ok, response = pcall(function()
		local content = ""
		if shouldTagEveryone(attValue, isSlotMatch) then
			content = "@everyone"
		end
		return requestFunction({
			Url = webhookurl,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = jsonservice:JSONEncode({
				["content"] = content,
				["embeds"] = {{
					["title"] = title,
					["description"] = "━━━━━━━━━━━━━━━━━━",
					["type"] = "rich",
					["color"] = color or tonumber(0xFFFF00),
					["fields"] = fields,
					["footer"] = {
						["text"] = "⚡ Selina Hub • Stand Upright Rebooted"
					},
					["timestamp"] = DateTime.now():ToIsoDate()
				}}
			})
		})
	end)
	if not ok then
		warn("Webhook request failed: " .. tostring(response))
		return false, response
	end
	if type(response) == "table" and response.Success == false then
		local reason = response.Error or response.StatusMessage or response.StatusCode or "unknown"
		warn("Webhook request returned a failure response: " .. tostring(reason))
		return false, reason
	end
	return true, response
end

function popupfunc(text, toroka, stand)
	text = tostring(text)
	if not popup then return end
	local displayText = text
	if convtoname and stand then
		pcall(function()
			displayText = string.gsub(text, stand:upper(), getDisplayName(stand):upper())
		end)
	end
	if toroka and askroka then
		local s = showMessageBox(displayText .. " Roka?", "SUR", 4)
		if s == 6 then
			pcall(function()
				local roka = "Rokakaka"
				if not localplr.Backpack:FindFirstChild(roka) then
					notif("Waiting", "Waiting for Rokakaka...")
					local origstand = plrstand.Value
					local waitTimeout = 30
					local waited = 0
					repeat
						task.wait(1)
						waited = waited + 1
						if plrstand.Value ~= origstand then return end
					until localplr.Backpack:FindFirstChild(roka) or waited >= waitTimeout
					if not localplr.Backpack:FindFirstChild(roka) then
						notif("Timeout", "Failed to find Rokakaka in time.")
						return
					end
				end
				local selroka = localplr.Backpack:FindFirstChild(roka)
				local standv = plrstand.Value
				local att = plratt.Value
				selroka.Parent = localplr.Character
				selroka.Use:FireServer()
				repeat task.wait() until selroka.Parent == nil
				task.wait(0.2)
				webhook("ROKA'D " .. att:upper() .. " " .. getDisplayName(standv):upper(), nil, tonumber(0xFF0000))
			end)
		end
	else
		task.spawn(function()
			showMessageBox(displayText, "SUR", 0)
		end)
	end
end

function checkSlotMatch(standValue, attValue)
	local displayStand = getDisplayName(standValue)
	for i, slot in ipairs(farmSlots) do
		local sm = (slot.stand == "Any") or (slot.stand == standValue) or (slot.stand == displayStand)
		local am = false
		if type(slot.att) == "table" then
			for _, a in ipairs(slot.att) do
				if a == "Any" or a == attValue then
					am = true
					break
				end
			end
		else
			am = (slot.att == "Any") or (slot.att == attValue)
		end
		if sm and am then
			return true, i
		end
	end
	return false, nil
end

