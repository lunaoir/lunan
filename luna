            value = tostring(value or ""); if config.Numeric and not tonumber(value) then box.Text = self.Value; return end
            if config.MaxLength then value = string.sub(value, 1, config.MaxLength) end
            if value == self.Value then return end
            self.Value = value; box.Text = value; fireOption(self)
        end
        connect(box.FocusLost, function() option:SetValue(box.Text) end)
        if not config.Finished then connect(box:GetPropertyChangedSignal("Text"), function() option:SetValue(box.Text) end) end
        return option
    end
