local function updateWhiteScreen()
	if not whiteScreenGui or not whiteScreenGui.Parent then return end
	local frame = whiteScreenGui:FindFirstChild("MainFrame")
	if not frame then return end
	local textLabel = frame:FindFirstChild("InfoText")
	if not textLabel then return end

	local stand = "None"
	local att = "None"
	pcall(function()
		local data = localplr:FindFirstChild("Data")
		if data then
			stand = data:FindFirstChild("Stand") and data.Stand.Value or "None"
			att = data:FindFirstChild("Attri") and data.Attri.Value or "None"
		end
	end)

	local standArrow = 0
	local cArrow = 0
	local roka = 0
	local kars = 0

	local function getItemAmount(item)
		if not item then return 0 end
		local attrAmount = item:GetAttribute("ItemAmount")
		if type(attrAmount) == "number" then
			return math.floor(attrAmount)
		end
		local attrs = item:GetAttributes()
		for k, v in pairs(attrs) do
			local lowered = string.lower(k)
			if (lowered == "amount" or lowered == "count" or lowered == "value") and type(v) == "number" then
				return math.floor(v)
			end
		end
		local maxFound = 1
		local hasNumber = false
		for _, child in ipairs(item:GetDescendants()) do
			if child:IsA("IntValue") or child:IsA("NumberValue") then
				local val = math.floor(child.Value)
				if val > maxFound then maxFound = val end
				hasNumber = true
			elseif child:IsA("StringValue") then
				local num = tonumber(child.Value)
				if num and num > maxFound then maxFound = math.floor(num) end
				hasNumber = true
			end
		end
		if hasNumber and maxFound > 1 then
			return maxFound
		end
		return 1
	end

	local function countItems(parent)
		if not parent then return end
		for _, v in ipairs(parent:GetChildren()) do
			local amount = getItemAmount(v)
			if v.Name == "Stand Arrow" then standArrow = standArrow + amount
			elseif v.Name == "Charged Arrow" then cArrow = cArrow + amount
			elseif v.Name == "Rokakaka" then roka = roka + amount
			elseif v.Name == "Kars Mask" then kars = kars + amount
			end
		end
	end

	pcall(function()
		countItems(localplr:FindFirstChild("Backpack"))
		countItems(localplr.Character)
	end)

	local dn = getDisplayName(stand)
	textLabel.Text = string.format(
		"STAND\n  %s\n\nATTRIBUTE\n  %s\n\nITEMS\n  Stand Arrow      %d\n  Charged Arrow    %d\n  Rokakaka         %d\n  Kars Mask        %d",
		dn, att, standArrow, cArrow, roka, kars
	)
end

