local function tween(obj, goal, duration, style, dir)
    style = style or Enum.EasingStyle.Quart
    dir = dir or Enum.EasingDirection.Out
    local t = TweenService:Create(obj, TweenInfo.new(duration or 0.25, style, dir), goal)
    t:Play()
    return t
end

function Library:ChangeTheme(themeName)
    local NEW_COLORS = Library.THEMES[themeName]
    if not NEW_COLORS then return end

    local OLD_COLORS = Library.COLORS

    local colorMap = {}
    for key, oldColor in pairs(OLD_COLORS) do
        colorMap[oldColor:ToHex()] = NEW_COLORS[key]
    end

    local gui = Players.LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("TienTaiStandHub")
    if gui then
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("GuiObject") then
                if pcall(function() return obj.BackgroundColor3 end) then
                    local hex = obj.BackgroundColor3:ToHex()
                    if colorMap[hex] then tween(obj, {BackgroundColor3 = colorMap[hex]}, 0.5) end
                end
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    local hex = obj.TextColor3:ToHex()
                    if colorMap[hex] then tween(obj, {TextColor3 = colorMap[hex]}, 0.5) end
                end
                if obj:IsA("ScrollingFrame") then
                    local hex = obj.ScrollBarImageColor3:ToHex()
                    if colorMap[hex] then tween(obj, {ScrollBarImageColor3 = colorMap[hex]}, 0.5) end
                end
            end

            if obj:IsA("UIStroke") then
                local hex = obj.Color:ToHex()
                if colorMap[hex] then tween(obj, {Color = colorMap[hex]}, 0.5) end
            end

            if obj:IsA("UIGradient") then
                local cs = obj.Color
                local newKeys = {}
                local changed = false
                for _, kp in ipairs(cs.Keypoints) do
                    local hex = kp.Value:ToHex()
                    if colorMap[hex] then
                        table.insert(newKeys, ColorSequenceKeypoint.new(kp.Time, colorMap[hex]))
                        changed = true
                    else
                        table.insert(newKeys, kp)
                    end
                end
                if changed then 
                    obj.Color = ColorSequence.new(newKeys) 
                end
            end
        end
    end

    Library.COLORS = NEW_COLORS
end

