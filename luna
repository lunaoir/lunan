		writefile("sur_farmslots.txt", jsonservice:JSONEncode(farmSlots))
	end)
	if not ok then
		return false, err
	end
	return true, nil
end

local function loadSlots()
	if type(isfile) ~= "function" or type(readfile) ~= "function" then
		return false, "readfile API unavailable."
	end
	local okExists, exists = pcall(function()
		return isfile("sur_farmslots.txt")
	end)
	if not okExists then
		return false, exists
	end
	if not exists then
		farmSlots = {}
		return true, "missing"
	end
	local okRead, raw = pcall(function()
		return readfile("sur_farmslots.txt")
	end)
	if not okRead then
		return false, raw
	end
	if raw == "" then
		farmSlots = {}
		return true, "empty"
	end
	local okDecode, decoded = pcall(function()
		return jsonservice:JSONDecode(raw)
	end)
	if not okDecode or type(decoded) ~= "table" then
		return false, "Invalid farm slot save data."
	end
	local normalized = normalizeFarmSlots(decoded)
	local count = 0
	for key in pairs(decoded) do
		if type(key) ~= "number" or key % 1 ~= 0 or key < 1 then
			return false, "Saved slots must be an array."
		end
		count = count + 1
	end
	if #normalized ~= count then return false, "Invalid slot entry; current slots kept." end
	farmSlots = normalized
	return true, nil
end

local function autoSaveSlots()
	local ok, err = saveSlots()
	if not ok then notif("Slot Save Failed", tostring(err)) end
end

