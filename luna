local function safeLoadConfiguration()
	if not Rayfield or type(Rayfield.LoadConfiguration) ~= "function" then
		return false, "Configuration loader is unavailable."
	end
	if stopStandFarm then stopStandFarm() end
	loadingConfiguration = true
	local ok, result, err = pcall(function()
		return Rayfield:LoadConfiguration()
	end)
	loadingConfiguration = false
	if not ok or result == false then
		if stopStandFarm then stopStandFarm() end
		return false, not ok and result or err or "Configuration load failed."
	end
	if getgenv().farmstands and startStandFarm then startStandFarm() end
	return true, nil
end

local function safeSaveConfiguration()
	if not Rayfield or type(Rayfield.SaveConfiguration) ~= "function" then
		return false, "Configuration saver is unavailable."
	end
	local ok, result, err = pcall(function()
		return Rayfield:SaveConfiguration()
	end)
	if not ok then return false, result end
	if result == false then return false, err or "Configuration save failed." end
	return true, nil
end

local function safeDeleteFile(path)
	if type(delfile) ~= "function" then
		return false, "File deletion API is unavailable."
	end
	if type(isfile) == "function" then
		local okExists, exists = pcall(function()
			return isfile(path)
		end)
		if okExists and not exists then
			return true, "missing"
		end
	end
	local ok, err = pcall(function()
		delfile(path)
	end)
	if not ok then
		return false, err
	end
	return true, nil
end

