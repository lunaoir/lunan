		local startAbs = target.AbsolutePosition
		local changedConn, endedConn

		changedConn = UserInputService.InputChanged:Connect(function(inp)
			if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
			local now = UserInputService:GetMouseLocation()
			target.Position = UDim2.fromOffset(startAbs.X + now.X - startMouse.X, startAbs.Y + now.Y - startMouse.Y)
		end)
		endedConn = UserInputService.InputEnded:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				if changedConn then changedConn:Disconnect() end
				if endedConn then endedConn:Disconnect() end
			end
		end)
	end)
end

local DRAG_THRESHOLD_PX = 5
local function makeDockImageDragAndTap(dockBtn, onTap)
	dockBtn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local startMouse = UserInputService:GetMouseLocation()
		local startAbs = dockBtn.AbsolutePosition
		local moved = false
		local changedConn, endedConn

		changedConn = UserInputService.InputChanged:Connect(function(inp)
			if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
			local now = UserInputService:GetMouseLocation()
			if (now - startMouse).Magnitude > DRAG_THRESHOLD_PX then moved = true end
			if moved then dockBtn.Position = UDim2.fromOffset(startAbs.X + now.X - startMouse.X, startAbs.Y + now.Y - startMouse.Y) end
		end)
		endedConn = UserInputService.InputEnded:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				if changedConn then changedConn:Disconnect() end
				if endedConn then endedConn:Disconnect() end
				if not moved then onTap() end
			end
		end)
	end)
end

