local function getKnownStandTier(standName)
	local key = nameKey(standName)
	if key == "" or key == "any" then return nil end
	local displayName = getDisplayName(standName)
	return standTierCache[key]
		or standTierCache[standTierKey(standName)]
		or standTierCache[nameKey(displayName)]
		or standTierCache[standTierKey(displayName)]
		or builtinStandTiers[standTierKey(standName)]
		or builtinStandTiers[standTierKey(displayName)]
end

local function rememberStandTier(standName, tier, silent)
	if not tier or not isValidStandTier(tier) then return false end
	local key = nameKey(standName)
	if key == "" or key == "none" or key == "any" then return false end
	local displayKey = nameKey(getDisplayName(standName))
	local compactKey = standTierKey(standName)
	local compactDisplayKey = standTierKey(getDisplayName(standName))
	local changed = standTierCache[key] ~= tier
		or standTierCache[displayKey] ~= tier
		or standTierCache[compactKey] ~= tier
		or standTierCache[compactDisplayKey] ~= tier
	standTierCache[key] = tier
	standTierCache[displayKey] = tier
	standTierCache[compactKey] = tier
	standTierCache[compactDisplayKey] = tier
	if changed and not silent then
		if executiveUI.refreshTargetsWorkspace then pcall(executiveUI.refreshTargetsWorkspace) end
		if executiveUI.refreshStandPicker then pcall(executiveUI.refreshStandPicker) end
	end
	return changed
end

local tierObservation = {standKey = nil, tier = nil, count = 0}
local function observeStandTier(standName, tier)
	local key = nameKey(standName)
	if key == "" or key == "none" or not tier or not isValidStandTier(tier) then
		tierObservation = {standKey = nil, tier = nil, count = 0}
		return
	end
	if tierObservation.standKey == key and tierObservation.tier == tier then
		tierObservation.count = tierObservation.count + 1
	else
		tierObservation = {standKey = key, tier = tier, count = 1}
	end
	-- Confirm on two dashboard reads so a GUI row still updating after a roll
	-- cannot assign the previous Stand's tier to the new Stand.
	if tierObservation.count >= 2 then rememberStandTier(standName, tier) end
end

local standTierCatalogBusy = false
local lastStandTierCatalogScan = 0
local function scanStandTierCatalog(force)
	if standTierCatalogBusy then return false, "Tier scan is already running." end
	if not force and os.clock() - lastStandTierCatalogScan < 12 then return true, "Tier cache is fresh." end
	standTierCatalogBusy = true
	lastStandTierCatalogScan = os.clock()

	local changedCount = 0
	local knownStands = {}
	local function registerKnown(name)
		name = cleanText(name)
		local key = standTierKey(name)
		if key ~= "" and key ~= "any" and key ~= "none" then knownStands[key] = name end
	end
	for _, name in ipairs(standOptions) do registerKnown(name) end
	for internal, display in pairs(displayById) do
		registerKnown(internal)
		registerKnown(display)
	end
	for _, slot in ipairs(farmSlots) do registerKnown(slot.stand) end

	local function accept(name, rawTier)
		local canonical = knownStands[standTierKey(name)]
		local tier = normalizeStandTier(rawTier)
		if canonical and tier and rememberStandTier(canonical, tier, true) then
			changedCount = changedCount + 1
		end
	end

	pcall(function()
		for _, item in ipairs(ReplicatedStorage:GetDescendants()) do
			for _, attributeName in ipairs({"StandTier", "StandRank", "Tier", "Rank"}) do
				local tier = normalizeStandTier(item:GetAttribute(attributeName))
				if tier then
					accept(item.Name, tier)
					if item.Parent then accept(item.Parent.Name, tier) end
				end
			end
			if item:IsA("ValueBase") then
				local field = standTierKey(item.Name)
				if field == "standtier" or field == "standrank" or field == "tier" or field == "rank" then
					local tier = tierFromSource(item)
					if tier and item.Parent then
						accept(item.Parent.Name, tier)
						if item.Parent.Parent then accept(item.Parent.Parent.Name, tier) end
					end
				end
			end
		end
	end)

	-- The current client keeps Stand stats in a loaded ModuleScript or an
	-- upvalue, depending on the game build. Read both forms without changing
	-- any game state. This also understands tier-indexed tables such as
	-- { ["SSS"] = {"Stand A", "Stand B"} }.
	local seen, tableBudget = {}, 0
	local tierFields = {tier = true, standtier = true, rank = true, standrank = true}
	local nameFields = {stand = true, standname = true, name = true, displayname = true}
	local scanTable
	scanTable = function(tbl, parentKey, depth)
		if depth > 4 or seen[tbl] or tableBudget >= 30000 then return end
		seen[tbl] = true
		tableBudget = tableBudget + 1
		if tableBudget % 500 == 0 then task.wait() end

		local tier, standName
		for key, value in next, tbl do
			if type(key) == "string" then
				local field = standTierKey(key)
				if not tier and tierFields[field] then tier = normalizeStandTier(value) end
				if not standName and nameFields[field] and type(value) == "string"
					and knownStands[standTierKey(value)] then
					standName = value
				end
			end
		end
		if tier then accept(standName or parentKey, tier) end

		local parentTier = normalizeStandTier(parentKey)
		for key, value in next, tbl do
			if type(key) == "string" then
				local directTier = type(value) ~= "table" and normalizeStandTier(value) or nil
				if directTier and knownStands[standTierKey(key)] then accept(key, directTier) end
				if parentTier and knownStands[standTierKey(key)]
					and (value == true or type(value) == "number") then
					accept(key, parentTier)
				end
			end
			if parentTier and type(value) == "string" and knownStands[standTierKey(value)] then
				accept(value, parentTier)
			end
			if type(value) == "table" then
				scanTable(value, type(key) == "string" and key or parentKey, depth + 1)
			end
		end
	end

	if type(getgc) == "function" then
		local ok, objects = pcall(getgc, true)
		if ok and type(objects) == "table" then
			local upvalueReader = type(getupvalues) == "function" and getupvalues
				or (debug and type(debug.getupvalues) == "function" and debug.getupvalues)
			local functionBudget = 0
			for _, object in pairs(objects) do
				if type(object) == "table" then
					pcall(scanTable, object, nil, 0)
				elseif type(object) == "function" and upvalueReader and functionBudget < 8000 then
					functionBudget = functionBudget + 1
					local readOk, upvalues = pcall(upvalueReader, object)
					if readOk and type(upvalues) == "table" then
						for _, value in pairs(upvalues) do
							if type(value) == "table" then pcall(scanTable, value, nil, 0) end
						end
					end
				end
				if tableBudget >= 30000 then break end
			end
		end
	end

	if tableBudget < 30000 and type(getloadedmodules) == "function" then
		local ok, modules = pcall(getloadedmodules)
		if ok and type(modules) == "table" then
			for _, module in ipairs(modules) do
				local moduleKey = standTierKey(module.Name)
				if moduleKey:find("stand", 1, true) or moduleKey:find("stat", 1, true)
					or moduleKey:find("data", 1, true) or moduleKey:find("config", 1, true)
					or moduleKey:find("info", 1, true) then
					local required, result = pcall(require, module)
					if required and type(result) == "table" then
						pcall(scanTable, result, module.Name, 0)
					end
				end
				if tableBudget >= 30000 then break end
			end
		end
	end

	standTierCatalogBusy = false
	if changedCount > 0 then
		if executiveUI.refreshTargetsWorkspace then pcall(executiveUI.refreshTargetsWorkspace) end
		if executiveUI.refreshStandPicker then pcall(executiveUI.refreshStandPicker) end
	end
	return true, changedCount
end

local function safeScanStandTierCatalog(force)
	local ok, result, detail = pcall(scanStandTierCatalog, force)
	if not ok then
		standTierCatalogBusy = false
		warn("Stand tier catalog scan: " .. tostring(result))
		return false, tostring(result)
	end
	return result, detail
end

local function replacePlain(text, search, replacement)
	if search == "" then return text end
	local escaped = search:gsub("(%W)", "%%%1")
	return (text:gsub(escaped, function() return replacement end))
end

local function resolveRequestFunction()
	if syn and syn.request then return syn.request end
	if http and http.request then return http.request end
	if http_request then return http_request end
	if request then return request end
	if httpservice and httpservice.RequestAsync then
		return function(params)
			local success, response = pcall(function()
				return httpservice:RequestAsync({
					Url = params.Url,
					Method = params.Method,
					Headers = params.Headers,
					Body = params.Body,
				})
			end)
			if not success then
				return {
					Success = false,
					StatusCode = 0,
					Body = "",
					Headers = {},
					Error = response,
				}
			end
			return {
				Success = response.Success,
				StatusCode = response.StatusCode,
				Body = response.Body,
				Headers = response.Headers,
			}
		end
	end
	return nil
end

local requestFunction = resolveRequestFunction()

local function sanitizeSlot(slot)
	if type(slot) ~= "table" or cleanText(slot.stand) == "" then
		return nil
	end
	local normalized = {
		stand = cleanText(slot.stand),
		att = normalizeAttributes(slot.att),
	}
	if normalized.stand ~= "Any" and cleanText(slot.standId) ~= "" then
		normalized.standId = cleanText(slot.standId)
	end
	return normalized
end

local function normalizeFarmSlots(decoded)
	if type(decoded) ~= "table" then
		return {}
	end
	local normalized = {}
	for _, slot in ipairs(decoded) do
		local cleanSlot = sanitizeSlot(slot)
		if cleanSlot then
			table.insert(normalized, cleanSlot)
		end
	end
	return normalized
end

