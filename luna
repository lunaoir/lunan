local function resolveRequestFunction()
	if syn and syn.request then return syn.request end
	if http and http.request then return http.request end
	if http_request then return http_request end
	if request then return request end
	if httpservice and httpservice.RequestAsync then
		return function(params)
			local success, response = pcall(function()
				return httpservice:RequestAsync({
					Url = params.Url,
					Method = params.Method,
					Headers = params.Headers,
					Body = params.Body,
				})
			end)
			if not success then
				return {
					Success = false,
					StatusCode = 0,
					Body = "",
					Headers = {},
					Error = response,
				}
			end
			return {
				Success = response.Success,
				StatusCode = response.StatusCode,
				Body = response.Body,
				Headers = response.Headers,
			}
		end
	end
	return nil
end

local requestFunction = resolveRequestFunction()

local function sanitizeSlot(slot)
	if type(slot) ~= "table" then
		return nil
	end
	local normalized = {
		stand = type(slot.stand) == "string" and slot.stand ~= "" and slot.stand or "Any",
		att = {"Any"},
	}
	if type(slot.att) == "table" then
		local attList = {}
		for _, value in ipairs(slot.att) do
			if type(value) == "string" and value ~= "" then
				table.insert(attList, value)
			end
		end
		if #attList > 0 then
			normalized.att = attList
		end
	elseif type(slot.att) == "string" and slot.att ~= "" then
		normalized.att = {slot.att}
	end
	return normalized
end

local function normalizeFarmSlots(decoded)
	if type(decoded) ~= "table" then
		return {}
	end
	local normalized = {}
	for _, slot in ipairs(decoded) do
		local cleanSlot = sanitizeSlot(slot)
		if cleanSlot then
			table.insert(normalized, cleanSlot)
		end
	end
	return normalized
end

local function loadRayfieldLibrary()
	local okResponse, response = pcall(function()
		return game:HttpGet("https://gist.githubusercontent.com/ngocne0822-sys/c863b0b49c5564b48f30337e028857f3/raw/nhap.lua")
	end)
	if not okResponse then
		return nil, "Unable to fetch custom UI library: " .. tostring(response)
	end
	if type(response) ~= "string" or response == "" then
		return nil, "Custom UI library returned an empty payload."
	end
	local okChunk, chunk = pcall(loadstring, response)
	if not okChunk or type(chunk) ~= "function" then
		return nil, "Custom UI loader payload is invalid: " .. tostring(chunk)
	end
	local okLibrary, library = pcall(chunk)
	if not okLibrary or library == nil then
		return nil, "Custom UI library failed to initialize: " .. tostring(library)
	end
	return library, nil
end

