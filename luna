-- Compact Settings workspace. The original Rayfield controls stay alive but
-- hidden so their tested callbacks and configuration bindings remain the
-- single source of truth for every custom control below.
executiveUI.buildSettingsWorkspace = function()
	local page = Tabs.Settings._page
	if not page then return end
	-- Search refreshes can set legacy rows back to Visible=true. Keep those
	-- controls alive for their callbacks, but move them under an invisible host
	-- so they can never re-enter the page layout or appear below the new cards.
	local legacyHost = Instance.new("Frame")
	legacyHost.Name = "LegacySettingsBindings"
	legacyHost.Size = UDim2.fromOffset(0, 0)
	legacyHost.BackgroundTransparency = 1
	legacyHost.Visible = false
	legacyHost.Parent = page
	for _, child in ipairs(page:GetChildren()) do
		if child:IsA("GuiObject") and child.Name ~= "PageHero" and child ~= legacyHost then
			child.Parent = legacyHost
		end
	end
	page.CanvasPosition = Vector2.new(0, 0)

	local shell = Instance.new("Frame")
	shell.Name = "SettingsWorkspace"
	shell.LayoutOrder = -10
	shell.Size = UDim2.new(1, 0, 0, 294)
	shell.BackgroundTransparency = 1
	shell.ClipsDescendants = false
	shell.Parent = page

	local function rounded(instance, radius)
		local round = Instance.new("UICorner")
		round.CornerRadius = UDim.new(0, radius or 7)
		round.Parent = instance
		return instance
	end

	local function outline(instance, color, transparency)
		local edge = Instance.new("UIStroke")
		edge.Color = color or Color3.fromRGB(95, 57, 171)
		edge.Transparency = transparency or 0.35
		edge.Thickness = 1
		edge.Parent = instance
		return edge
	end

	local function icon(parent, iconName, size, position, color, zIndex)
		local image = Instance.new("ImageLabel")
		image.Size = UDim2.fromOffset(size, size)
		image.Position = position
		image.BackgroundTransparency = 1
		image.BorderSizePixel = 0
		image.ZIndex = zIndex or 2
		image.Parent = parent
		if not Rayfield.ApplyLunaIcon(image, iconName, color or Color3.fromRGB(183, 112, 255)) then
			image.Visible = false
		end
		return image
	end

	local function text(parent, value, size, position, font, color, textSize, zIndex)
		local label = Instance.new("TextLabel")
