	if not page then return end

	local shell = Instance.new("Frame")
	shell.Name = "TargetsWorkspace"
	shell.LayoutOrder = -10
	shell.Size = UDim2.new(1, 0, 0, 356)
	shell.BackgroundTransparency = 1
	shell.Parent = page

	local function rounded(instance, radius)
		local round = Instance.new("UICorner")
		round.CornerRadius = UDim.new(0, radius or 7)
		round.Parent = instance
		return instance
	end

	local function makeText(parent, text, size, position, font, color)
		local label = Instance.new("TextLabel")
		label.Size = size
		label.Position = position
		label.BackgroundTransparency = 1
		label.Text = text
		label.Font = font or Enum.Font.GothamSemibold
		label.TextSize = 10
		label.TextColor3 = color or Color3.fromRGB(181, 175, 211)
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextTruncate = Enum.TextTruncate.AtEnd
		label.Parent = parent
		return label
	end

	local function panel(title, icon, position, size)
		local frame = Instance.new("Frame")
		frame.Size = size
		frame.Position = position
		frame.BackgroundColor3 = Color3.fromRGB(14, 17, 34)
		frame.BorderSizePixel = 0
		frame.Parent = shell
		rounded(frame, 7)
		local outline = Instance.new("UIStroke")
		outline.Color = Color3.fromRGB(68, 51, 123)
		outline.Transparency = 0.28
		outline.Parent = frame

		makeText(frame, icon, UDim2.fromOffset(23, 23), UDim2.fromOffset(12, 9), Enum.Font.GothamBold, Color3.fromRGB(181, 117, 255)).TextSize = 17
		makeText(frame, title, UDim2.new(1, -76, 0, 19), UDim2.fromOffset(39, 9), Enum.Font.GothamBold, Color3.fromRGB(244, 241, 255)).TextSize = 12
		local separator = Instance.new("Frame")
		separator.Size = UDim2.new(1, -22, 0, 1)
		separator.Position = UDim2.fromOffset(11, 39)
		separator.BackgroundColor3 = Color3.fromRGB(56, 44, 98)
		separator.BorderSizePixel = 0
		separator.Parent = frame
		return frame
	end

