    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = playerGui

    local currentCamera = workspace.CurrentCamera

    local function getViewport()
        currentCamera = workspace.CurrentCamera or currentCamera
        if currentCamera then
            return currentCamera.ViewportSize
        end
        return Vector2.new(1280, 720)
    end

    local function buildLayout()
        local viewport = getViewport()
        local isMobile = viewport.X <= 820
        local width = math.clamp(math.floor(viewport.X * (isMobile and 0.96 or 0.70)), isMobile and 500 or 740, isMobile and 680 or 840)
        local height = math.clamp(math.floor(viewport.Y * (isMobile and 0.78 or 0.68)), isMobile and 420 or 470, isMobile and 560 or 520)
        local headerPadTop = 6
        local headerHeight = 36
        local sidePad = 6
        local bottomPad = 6
        local contentGap = 6
        local topContentY = headerPadTop + headerHeight + contentGap
        local navWidth = math.clamp(math.floor(width * (isMobile and 0.19 or 0.17)), isMobile and 98 or 122, isMobile and 124 or 136)
        local headerWidth = width - (sidePad * 2)
        local panelHeight = height - (topContentY + bottomPad)
        local navInset = 6
        local contentInset = isMobile and 7 or 9
        local searchHeight = 0
        local navBodyTop = navInset
        local contentBodyTop = contentInset
        local navBodyHeight = panelHeight - navBodyTop - navInset
        local contentWidth = headerWidth - navWidth - contentGap
        local contentBodyHeight = panelHeight - contentBodyTop - contentInset
        return {
            isMobile = isMobile,
            width = width,
            height = height,
            headerPadTop = headerPadTop,
            headerHeight = headerHeight,
            headerWidth = headerWidth,
            panelHeight = panelHeight,
            sidePad = sidePad,
            bottomPad = bottomPad,
            contentGap = contentGap,
