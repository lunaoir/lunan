end

function loadSlots()
	if type(isfile) ~= "function" or type(readfile) ~= "function" then
		farmSlots = {}
		return false, "readfile API unavailable."
	end
	local okExists, exists = pcall(function()
		return isfile("sur_farmslots.txt")
	end)
	if not okExists then
		farmSlots = {}
		return false, exists
	end
	if not exists then
		farmSlots = {}
		return true, "missing"
	end
	local okRead, raw = pcall(function()
		return readfile("sur_farmslots.txt")
	end)
	if not okRead then
		farmSlots = {}
		return false, raw
	end
	if raw == "" then
		farmSlots = {}
		return true, "empty"
	end
	local okDecode, decoded = pcall(function()
		return jsonservice:JSONDecode(raw)
	end)
	if not okDecode then
		farmSlots = {}
		return false, "Invalid farm slot save data."
	end
	farmSlots = normalizeFarmSlots(decoded)
	return true, nil
end

