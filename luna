	end
	if executiveUI.dashboardRollStatus then
		executiveUI.dashboardRollStatus.Text = "Status  •  " .. (getgenv().farmstands and "Rolling and comparing targets" or "Waiting to start")
	end
	if executiveUI.dashboardRollFill then
		executiveUI.dashboardRollFill.Size = UDim2.new(getgenv().farmstands and 0.68 or 0.08, 0, 1, 0)
	end
	if executiveUI.dashboardTargetRows then
		for i, label in ipairs(executiveUI.dashboardTargetRows) do
			local slot = farmSlots[i]
			label.Text = slot and (i .. ".  " .. getSlotDisplayText(slot)) or (i .. ".  No target configured")
		end
	end
	if executiveUI.dashboardStats then
		local stats = farmStats or {}
		executiveUI.dashboardStats[1].Text = "Arrows Used\n" .. tostring(stats.arrows or 0)
		executiveUI.dashboardStats[2].Text = "Rokas Used\n" .. tostring(stats.rokas or 0)
		executiveUI.dashboardStats[3].Text = "Matches Found\n" .. tostring(stats.matches or 0)
		executiveUI.dashboardStats[4].Text = "Stands Stored\n" .. tostring(stats.stored or 0)
	end
	if executiveUI.dashboardFarmSection then
		executiveUI.dashboardFarmSection:Set("Stand Farm  •  " .. (getgenv().farmstands and "RUNNING" or "OFF"))
	end
	if executiveUI.dashboardLairSection then
		local phase = autolairToggle and "RUNNING" or "OFF"
		executiveUI.dashboardLairSection:Set("Auto Lair  •  " .. phase)
	end
	if executiveUI.dashboardCurrentSection then
		executiveUI.dashboardCurrentSection:Set("Current  •  " .. getDisplayName(stand or "None") .. "  /  " .. tostring(att or "None") .. "  /  Tier " .. tier)
	end
	if executiveUI.dashboardTargetSection then
		executiveUI.dashboardTargetSection:Set("Targets  •  " .. #farmSlots .. " configured")
	end
	if executiveUI.dashboardOrbSection then
		executiveUI.dashboardOrbSection:Set(orbStatusText())
	end
end

task.wait(0.5)
refreshUI()
updateFarmExtrasUI()
updateExecutiveDashboard()
executiveUI.extrasElapsed = 0
executiveUI.extrasConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
	if getgenv().SURFarmSession ~= hubSession then executiveUI.extrasConnection:Disconnect(); return end
	executiveUI.extrasElapsed = executiveUI.extrasElapsed + dt
	if executiveUI.extrasElapsed >= 1 then
		executiveUI.extrasElapsed = 0
		local ok, err = pcall(updateFarmExtrasUI)
		if not ok then warn("Storage/Orb display: " .. tostring(err)) end
		local dashboardOk, dashboardErr = pcall(updateExecutiveDashboard)
		if not dashboardOk then warn("Dashboard display: " .. tostring(dashboardErr)) end
	end
end)

if (whiteScreenGui and whiteScreenGui.Parent and whiteScreenGui.Enabled) or forceExecutiveWindowVisible() then
	setBootstrapStatus("Ready  •  Press K to show/hide", false)
	task.delay(1.25, function()
		if bootstrapGui and bootstrapGui.Parent then bootstrapGui:Destroy() end
	end)
else
	setBootstrapStatus("Menu ScreenGui was not created", true)
end

print("Luna Hub Executive loaded! Targets: " .. #farmSlots)
