function Library:SaveConfiguration()
    local cfg = self._compat.config
    if not cfg then return true end
    if type(writefile) ~= "function" then
        return false, "Configuration saver is unavailable."
    end
    if type(isfolder) == "function" and type(makefolder) == "function" then
        local exists = false
        local ok = pcall(function()
            exists = isfolder(cfg.FolderName)
        end)
        if ok and not exists then
            pcall(makefolder, cfg.FolderName)
        end
    end
    local okEncode, encoded = pcall(function()
        return game:GetService("HttpService"):JSONEncode({
            flags = self._compat.flags
        })
    end)
    if not okEncode then
        return false, encoded
    end
    local okWrite, err = pcall(function()
        writefile(cfg.FolderName .. "/" .. cfg.FileName .. ".json", encoded)
    end)
    if not okWrite then
        return false, err
    end
    return true
end

function Library:LoadConfiguration()
    local cfg = self._compat.config
    if not cfg then return true end
    if type(readfile) ~= "function" or type(isfile) ~= "function" then
        return false, "Configuration loader is unavailable."
    end
    local path = cfg.FolderName .. "/" .. cfg.FileName .. ".json"
    local exists = false
    local okExists = pcall(function()
        exists = isfile(path)
    end)
    if not okExists or not exists then
        return true
    end
    local okRead, raw = pcall(function()
        return readfile(path)
    end)
    if not okRead then
        return false, raw
    end
    local okDecode, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(raw)
    end)
    if not okDecode then
        return false, data
    end
    if type(data) ~= "table" or type(data.flags) ~= "table" then
        return true
    end
    for flag, value in pairs(data.flags) do
        self:_setFlag(flag, value, true)
    end
    return true
end

return Library
