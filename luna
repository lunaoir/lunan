-- Stand Upright exposes the rank as "Stand Tier" in its M stats panel.  Some
-- builds also replicate the same value into Player.Data, so prefer that stable
-- source and fall back to reading the visible stats row when needed.
local validStandTiers = {
	F = true, E = true, D = true, C = true, B = true, A = true,
	S = true, SS = true, SSS = true, Q = true,
	["Ø"] = true, ["Ω"] = true, ["∞"] = true,
}
local cachedStandTierSource = nil

local function isValidStandTier(tier)
	if validStandTiers[tier] then return true end
	if type(tier) ~= "string" or #tier < 2 then return false end
	local suffix = tier:sub(-1)
	return (suffix == "+" or suffix == "-") and validStandTiers[tier:sub(1, -2)] == true
end

local function standTierKey(value)
	return cleanText(value):lower():gsub("[^%w]", "")
end

local function normalizeStandTier(value)
	if value == nil then return nil end
	local text = tostring(value):gsub("<.->", "")
	text = text:match("^%s*(.-)%s*$") or ""
	local inline = text:match("[Ss][Tt][Aa][Nn][Dd]%s*[Tt][Ii][Ee][Rr]%s*[:%-]?%s*(.+)")
	if inline then text = inline end
	text = string.upper(text):gsub("%s+", "")
	if text == "INFINITY" or text == "INFINITE" or text == "INF" then return "∞" end
	if isValidStandTier(text) then return text end
	return nil
end

local function tierFromSource(source)
	if not source or not source.Parent then return nil end
	local ok, value = pcall(function()
		if source:IsA("TextLabel") or source:IsA("TextButton") or source:IsA("TextBox") then
			return source.Text
		end
		if source:IsA("ValueBase") then return source.Value end
		return nil
	end)
	return ok and normalizeStandTier(value) or nil
end

local function readStandTier()
	local data = localplr:FindFirstChild("Data")
	local standValue = data and data:FindFirstChild("Stand")
	local attributeOwners = {standValue, data, localplr}
	for _, owner in ipairs(attributeOwners) do
		if owner then
			local names = owner == localplr and {"StandTier", "StandRank"}
				or {"StandTier", "StandRank", "Tier", "Rank"}
			for _, attributeName in ipairs(names) do
				local ok, value = pcall(function() return owner:GetAttribute(attributeName) end)
				local tier = ok and normalizeStandTier(value) or nil
				if tier then return tier end
			end
		end
	end

	if data then
		for _, item in ipairs(data:GetDescendants()) do
			local key = standTierKey(item.Name)
			if key == "standtier" or key == "standrank" then
				local tier = tierFromSource(item)
				if tier then
					cachedStandTierSource = item
					return tier
				end
			end
		end
	end

	local cached = tierFromSource(cachedStandTierSource)
	if cached then return cached end
	cachedStandTierSource = nil

	local playerGui = localplr:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return nil end
	for _, label in ipairs(playerGui:GetDescendants()) do
		if label:IsA("TextLabel") or label:IsA("TextButton") or label:IsA("TextBox") then
			local ok, rawText = pcall(function() return label.Text end)
			if ok and type(rawText) == "string" then
				local inlineTier = normalizeStandTier(rawText)
				if inlineTier and standTierKey(rawText):find("standtier", 1, true) then
					cachedStandTierSource = label
					return inlineTier
				end
				if standTierKey(rawText) == "standtier" then
					local container = label.Parent
					for _ = 1, 2 do
						if not container or container == playerGui then break end
						for _, candidate in ipairs(container:GetDescendants()) do
							if candidate ~= label and (candidate:IsA("TextLabel") or candidate:IsA("TextButton") or candidate:IsA("TextBox")) then
								local tier = tierFromSource(candidate)
								if tier then
									cachedStandTierSource = candidate
									return tier
								end
							end
						end
						container = container.Parent
					end
				end
			end
		end
	end
	return nil
end

