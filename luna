    corner.Parent = ripple

    ripple.Parent = button

    local bSize = button.AbsoluteSize
    local bPos = button.AbsolutePosition
    local relX = clickPosX - bPos.X
    local relY = clickPosY - bPos.Y

    local maxDim = math.max(bSize.X, bSize.Y) * 1.5

    ripple.Size = UDim2.fromOffset(0, 0)
    ripple.Position = UDim2.fromOffset(relX, relY)
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)

    tween(ripple, {Size = UDim2.fromOffset(maxDim, maxDim), BackgroundTransparency = 1}, 0.5, Enum.EasingStyle.Sine).Completed:Connect(function()
        ripple:Destroy()
    end)
end

