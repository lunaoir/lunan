local function doStandFarm()
	if isFarmingActive or not getgenv().farmstands or getgenv().SURFarmSession ~= hubSession then return end
	isFarmingActive = true
	farmRun = farmRun + 1
	local run = farmRun
	farmStats = { arrows = 0, rokas = 0, matches = 0, errors = 0, stored = 0, orbs = 0 }
	local errors, lastFire = 0, 0
	local pendingArrowNotice = false
	local waitingForItem = nil
	local activeItem
	local function running()
		return getgenv().farmstands and farmRun == run and getgenv().SURFarmSession == hubSession
	end
	local function alive()
		local char = localplr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return char, hum and hum.Health > 0
	end
	local function recordError(message)
		if not running() then return end
		errors = errors + 1
		farmStats.errors = farmStats.errors + 1
		notif("Farm retry " .. errors .. "/10", message)
		task.wait(0.5)
	end
	local function stableData()
		local started, changedAt = os.clock(), os.clock()
		local previousStand, previousAtt
		while running() and os.clock() - started < 4 do
			local s, a = readStandData()
			if s == nil then return nil, nil end
			if s ~= previousStand or a ~= previousAtt then
				previousStand, previousAtt = s, a
				changedAt = os.clock()
			end
			-- An unselected Stand cannot become a match just because its Attribute
			-- arrives later. Reject it quickly; keep the full Attribute window for
			-- possible targets (including every Stand when a target uses Any).
			local empty = s == "None" and a == "None"
			local unselected = s ~= "None" and not checkSlotMatch(s, a, true)
			local fast = empty or unselected
			local minimumWait = fast and 0 or 0.75
			local quietWait = fast and (1 / 60) or 0.35
			if os.clock() - started >= minimumWait and os.clock() - changedAt >= quietWait and a ~= "" then
				return s, a, unselected
			end
			task.wait()
		end
		return nil, nil
	end
	local function fireItem(item, expectedStand, expectedAtt, fastReject)
		local remaining = 0.05 - (os.clock() - lastFire)
		if remaining > 0 then task.wait(remaining) end
		if not running() then return false, "cancelled" end
		if lairCombatBusy then return false, "lair combat" end
		local char, isAlive = alive()
		if not isAlive or not item or not item.Parent then return false, "Character/item unavailable." end
		local remote = getUseItemRemote(item)
		if not remote then return false, "UseItem RemoteEvent was not found." end
		local equipOk, equipErr = pcall(function()
			char:FindFirstChildOfClass("Humanoid"):EquipTool(item)
		end)
		if not equipOk then return false, tostring(equipErr) end
		-- Keep the previous farm Tool equipped until Roblox replaces it here.
		-- This removes the visible empty-hand gap between Arrow and Rokakaka.
		activeItem = item
		task.wait()
		if not running() then return false, "cancelled" end
		if lairCombatBusy then return false, "lair combat" end
		local currentChar, stillAlive = alive()
		local s, a = readStandData()
		if currentChar ~= char or not stillAlive or item.Parent ~= char then
			return false, "Character/item changed during equip."
		end
		if s ~= expectedStand or a ~= expectedAtt then return false, "data changed" end
		if #farmSlots == 0 or (expectedStand == "None" and item.Name ~= selectedArrowType) then
			return false, "data changed"
		end
		if storagePending then return false, "Storage swap still requires verification." end
		-- A retrieved junk Stand may still be removed even after storage becomes
		-- full. Require free storage only before using the next Arrow.
		if autoStoreMatches and expectedStand == "None" then
			local available = storageAvailability()
			if not available then return false, "No confirmed storage space." end
		end
		-- Re-check the slots after every yield before consuming Rokakaka.
		if expectedStand ~= "None" and checkSlotMatch(s, a) then return false, "data changed" end
		-- A target added during equip invalidates the fast rejection even if
		-- its desired Attribute has not arrived yet. Re-enter the normal check.
		if fastReject and checkSlotMatch(s, a, true) then return false, "data changed" end
		local ok, err = pcall(function() remote:FireServer() end)
		lastFire = os.clock()
		return ok, err
	end
	local function waitForResult(usingArrow, fromStand)
		local deadline = os.clock() + 8
		while running() and os.clock() < deadline do
			local s = readStandData()
			if s ~= nil then
				if usingArrow and s ~= "None" then return true end
				if not usingArrow and s == "None" then return true end
				if not usingArrow and s ~= fromStand then return false end
			end
			task.wait()
		end
		return false
	end

	local ok, err = xpcall(function()
		notif("Stand Farm", "Started. Arrow: " .. selectedArrowType)
		while running() do
			task.wait()
			if not running() then break end
			if #farmSlots == 0 then
				notif("Stand Farm", "Add at least 1 target before farming.")
				break
			end
			if errors >= 10 then
				notif("Farm Stopped", "Too many item-use errors. Check inventory/connection.")
				break
			end
			local _, isAlive = alive()
			if not isAlive or not localplr:FindFirstChild("Backpack") then
				task.wait(0.5)
				continue
			end
			-- Boss combat gets a very short exclusive window. This prevents an
			-- Arrow/Roka equip animation from swallowing the M1 used on the boss.
			if lairCombatBusy then
				task.wait(0.03)
				continue
			end
			-- Never use Arrow/Roka while an earlier swap has an uncertain outcome.
			if storagePending then
				local confirmed, detail = awaitStorageConfirmation(running)
				if not confirmed then notif("Storage Stopped", detail); break end
				farmStats.stored = farmStats.stored + 1
			end
			local stand, att, fastReject = stableData()
			if not running() then break end
			if stand == nil then task.wait(0.25); continue end
			local usingArrow = stand == "None"
			if not usingArrow then
				local matched, slotNum = checkSlotMatch(stand, att)
				if matched then
					farmStats.matches = (farmStats.matches or 0) + 1
					-- A kept Stand must never leave an Arrow/Roka equipped while the
					-- hub stores it, stops, or displays the match popup.
					returnFarmItem(activeItem)
					activeItem = nil
					local dn = getDisplayName(stand)
					notif("MATCH!", "Target " .. slotNum .. ": " .. att .. " " .. dn)
					task.spawn(webhook, "MATCH FOUND: " .. att:upper() .. " " .. dn:upper()
						.. " (Target " .. slotNum .. ")", stand, 0x00FF00, att, true)
					if autoStoreMatches then
						local stored, detail = storeMatchedStand(stand, att, running)
						if not stored then
							storageMessage = detail
							notif("Storage Stopped", detail)
							break
						end
						farmStats.stored = farmStats.stored + 1
						pendingArrowNotice = false
						notif("Stand Stored", dn .. " / " .. att .. " -> " .. detail)
						task.spawn(webhook, "STORED: " .. att:upper() .. " " .. dn:upper()
							.. " -> " .. detail, stand, 0x00FF00, att, true)
						-- Re-read the stand taken OUT of storage before deciding what to use.
						continue
					end
					getgenv().farmstands = false
					setFarmToggleOff()
					popupfunc("YOU GOT " .. att:upper() .. " " .. dn:upper() .. "!", false, stand)
					break
				end
				if pendingArrowNotice then
					pendingArrowNotice = false
					task.spawn(webhook, "ARROW #" .. farmStats.arrows .. ": " .. att:upper()
						.. " " .. getDisplayName(stand):upper(), stand, 0xFFFF00, att, false)
				end
			end

			-- With a junk Stand active, use its Roka first. Once it becomes None,
			-- stop before the next Arrow if every enabled slot is protected.
			if autoStoreMatches and usingArrow then
				local available, reason = storageAvailability()
				if not available then
					storageMessage = reason == "full" and "All enabled slots are protected; farm stopped."
						or "Storage data unavailable; farm stopped."
					notif("Storage Stopped", storageMessage)
					break
				end
			end
			-- Renew Orb at the safe None -> Arrow boundary. Never insert Orb
			-- between an Arrow result and its immediate Rokakaka replacement.
			if usingArrow then ensureOrb(running, stand, att) end
			if not running() then break end
			local itemName = usingArrow and selectedArrowType or "Rokakaka"
			local item = findFarmItem(itemName)
			if not item then
				if waitingForItem ~= itemName then
					waitingForItem = itemName
					notif("Stand Farm", "Waiting for " .. itemName .. "; farming will resume automatically.")
				end
				task.wait(1)
				continue
			end
			if waitingForItem then
				notif("Stand Farm", itemName .. " found; resuming farming.")
				waitingForItem = nil
			end
			if lairCombatBusy then
				task.wait(0.03)
				continue
			end
			local fired, fireError = fireItem(item, stand, att, fastReject)
			if not fired then
				returnFarmItem(activeItem)
				activeItem = nil
				if not running() then break end
				if fireError ~= "data changed" and fireError ~= "lair combat" then
					recordError(tostring(fireError))
				end
				continue
			end
			local succeeded = waitForResult(usingArrow, stand)
			if not running() then break end
			if not succeeded then
				returnFarmItem(activeItem)
				activeItem = nil
				recordError(itemName .. " timed out; no confirmed result.")
				continue
			end
			errors = 0
			if usingArrow then
				farmStats.arrows = farmStats.arrows + 1
				pendingArrowNotice = true
				-- The next iteration waits for attribute replication and checks the slots.
			else
				farmStats.rokas = farmStats.rokas + 1
				task.spawn(webhook, "ROKA USED: " .. att:upper() .. " " .. getDisplayName(stand):upper(),
					stand, 0xFF0000, att, false)
			end
		end
	end, function(message) return debug.traceback(tostring(message), 2) end)

	returnFarmItem(activeItem)
	isFarmingActive = false
	if farmRun == run and getgenv().SURFarmSession == hubSession then
		getgenv().farmstands = false
		setFarmToggleOff()
	end
	if not ok then
		farmStats.errors = farmStats.errors + 1
		warn(err)
		notif("Farm Error", tostring(err))
	end
	notif("Farm Stopped", "Arrows: " .. farmStats.arrows .. " | Rokas: " .. farmStats.rokas)
	-- An off/on action during an old worker's wait starts exactly one fresh worker.
	if getgenv().farmstands and getgenv().SURFarmSession == hubSession then task.defer(startStandFarm) end
end

