local function resetAutoLairState()
	if lairLoopConn then
		lairLoopConn:Disconnect()
		if getgenv().SURLairLoopConnection == lairLoopConn then
			getgenv().SURLairLoopConnection = nil
		end
		lairLoopConn = nil
	end
	currentBoss = nil
	lairCombatBusy = false
	lastLairM1 = 0
	lairM1Busy = false
	lastLairAttempt = 0
	lastLairClearScan = 0
	lastLairClearVisible = false
	lairClearWasVisible = false
	lastSimulationBoost = 0
	allowNearbyZeroBoss = true
	lairFastTransitionBoss = nil
	lairFastTransitionPositiveSince = nil
	table.clear(retiredLairBosses)
	table.clear(lairKillStates)
end

local function getInstanceRootPart(instance)
	if not instance then return nil end
	if instance:IsA("Model") then
		return instance.PrimaryPart
			or instance:FindFirstChild("HumanoidRootPart")
			or instance:FindFirstChild("Torso")
			or instance:FindFirstChild("UpperTorso")
	end
	if instance:IsA("BasePart") then return instance end
	return nil
end

local function getInstancePosition(instance)
	local root = getInstanceRootPart(instance)
	return root and root.Position or nil
end

local function findTargetedLairNPC()
	local npc = targetedLairNPC
	local map = game.Workspace:FindFirstChild("Map")
	local npcsFolder = map and map:FindFirstChild("NPCs")
	if npc and npc.Parent and npc.Name == useLairNPCName and npc:FindFirstChild("Done") then
		return npc
	end
	if not npcsFolder then
		targetedLairNPC = nil
		return nil
	end
	npc = nil
	local char = localplr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local referencePos = hrp and hrp.Position
	local closestDist = math.huge
	for _, candidate in ipairs(npcsFolder:GetChildren()) do
		if candidate.Name == useLairNPCName and candidate:FindFirstChild("Done") then
			local pos = getInstancePosition(candidate)
			if pos then
				local dist
				if useLairNPCName == "i_stabman" then
					dist = (pos - STABMAN_NPC_COORD).Magnitude
				elseif referencePos then
					dist = (pos - referencePos).Magnitude
				end
				if dist and dist < closestDist then
					closestDist = dist
					npc = candidate
				end
			end
			npc = npc or candidate
		end
	end
	targetedLairNPC = npc
	return npc
end

local function tryEnterLair()
	local now = os.clock()
	-- Five attempts per second is still immediate, but avoids flooding the same
	-- server remote every rendered frame while a Lair transition is pending.
	if now - lastLairAttempt < 0.2 then return end
	local npc = findTargetedLairNPC()
	if not npc then return end
	local doneRemote = npc:FindFirstChild("Done")
	if not doneRemote or not doneRemote:IsA("RemoteEvent") then return end
	lastLairAttempt = now
	pcall(function() doneRemote:FireServer(localplr.Character) end)
end

local function getTargetBoss()
	-- Once selected, keep the same model even when its client Health reaches 0.
	-- The server can reject that local zero while the boss keeps attacking.
	if currentBoss and currentBoss ~= lairFastTransitionBoss
		and currentBoss.Parent and not retiredLairBosses[currentBoss] then
		local humanoid = currentBoss:FindFirstChildOfClass("Humanoid")
		local root = getInstanceRootPart(currentBoss)
		if humanoid and humanoid.Parent and root and root.Parent then
			return currentBoss, humanoid, root
		end
	end

	local bestBoss, bestHumanoid, bestRoot = nil, nil, nil
	local bestDistance = math.huge
	local zeroBoss, zeroHumanoid, zeroRoot = nil, nil, nil
	local zeroDistance = math.huge
	local seen = {}
	local char = localplr.Character
	local playerRoot = char and char:FindFirstChild("HumanoidRootPart")

	local function consider(candidate)
		if not candidate or seen[candidate] or not candidate:IsA("Model")
			or candidate.Name ~= useLairBoss then return end
		seen[candidate] = true
		local humanoid = candidate:FindFirstChildOfClass("Humanoid")
		local root = getInstanceRootPart(candidate)
		if not humanoid or not humanoid.Parent or not root or not root:IsA("BasePart") then return end
		if candidate == lairFastTransitionBoss then
			-- Ignore the finished boss while its local Health remains zero. A
			-- positive value must remain stable long enough to outlive the 0.06s
			-- Kill Aura re-arm pulse before the same model can be selected again.
			if humanoid.Health > 1 then
				lairFastTransitionPositiveSince = lairFastTransitionPositiveSince or os.clock()
				if os.clock() - lairFastTransitionPositiveSince >= 0.25 then
					lairFastTransitionBoss = nil
					lairFastTransitionPositiveSince = nil
				else
					return
				end
			else
				lairFastTransitionPositiveSince = nil
				return
			end
		end
		if retiredLairBosses[candidate] then
			-- A reused model becomes eligible only after the server gives it a
			-- genuinely fresh positive health value.
			if humanoid.Health > 1 then
				retiredLairBosses[candidate] = nil
			else
				return
			end
		end
		local distance = playerRoot and (root.Position - playerRoot.Position).Magnitude or 0
		if humanoid.Health > 0 then
			if not bestBoss or distance < bestDistance then
				bestBoss, bestHumanoid, bestRoot = candidate, humanoid, root
				bestDistance = distance
			end
		elseif allowNearbyZeroBoss and distance <= 250
			and (not zeroBoss or distance < zeroDistance) then
			-- Recovery path for a boss zeroed by an older Luna worker before this
			-- version had time to select it. Distant map templates are ignored.
			zeroBoss, zeroHumanoid, zeroRoot = candidate, humanoid, root
			zeroDistance = distance
		end
	end

	local living = game.Workspace:FindFirstChild("Living")
	if living then
		for _, npc in ipairs(living:GetDescendants()) do consider(npc) end
	end

	-- Some Lairs replicate the active boss under Map.LairSpawns before the
	-- Workspace.Living copy appears. Use it as a fallback so TP never misses.
	local map = workspace:FindFirstChild("Map")
	local lairSpawns = map and map:FindFirstChild("LairSpawns")
	if lairSpawns then
		for _, candidate in ipairs(lairSpawns:GetDescendants()) do consider(candidate) end
	end
	if bestBoss then return bestBoss, bestHumanoid, bestRoot end
	return zeroBoss, zeroHumanoid, zeroRoot
end

local function getLairAttackCFrame(bossRoot)
	-- Stay behind and slightly above the boss: outside its closest melee zone,
	-- but still near enough for Luna's M1 hitbox to connect.
	local position = (bossRoot.CFrame * CFrame.new(0, 2.5, 4.25)).Position
	local target = bossRoot.Position + Vector3.new(0, 1.5, 0)
	return CFrame.lookAt(position, target)
end

local function getLairM1Remotes()
	local character = localplr.Character
	if not character then return nil end
	local combatModel = character
	local standEvents = combatModel:FindFirstChild("StandEvents")
	if not standEvents then
		local living = workspace:FindFirstChild("Living")
		combatModel = living and living:FindFirstChild(localplr.Name) or combatModel
		standEvents = combatModel and combatModel:FindFirstChild("StandEvents")
	end
	local m1Remote = standEvents and standEvents:FindFirstChild("M1")
	local events = ReplicatedStorage:FindFirstChild("Events")
	local abilityInput = events and events:FindFirstChild("AbilityInput")
	if m1Remote and m1Remote:IsA("RemoteEvent")
		and abilityInput and abilityInput:IsA("RemoteEvent") then
		return abilityInput, m1Remote
	end
	return nil
end

local function pressLairM1()
	local now = os.clock()
	if lairM1Busy or now - lastLairM1 < 0.15 then return end
	local abilityInput, m1Remote = getLairM1Remotes()
	if not abilityInput or not m1Remote then return end

	lairM1Busy = true
	lastLairM1 = now
	local began = false
	pcall(function()
		abilityInput:FireServer("MouseButton1", "Begin", nil)
		began = true
		m1Remote:FireServer()
	end)
	task.delay(0.08, function()
		if began and abilityInput.Parent then
			pcall(function()
				abilityInput:FireServer("MouseButton1", "End", nil)
			end)
		end
		lairM1Busy = false
	end)
end

local function isGuiActuallyVisible(guiObject, playerGui)
	local current = guiObject
	while current and current ~= playerGui do
		if current:IsA("GuiObject") and not current.Visible then return false end
		if current:IsA("LayerCollector") and not current.Enabled then return false end
		current = current.Parent
	end
	return current == playerGui
end

local function isLairClearVisible()
	local now = os.clock()
	if now - lastLairClearScan < 0.1 then return lastLairClearVisible end
	lastLairClearScan = now
	local playerGui = localplr:FindFirstChild("PlayerGui")
	if not playerGui then
		lastLairClearVisible = false
		return false
	end
	for _, object in ipairs(playerGui:GetDescendants()) do
		if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
			local text = string.lower(tostring(object.Text or ""))
			if string.find(text, "lair clear", 1, true)
				and isGuiActuallyVisible(object, playerGui) then
				lastLairClearVisible = true
				return true
			end
		end
	end
	lastLairClearVisible = false
	return false
end

local function boostLairSimulationRadius()
	local now = os.clock()
	if now - lastSimulationBoost < 0.25 then return end
	lastSimulationBoost = now
	if type(setsimulationradius) == "function" then
		pcall(setsimulationradius, 1000000, 1000000)
	end
	if type(sethiddenproperty) == "function" then
		pcall(sethiddenproperty, localplr, "SimulationRadius", 1000000)
		pcall(sethiddenproperty, localplr, "MaximumSimulationRadius", 1000000)
	end
end

local function canReplicateBossHealth(root)
	if type(isnetworkowner) ~= "function" then return true end
	local ok, owned = pcall(isnetworkowner, root)
	return not ok or owned == true
end

local function pulseCurrentBossKillAura(boss, humanoid, root)
	if not boss or retiredLairBosses[boss] or not boss.Parent
		or not humanoid or not humanoid.Parent or not root or not root.Parent then return end
	boostLairSimulationRadius()
	pcall(function() humanoid.BreakJointsOnDeath = false end)
	if not canReplicateBossHealth(root) then return end

	local now = os.clock()
	local state = lairKillStates[boss]
	if not state then
		state = {lastAttempt = 0, rearming = false}
		lairKillStates[boss] = state
	end
	if humanoid.Health > 0 and now - state.lastAttempt >= 0.05 then
		state.lastAttempt = now
		pcall(function() humanoid.Health = 0 end)
	elseif humanoid.Health <= 0 and not state.rearming and now - state.lastAttempt >= 0.75 then
		-- Health=0 can be client-only. Re-arm it briefly, then submit a fresh
		-- zero attempt while M1 continues to provide a server-side hit fallback.
		state.lastAttempt = now
		state.rearming = true
		pcall(function() humanoid.Health = 1 end)
		task.delay(0.06, function()
			if boss.Parent and humanoid.Parent and root.Parent
				and not retiredLairBosses[boss] and canReplicateBossHealth(root) then
				pcall(function() humanoid.Health = 0 end)
			end
			state.rearming = false
		end)
	end
end

local function retireClearedBoss()
	local finishedBoss = currentBoss or lairFastTransitionBoss
	if finishedBoss then retiredLairBosses[finishedBoss] = true end
	-- Ignore every other zero-health duplicate left by this cleared Lair. A new
	-- server boss arrives with positive health and is still selected immediately.
	allowNearbyZeroBoss = false
	currentBoss = nil
	lairCombatBusy = false
	lairFastTransitionBoss = nil
	lairFastTransitionPositiveSince = nil
	lastLairM1 = 0
end

local function pulseFinishingLairBoss()
	local boss = lairFastTransitionBoss
	if not boss then return end
	if not boss.Parent then
		lairFastTransitionBoss = nil
		lairFastTransitionPositiveSince = nil
		return
	end
	local humanoid = boss:FindFirstChildOfClass("Humanoid")
	local root = getInstanceRootPart(boss)
	if humanoid and humanoid.Parent and root and root.Parent then
		if humanoid.Health > 1 and lairFastTransitionPositiveSince then
			-- Pause the zero pulse during the 0.25s stability check. If the
			-- server restored this boss, normal TP + M1 combat will resume.
			return
		end
		-- Keep retrying the client/network kill without pulling the player back.
		pulseCurrentBossKillAura(boss, humanoid, root)
	end
end

local function loopAutoLair()
	if lairLoopConn then
		lairLoopConn:Disconnect()
		lairLoopConn = nil
	end

	lairLoopConn = game:GetService("RunService").Heartbeat:Connect(function()
		if getgenv().SURLairSession ~= hubSession or not autolairToggle then
			autolairToggle = false
			resetAutoLairState()
			return
		end

		local char = localplr.Character
		if not char then lairCombatBusy = false; return end

		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then lairCombatBusy = false; return end

		local clearVisible = isLairClearVisible()
		if clearVisible and not lairClearWasVisible then
			retireClearedBoss()
		end
		lairClearWasVisible = clearVisible

		local previousBoss = currentBoss
		local boss, bossHumanoid, bossRoot = getTargetBoss()

		if boss and bossHumanoid and bossRoot then
			if boss ~= previousBoss then
				currentBoss = boss
				allowNearbyZeroBoss = true
				lairFastTransitionBoss = nil
				lairFastTransitionPositiveSince = nil
				lastLairM1 = 0
			end
			lairCombatBusy = true

			hrp.CFrame = getLairAttackCFrame(bossRoot)

			pressLairM1()
			pulseCurrentBossKillAura(boss, bossHumanoid, bossRoot)
			if bossHumanoid.Health <= 0 then
				-- Enter FINISHING: stop following the old boss immediately. The
				-- background kill retry and next-Lair requests continue without TP.
				if lairFastTransitionBoss ~= boss then
					lairFastTransitionBoss = boss
					lairFastTransitionPositiveSince = nil
					lastLairAttempt = 0
				end
				currentBoss = nil
				lairCombatBusy = false
				tryEnterLair()
				return
			end
		else
			currentBoss = nil
			lairCombatBusy = false
			pulseFinishingLairBoss()
			tryEnterLair()
		end
	end)
	getgenv().SURLairLoopConnection = lairLoopConn
end

