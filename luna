    local function applyPageSearch(pageData)
        if not pageData then
            return
        end
        -- The search UI is intentionally hidden in the compact Luna layout.
        -- A stale hidden TextBox value must never make an entire tab appear empty.
        local query = string.lower(contentSearchBox.Text or "")
        for _, entry in ipairs(pageData.SearchEntries or {}) do
            if entry.Instance and entry.Instance.Parent then
                entry.Instance.Visible = matchesSearchQuery(entry.SearchText, query)
            end
        end
    end

    local function applyAllPageSearch()
        for _, pageData in pairs(Pages) do
            applyPageSearch(pageData)
        end
    end

    local function applyNavSearch()
        local query = string.lower(navSearchBox.Text or "")
        local firstVisible
        for name, dat in pairs(Pages) do
            local isVisible = matchesSearchQuery(string.lower(name), query)
            dat.Btn.Visible = isVisible
            if isVisible and not firstVisible then
                firstVisible = name
            end
        end

        if activeTabName and Pages[activeTabName] and Pages[activeTabName].Btn.Visible ~= false then
            setActiveTab(activeTabName)
            applyPageSearch(Pages[activeTabName])
            return
        end

        if firstVisible then
            setActiveTab(firstVisible)
            applyPageSearch(Pages[firstVisible])
            return
        end

        activeTabName = nil
        for _, dat in pairs(Pages) do
            dat.Page.Visible = false
        end
    end

