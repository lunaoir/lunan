function getSlotDisplayText(slot)
	local attText = "Any"
	if type(slot.att) == "table" then
		local filtered = {}
		for _, a in ipairs(slot.att) do
			table.insert(filtered, a)
		end
		if #filtered == 0 or (#filtered == 1 and filtered[1] == "Any") then
			attText = "Any Att"
		else
			attText = table.concat(filtered, ", ")
		end
	elseif type(slot.att) == "string" then
		attText = slot.att
	end
	return (slot.stand or "Any") .. " + [" .. attText .. "]"
end

function buildSlotListForDropdown()
	local names = {}
	for i, slot in ipairs(farmSlots) do
		table.insert(names, "Slot " .. i .. ": " .. getSlotDisplayText(slot))
	end
	if #names == 0 then
		return {"-- No slots --"}
	end
	return names
end

function buildSlotsDisplayText()
	if #farmSlots == 0 then
