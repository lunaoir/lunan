function executiveUI.standAbbreviation(value)
	local letters = {}
	for word in cleanText(value):gmatch("[%w]+") do
		table.insert(letters, word:sub(1, 1):lower())
	end
	return table.concat(letters)
end

function executiveUI.rememberStandSelection(value)
	value = cleanText(value)
	if value == "" or value == "Any" then return end
	for i = #executiveUI.recentStandSelections, 1, -1 do
		if nameKey(executiveUI.recentStandSelections[i]) == nameKey(value) then
			table.remove(executiveUI.recentStandSelections, i)
		end
	end
	table.insert(executiveUI.recentStandSelections, 1, value)
	while #executiveUI.recentStandSelections > 5 do table.remove(executiveUI.recentStandSelections) end
	if executiveUI.recentStandSection then
		executiveUI.recentStandSection:Set("Recent: " .. table.concat(executiveUI.recentStandSelections, "  •  "))
	end
end

function executiveUI.getFilteredStandList(query)
	query = nameKey(query)
	local result, seen = {}, {}
	local function add(value)
		local key = nameKey(value)
		if value and value ~= "" and not seen[key] then
			seen[key] = true
			table.insert(result, value)
		end
	end
	if query == "" then
		add("Any")
		for _, value in ipairs(executiveUI.recentStandSelections) do add(value) end
		for _, value in ipairs(standOptions) do add(value) end
	else
		for _, value in ipairs(standOptions) do
			local key = nameKey(value)
			local id = uniqueStandId(value)
			if key:find(query, 1, true) or executiveUI.standAbbreviation(value):find(query, 1, true)
				or (id and nameKey(id):find(query, 1, true)) then
				add(value)
			end
		end
	end
	if #result == 0 then return {"-- No matches --"} end
	return result
end

function executiveUI.targetKey(slot)
	local attributes = normalizeAttributes(slot and slot.att or {"Any"})
	table.sort(attributes)
	local standKey = slot and (slot.standId or nameKey(slot.stand)) or "any"
	return tostring(standKey) .. "|" .. table.concat(attributes, ",")
end

local function getSlotDisplayText(slot)
	local attText = "Any"
	if type(slot.att) == "table" then
		local filtered = {}
		for _, a in ipairs(slot.att) do
			table.insert(filtered, a)
		end
		if #filtered == 0 or (#filtered == 1 and filtered[1] == "Any") then
			attText = "Any Att"
		else
			attText = table.concat(filtered, ", ")
		end
	elseif type(slot.att) == "string" then
		attText = slot.att
	end
	return (slot.stand or "Any") .. " + [" .. attText .. "]"
end

local function buildSlotListForDropdown()
	local names = {}
	for i, slot in ipairs(farmSlots) do
		table.insert(names, "Target " .. i .. ": " .. getSlotDisplayText(slot))
	end
	if #names == 0 then
		return {"-- No targets --"}
	end
	return names
end

local function buildSlotsDisplayText()
	if #farmSlots == 0 then
		return "No targets yet"
	end
	local lines = {}
	for i = 1, math.min(3, #farmSlots) do
		local slot = farmSlots[i]
		table.insert(lines, "[" .. i .. "] " .. getSlotDisplayText(slot))
	end
	if #farmSlots > 3 then
		table.insert(lines, "+" .. (#farmSlots - 3) .. " more — use Manage Targets")
	end
	return table.concat(lines, " | ")
end

