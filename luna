local function parseLogoAssetId(raw)
	if type(raw) ~= "string" then return nil end
	local s = raw:gsub("%s+", "")
	if s == "" then return nil end
	local fromMarker = s:match("rbxassetid://(%d+)") or s:match("rbxasset://(%d+)")
	if fromMarker then return fromMarker end
	local fromUrl = s:match("[Ll]ibrary/(%d+)") or s:match("asset/?%?id=(%d+)") or s:match("assetId=(%d+)")
	if fromUrl then return fromUrl end
	if s:match("^%d+$") then return s end
	return nil
end

local function resolveLocalImageAsset(path)
    if type(path) ~= "string" or path == "" then return nil end
    if type(getsynasset) == "function" then
        local ok, asset = pcall(getsynasset, path)
        if ok and asset then return asset end
    end
    if type(getcustomasset) == "function" then
        local ok, asset = pcall(getcustomasset, path)
        if ok and asset then return asset end
    end
    return nil
end

local function logoImageCandidates(id)
	if not id then return {} end
	return {
		"rbxassetid://" .. id,
		"rbxthumb://type=Asset&id=" .. id .. "&w=420&h=420",
		"rbxthumb://type=Asset&id=" .. id .. "&w=150&h=150",
	}
end

local function applyLogoToImage(guiWithImage, rawId)
	local localAsset = resolveLocalImageAsset(rawId)
	if localAsset then
		guiWithImage.ImageTransparency = 0
		guiWithImage.ScaleType = Enum.ScaleType.Crop
		guiWithImage.Image = localAsset
		return true
	end
	local id = parseLogoAssetId(rawId)
	if not id then return false end
	guiWithImage.ImageTransparency = 0
	guiWithImage.ScaleType = Enum.ScaleType.Crop
	local list = logoImageCandidates(id)
	task.spawn(function()
		for _, uri in ipairs(list) do
			if not guiWithImage.Parent then return end
			guiWithImage.Image = uri
			pcall(function() ContentProvider:PreloadAsync({ guiWithImage }) end)
			task.wait(0.5)
			local isLoaded = false
			pcall(function() isLoaded = guiWithImage.IsLoaded and guiWithImage:IsLoaded() end)
			if isLoaded then return end
		end
	end)
	return true
end

local function makeDragMoveTarget(handle, target)
	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local startMouse = UserInputService:GetMouseLocation()
		local startAbs = target.AbsolutePosition
		local changedConn, endedConn

		changedConn = UserInputService.InputChanged:Connect(function(inp)
			if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
			local now = UserInputService:GetMouseLocation()
			target.Position = UDim2.fromOffset(startAbs.X + now.X - startMouse.X, startAbs.Y + now.Y - startMouse.Y)
		end)
		endedConn = UserInputService.InputEnded:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				if changedConn then changedConn:Disconnect() end
				if endedConn then endedConn:Disconnect() end
			end
		end)
	end)
end

local DRAG_THRESHOLD_PX = 5
local function makeDockImageDragAndTap(dockBtn, onTap)
	dockBtn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local startMouse = UserInputService:GetMouseLocation()
		local startAbs = dockBtn.AbsolutePosition
		local moved = false
		local changedConn, endedConn

		changedConn = UserInputService.InputChanged:Connect(function(inp)
			if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
			local now = UserInputService:GetMouseLocation()
			if (now - startMouse).Magnitude > DRAG_THRESHOLD_PX then moved = true end
			if moved then dockBtn.Position = UDim2.fromOffset(startAbs.X + now.X - startMouse.X, startAbs.Y + now.Y - startMouse.Y) end
		end)
		endedConn = UserInputService.InputEnded:Connect(function(inp)
			if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
				if changedConn then changedConn:Disconnect() end
				if endedConn then endedConn:Disconnect() end
				if not moved then onTap() end
			end
		end)
	end)
end

