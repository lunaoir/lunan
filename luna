			local marker = Instance.new("Frame")
			marker.Size = UDim2.fromOffset(13, 13)
			marker.Position = UDim2.fromOffset(7, 7)
			marker.BackgroundColor3 = active and Color3.fromRGB(151, 83, 249) or Color3.fromRGB(31, 34, 64)
			marker.BorderSizePixel = 0
			marker.ZIndex = 43
			marker.Parent = option
			rounded(marker, 3)
			local markerEdge = Instance.new("UIStroke")
			markerEdge.Color = active and Color3.fromRGB(210, 173, 255) or Color3.fromRGB(91, 76, 137)
			markerEdge.Transparency = active and 0.1 or 0.35
			markerEdge.Parent = marker

			local optionName = makeText(option, attributeName, UDim2.new(1, -86, 0, 18), UDim2.fromOffset(27, 5), Enum.Font.GothamSemibold, active and Color3.fromRGB(244, 237, 255) or Color3.fromRGB(197, 191, 221))
			optionName.TextSize = 8
			optionName.ZIndex = 43
			local state = makeText(option, active and "Selected" or "Select", UDim2.fromOffset(52, 18), UDim2.new(1, -58, 0, 5), Enum.Font.GothamSemibold, active and Color3.fromRGB(190, 139, 255) or Color3.fromRGB(123, 116, 154))
			state.TextSize = 7
			state.TextXAlignment = Enum.TextXAlignment.Right
			state.ZIndex = 43

			option.MouseButton1Click:Connect(function()
				if attributeName == "Any" then
					selectedAttsForSlot = {"Any"}
				else
					local nextValues, alreadySelected = {}, false
					for _, value in ipairs(normalizeAttributes(selectedAttsForSlot)) do
						if value ~= "Any" then
							if value == attributeName then
								alreadySelected = true
							else
								table.insert(nextValues, value)
							end
						end
					end
					if not alreadySelected then table.insert(nextValues, attributeName) end
					selectedAttsForSlot = #nextValues > 0 and nextValues or {"Any"}
				end
				updateAttributeField()
				renderAttributePicker()
			end)
		end
	end

