local function getDisplayName(internalName)
	local internal = cleanText(internalName)
	if internal == "" then return "Unknown" end
	if displayById[internal] then return displayById[internal] end
	local target = ReplicatedStorage:FindFirstChild("StandNameConvert", true)
	local item = target and not target:IsA("ModuleScript") and target:FindFirstChild(internal)
	if item and item:IsA("StringValue") and cleanText(item.Value) ~= "" then
		return cleanText(item.Value)
	end
	return internal
end

local function uniqueStandId(display)
	local ids = idsByDisplay[nameKey(display)]
	return ids and #ids == 1 and ids[1] or nil
end

local function readStandData()
	local data = localplr:FindFirstChild("Data")
	local stand = data and data:FindFirstChild("Stand")
	local att = data and data:FindFirstChild("Attri")
	if not stand or not att then return nil, nil end
	local ok, s, a = pcall(function() return stand.Value, att.Value end)
	if not ok or type(s) ~= "string" or type(a) ~= "string" or s == "" then
		return nil, nil
	end
	return s, a
end

local function replacePlain(text, search, replacement)
	if search == "" then return text end
	local escaped = search:gsub("(%W)", "%%%1")
	return (text:gsub(escaped, function() return replacement end))
end

local function resolveRequestFunction()
	if syn and syn.request then return syn.request end
	if http and http.request then return http.request end
	if http_request then return http_request end
	if request then return request end
	if httpservice and httpservice.RequestAsync then
		return function(params)
			local success, response = pcall(function()
				return httpservice:RequestAsync({
					Url = params.Url,
					Method = params.Method,
					Headers = params.Headers,
					Body = params.Body,
				})
			end)
			if not success then
				return {
					Success = false,
					StatusCode = 0,
					Body = "",
					Headers = {},
					Error = response,
				}
			end
			return {
				Success = response.Success,
				StatusCode = response.StatusCode,
				Body = response.Body,
				Headers = response.Headers,
			}
		end
	end
	return nil
end

local requestFunction = resolveRequestFunction()

local function sanitizeSlot(slot)
	if type(slot) ~= "table" or cleanText(slot.stand) == "" then
		return nil
	end
	local normalized = {
		stand = cleanText(slot.stand),
		att = normalizeAttributes(slot.att),
	}
	if normalized.stand ~= "Any" and cleanText(slot.standId) ~= "" then
		normalized.standId = cleanText(slot.standId)
	end
	return normalized
end

local function normalizeFarmSlots(decoded)
	if type(decoded) ~= "table" then
		return {}
	end
	local normalized = {}
	for _, slot in ipairs(decoded) do
		local cleanSlot = sanitizeSlot(slot)
		if cleanSlot then
			table.insert(normalized, cleanSlot)
		end
	end
	return normalized
end

