    function Tab:AddSlider(id, config)
        local option = optionBase(self, id, config, "Slider", 86)
        option.Min = config.Min or 0; option.Max = config.Max or 100; option.Value = config.Default or option.Min
        local readout = text(option.Frame, tostring(option.Value), 13, C.Lavender, {Position = UDim2.new(1, -85, 0, 14), Size = UDim2.fromOffset(66, 24), TextXAlignment = Enum.TextXAlignment.Right})
        local bar = button(option.Frame, "", {Name = "SliderBar", Position = UDim2.fromOffset(17, 53), Size = UDim2.new(1, -34, 0, 28), BackgroundTransparency = 1}, nil, false)
        local track = frame(bar, {Position = UDim2.fromOffset(0, 11), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = C.Line}); corner(track, 5)
        local fill = frame(track, {Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Lavender}); corner(fill, 5)
        local handle = frame(fill, {Position = UDim2.fromScale(1, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = C.Text}); corner(handle, 9)
        local function draw() readout.Text = tostring(option.Value); fill.Size = UDim2.fromScale((option.Value - option.Min) / math.max(option.Max - option.Min, 0.0001), 1) end
        function option:SetValue(value)
            local scale = 10 ^ (config.Rounding or 0); value = math.clamp(math.floor((tonumber(value) or self.Min) * scale + 0.5) / scale, self.Min, self.Max)
            if self.Value == value then draw(); return end
            self.Value = value; draw(); fireOption(self)
        end
        local dragging, touch
        local function update(input) local ratio = math.clamp((input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1); option:SetValue(option.Min + ratio * (option.Max - option.Min)) end
        connect(bar.InputBegan, function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; touch = input; update(input) end end)
        connect(Input.InputChanged, function(input) if dragging and (input == touch or input.UserInputType == Enum.UserInputType.MouseMovement) then update(input) end end)
        connect(Input.InputEnded, function(input) if input == touch or input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
        draw(); LunaUI:SafeCallback(option.Callback, option.Value); return option
    end
    function Tab:AddInput(id, config)
        local option = optionBase(self, id, config, "Input"); option.Value = tostring(config.Default or "")
        local box = create("TextBox", {Name = "Value", Text = option.Value, PlaceholderText = config.Placeholder or "Enter value...", ClearTextOnFocus = false, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.Lavender, PlaceholderColor3 = C.Muted, BackgroundColor3 = C.Hover, BorderSizePixel = 0, Position = UDim2.new(0.58, 0, 0.5, -17), Size = UDim2.new(0.42, -16, 0, 34)}, option.Frame); corner(box, 9)
