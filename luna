TabSettings:CreateToggle({
	Name = "Anti Ragdoll / Bypass Timestop",
	CurrentValue = false,
	Flag = "AntiRagdoll",
	Callback = function(Value)
		if oncharadded then oncharadded:Disconnect(); oncharadded = nil end
		if Value then
			local function setup(char)
				if noplatformstand then noplatformstand:Disconnect() end
				for _, v in pairs(partsonconnect) do v:Disconnect() end
				partsonconnect = {}
				
				pcall(function()
					local ragdoll = char:FindFirstChild("Ragdoll") or char:WaitForChild("Ragdoll", 5)
					if ragdoll then
						ragdoll:Destroy()
					end
				end)
				local humanoid = char:FindFirstChild("Humanoid") or char:WaitForChild("Humanoid", 10)
				local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 10)
				if not humanoid or not head then
					return
				end
				char.Humanoid.PlatformStand = false
				if head.Anchored then
					for _, v in pairs(char:GetChildren()) do
						if v:IsA("BasePart") then v.Anchored = false end
					end
				end
				noplatformstand = humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
					humanoid.PlatformStand = false
				end)
				for _, v in pairs(char:GetDescendants()) do
					if v:IsA("BasePart") then
						table.insert(partsonconnect, v:GetPropertyChangedSignal("Anchored"):Connect(function()
							if v.Anchored then v.Anchored = false end
						end))
					end
				end
			end
			if localplr.Character then setup(localplr.Character) end
			oncharadded = localplr.CharacterAdded:Connect(setup)
		else
			if noplatformstand then noplatformstand:Disconnect() end
			if oncharadded then oncharadded:Disconnect() end
			for _, v in pairs(partsonconnect) do v:Disconnect() end
			partsonconnect = {}
		end
	end,
})

