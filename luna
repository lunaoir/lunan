local function webhook(text, stand, color, attValue, isSlotMatch)
	if webhookurl == "" then return false, "Webhook URL is empty." end
	if not requestFunction then
		warn("Webhook disabled: no supported HTTP request function was found.")
		return false, "HTTP request function unavailable."
	end

	local function getItemAmount(item)
		if not item then return 0 end
		local attrAmount = item:GetAttribute("ItemAmount")
		if type(attrAmount) == "number" then
			return math.floor(attrAmount)
		end
		return 1
	end

	local function countItemByName(itemName)
		local total = 0
		local function scan(parent)
			if not parent then return end
			for _, item in ipairs(parent:GetChildren()) do
				if item.Name == itemName then
					total = total + getItemAmount(item)
				end
			end
		end
		scan(localplr:FindFirstChild("Backpack"))
		scan(localplr.Character)
		return total
	end

	text = tostring(text)
	local displayStand = stand and getDisplayName(stand) or "Unknown"
	local displayAtt = tostring(attValue or "Unknown")

	if convtoname and stand then
		pcall(function()
			text = replacePlain(text, stand:upper(), displayStand:upper())
		end)
	end

	local title = "Luna Hub | Stand Update"
	if string.find(text, "MATCH", 1, true) then
		title = "Luna Hub | Match Found"
	elseif string.find(text, "ROKA", 1, true) then
		title = "Luna Hub | Roka Used"
	end

	local standArrowCount = countItemByName("Stand Arrow")
	local chargedArrowCount = countItemByName("Charged Arrow")
	local rokaCount = countItemByName("Rokakaka")
	local statsText = "Arrows Used: " .. tostring(farmStats and farmStats.arrows or 0) .. " | Rokakaka Used: " .. tostring(farmStats and farmStats.rokas or 0)
	local quantityText = "Stand Arrow: " .. tostring(standArrowCount) .. " | Charged Arrow: " .. tostring(chargedArrowCount) .. " | Rokakaka: " .. tostring(rokaCount)
	local fields = {
		{
			["name"] = "Stand",
			["value"] = "`" .. tostring(displayStand) .. "`",
			["inline"] = true
		},
		{
			["name"] = "Attribute",
			["value"] = "`" .. tostring(displayAtt) .. "`",
			["inline"] = true
		},
		{
			["name"] = "Status",
			["value"] = text,
			["inline"] = false
		},
		{
			["name"] = "Item Quantity",
			["value"] = quantityText,
			["inline"] = false
		},
		{
			["name"] = "Stats",
			["value"] = statsText,
			["inline"] = false
		}
	}

	if isSlotMatch then
		table.insert(fields, 3, {
			["name"] = "Matched Target",
			["value"] = "`Yes`",
			["inline"] = true
		})
	end

	local ok, response = pcall(function()
		local content = ""
		if shouldTagEveryone(attValue, isSlotMatch) then
			content = tagperson
		end
		return requestFunction({
			Url = webhookurl,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = jsonservice:JSONEncode({
				["content"] = content,
				["embeds"] = {{
					["title"] = title,
					["description"] = "━━━━━━━━━━━━━━━━━━",
					["type"] = "rich",
					["color"] = color or tonumber(0xFFFF00),
					["fields"] = fields,
					["footer"] = {
						["text"] = "⚡ Luna Hub • Stand Upright Rebooted"
					},
					["timestamp"] = DateTime.now():ToIsoDate()
				}}
			})
		})
	end)
	if not ok then
		warn("Webhook request failed: " .. tostring(response))
		return false, response
	end
	if type(response) ~= "table" then return false, "Invalid HTTP response." end
	local status = tonumber(response.StatusCode)
	if response.Success == false or (status and (status < 200 or status >= 300)) then
		local reason = response.Error or response.StatusMessage or response.StatusCode or "unknown"
		warn("Webhook request returned a failure response: " .. tostring(reason))
		return false, reason
	end
	return true, response
end

local function popupfunc(text, toroka, stand)
	if not popup then return end
	local displayText = tostring(text)
	if convtoname and stand then
		displayText = replacePlain(displayText, tostring(stand):upper(), getDisplayName(stand):upper())
	end
	if not (toroka and askroka) then
		task.spawn(function() showMessageBox(displayText, "SUR", 0) end)
		return
	end
	task.spawn(function()
		local originalStand, originalAtt = readStandData()
		if showMessageBox(displayText .. " Roka?", "SUR", 4) ~= 6 then return end
		if not originalStand or originalStand == "None" or getgenv().farmstands then return end
		local item
		local deadline = os.clock() + 30
		repeat
			local s, a = readStandData()
			if s ~= originalStand or a ~= originalAtt or getgenv().farmstands then return end
			local backpack = localplr:FindFirstChild("Backpack")
			local char = localplr.Character
			item = (backpack and backpack:FindFirstChild("Rokakaka")) or (char and char:FindFirstChild("Rokakaka"))
			if item then break end
			task.wait(0.25)
		until os.clock() >= deadline
		if not item then notif("Timeout", "Rokakaka was not found."); return end
		local char = localplr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
		local events = ReplicatedStorage:FindFirstChild("Events")
		local remote = events and events:FindFirstChild("UseItem") or item:FindFirstChild("Use")
		if not remote or not remote:IsA("RemoteEvent") then
			notif("Roka Error", "UseItem RemoteEvent was not found.")
			return
		end
		local ok, err = pcall(function()
			hum:EquipTool(item)
			task.wait(0.1)
			local s, a = readStandData()
			if getgenv().farmstands or s ~= originalStand or a ~= originalAtt
				or localplr.Character ~= char or hum.Health <= 0 or item.Parent ~= char then return end
			remote:FireServer()
			local useDeadline = os.clock() + 8
			repeat
				local current = readStandData()
				if current == "None" then
					webhook("ROKA USED: " .. originalAtt:upper() .. " " .. getDisplayName(originalStand):upper(),
						originalStand, 0xFF0000, originalAtt, false)
					return
				end
				if current and current ~= originalStand then return end
				task.wait(0.1)
			until os.clock() >= useDeadline
			notif("Roka Timeout", "The stand reset was not confirmed.")
		end)
		pcall(function()
			local backpack = localplr:FindFirstChild("Backpack")
			if backpack and item.Parent == char then item.Parent = backpack end
		end)
		if not ok then notif("Roka Error", tostring(err)) end
	end)
end

local function checkSlotMatch(standValue, attValue, standOnly)
	if not standValue or standValue == "None" or not attValue then return false, nil end
	local displayStand = getDisplayName(standValue)
	for i, slot in ipairs(farmSlots) do
		local sm
		if slot.stand == "Any" then sm = true
		elseif slot.standId then sm = slot.standId == standValue
		else
			sm = nameKey(slot.stand) == nameKey(standValue)
				or nameKey(getDisplayName(slot.stand)) == nameKey(displayStand)
		end
		-- Optional query: can ANY attribute make this Stand worth keeping?
		-- Normal two-argument callers still require Stand AND Attribute.
		if sm and standOnly then return true, i end
		local am = false
		if type(slot.att) == "table" then
			for _, a in ipairs(slot.att) do
				if a == "Any" or a == attValue then
					am = true
					break
				end
			end
		else
			am = (slot.att == "Any") or (slot.att == attValue)
		end
		if sm and am then
			return true, i
		end
	end
	return false, nil
end

