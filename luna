--================== STORAGE AND ORB STATE ==================--
-- User-confirmed open storage buttons are Slots 1, 2 and 4. Slot 4 uses the
-- remote argument "Slot4" and Data.Slot4; Slots 3, 5 and 6 are excluded.
local storageMap = {
	{label = "Slot 1", remote = "Slot1", data = "Slot1"},
	{label = "Slot 2", remote = "Slot2", data = "Slot2"},
	{label = "Slot 4", remote = "Slot4", data = "Slot4"},
}
local accountKey = tostring(localplr.UserId or localplr.Name)
-- V2 intentionally ignores obsolete Slot5 pending records from the earlier map.
local storageFile = "sur_storage_pending_v2_" .. accountKey .. ".json"
local storageMessage = "Ready"
local storagePending
local orbState = {expiresAt = 0, requestedAt = 0, pending = false}
local orbPendingItem, orbPendingCharacter, orbPendingAmount
local orbNextTry = 0
local orbMessage = "No recorded use"
local lastStorageRequest = -math.huge

getgenv().SURStorageStateV2 = getgenv().SURStorageStateV2 or {}
-- Orb buffs disappear on leave/rejoin. Cache only against the exact live
-- DataModel and LocalPlayer so reloading this hub in the same session is safe,
-- while a new game session always requires a fresh Orb.
getgenv().SUROrbSessionStateV2 = getgenv().SUROrbSessionStateV2 or {}

local function persistState(path, value)
	if type(writefile) ~= "function" then return false end
	local ok = pcall(function() writefile(path, jsonservice:JSONEncode(value)) end)
	if not ok then warn("Could not save " .. path) end
	return ok
end

local function readSavedState(path)
	if type(isfile) ~= "function" or type(readfile) ~= "function" then return nil end
	local ok, result = pcall(function()
		if not isfile(path) then return nil end
		return jsonservice:JSONDecode(readfile(path))
	end)
	if not ok then return nil, "Unreadable saved state: " .. path end
	if result ~= nil and type(result) ~= "table" then return nil, "Invalid saved state: " .. path end
	return result
end

local function readStandRecord(prefix)
	local data = localplr:FindFirstChild("Data")
	if not data then return nil end
	local s = data:FindFirstChild((prefix or "") .. "Stand")
	local a = data:FindFirstChild((prefix or "") .. "Attri")
	local g = data:FindFirstChild((prefix or "") .. "GUID")
	if not s or not a or not g then return nil end
	local ok, record = pcall(function()
		return {stand = s.Value, att = a.Value, guid = g.Value}
	end)
	if not ok or type(record.stand) ~= "string" or record.stand == ""
		or type(record.att) ~= "string" or type(record.guid) ~= "string"
		or (record.stand ~= "None" and (record.guid == "" or record.guid == "Generate")) then return nil end
	return record
end

local function sameRecord(a, b)
	return a and b and a.stand == b.stand and a.att == b.att and a.guid == b.guid
end

local function confirmedSwap(current, stored, pending)
	if not sameRecord(stored, pending.current) then return false end
	if pending.stored.stand == "None" then
		-- Empty storage commonly has GUID "Generate", while the active empty
		-- record may receive a fresh GUID. The valuable side must still arrive
		-- intact in storage; the active side must be stably empty.
		return current and current.stand == "None" and current.att == "None"
	end
	return sameRecord(current, pending.stored)
end

local function validRecord(record)
	return type(record) == "table" and type(record.stand) == "string"
		and type(record.att) == "string" and type(record.guid) == "string"
end

local function validPending(pending)
	if type(pending) ~= "table" or not validRecord(pending.current) or not validRecord(pending.stored) then return false end
	for _, slot in ipairs(storageMap) do
		if pending.data == slot.data and pending.remote == slot.remote then return true end
	end
	return false
end

local function setStoragePending(pending)
	storagePending = pending
	getgenv().SURStorageStateV2[accountKey] = pending
	persistState(storageFile, pending or {pending = false})
end

local function storageAvailability()
	local free, unknown, protected = nil, 0, 0
	for _, slot in ipairs(storageMap) do
		local record = readStandRecord(slot.data)
		if not record then unknown = unknown + 1
		elseif checkSlotMatch(record.stand, record.att) then protected = protected + 1
		elseif not free then free = slot end
	end
	if free then return free, "available" end
	return nil, unknown > 0 and "unavailable" or (protected == #storageMap and "full" or "unavailable")
end

local function storageCooldown()
	local folder = localplr:FindFirstChild("GlobalCooldowns")
	local cd = folder and folder:FindFirstChild("StandSwitchCD")
	local remaining = math.max(0, 8 - (os.clock() - lastStorageRequest))
	if cd then
		local ok, value = pcall(function() return cd.Value end)
		if not ok or type(value) ~= "number" or value ~= value then return nil end
		remaining = math.max(remaining, value)
	end
	return remaining
end

local function awaitStorageConfirmation(running)
	if not validPending(storagePending) then return false, "Storage check needs manual review." end
	local pending = storagePending
	local deadline = os.clock() + 10
	local confirmedSince
	while running() and os.clock() < deadline do
		local current = readStandRecord()
		local stored = readStandRecord(pending.data)
		if confirmedSwap(current, stored, pending) then
			confirmedSince = confirmedSince or os.clock()
			if os.clock() - confirmedSince >= 0.35 then
				setStoragePending(nil)
				storageMessage = "Stored in " .. pending.label
				return true, pending.label
			end
		else confirmedSince = nil end
		task.wait(0.08)
	end
	storageMessage = "Swap not confirmed. Check storage before resuming."
	return false, storageMessage
end

local function storeMatchedStand(stand, att, running)
	if storagePending then return awaitStorageConfirmation(running) end
	local deadline = os.clock() + 25
	while running() and autoStoreMatches and os.clock() < deadline do
		local remaining = storageCooldown()
		if remaining == nil then return false, "Cannot read storage cooldown." end
		if remaining > 0 then
			storageMessage = "Waiting for storage cooldown: " .. math.ceil(remaining) .. "s"
			task.wait(0.1)
			continue
		end
		local current = readStandRecord()
		if not current or current.stand ~= stand or current.att ~= att then return false, "Current stand data changed." end
		if not checkSlotMatch(current.stand, current.att) then return false, "Target list changed." end
		local slot, reason = storageAvailability()
		if not slot then return false, reason == "full" and "All enabled slots are protected." or "No confirmed usable storage slot." end
		local stored = readStandRecord(slot.data)
		if not stored or checkSlotMatch(stored.stand, stored.att) then return false, "Storage contents changed." end
		-- Require a stable snapshot of both sides before sending the swap.
		task.wait(0.35)
		if not running() or not autoStoreMatches then return false, "Storage cancelled." end
		if not sameRecord(readStandRecord(), current) or not sameRecord(readStandRecord(slot.data), stored) then continue end
		if not checkSlotMatch(current.stand, current.att) or checkSlotMatch(stored.stand, stored.att) then continue end
		local cd = storageCooldown()
		if cd == nil or cd > 0 then continue end
		local events = ReplicatedStorage:FindFirstChild("Events")
		local remote = events and events:FindFirstChild("SwitchStand")
		if not remote or not remote:IsA("RemoteEvent") then return false, "SwitchStand RemoteEvent is missing." end
		setStoragePending({
			pending = true, data = slot.data, remote = slot.remote, label = slot.label,
			current = current, stored = stored,
		})
		-- File APIs may yield, so verify once more after recording the intent.
		if not running() or not autoStoreMatches or not sameRecord(readStandRecord(), current)
			or not sameRecord(readStandRecord(slot.data), stored)
			or not checkSlotMatch(current.stand, current.att) or checkSlotMatch(stored.stand, stored.att) then
			setStoragePending(nil)
			return false, "Storage cancelled before request."
		end
		storageMessage = "Confirming swap into " .. slot.label
		lastStorageRequest = os.clock()
		local ok, err = pcall(function() remote:FireServer(slot.remote) end)
		if not ok then return false, "Storage request failed: " .. tostring(err) end
		return awaitStorageConfirmation(running)
	end
	return false, "Storage cancelled or cooldown timed out."
end

local function saveOrbState()
	getgenv().SUROrbSessionStateV2[accountKey] = {
		gameRef = game,
		playerRef = localplr,
		state = table.clone(orbState),
	}
end

local function orbRemaining()
	return math.max(0, orbState.expiresAt - os.time())
end

local function orbAmount(item)
	local ok, amount = pcall(function() return item:GetAttribute("ItemAmount") end)
	return ok and type(amount) == "number" and amount or nil
end

local function checkOrbConsumption()
	if not orbState.pending then return end
	if orbPendingItem and localplr.Character == orbPendingCharacter then
		local hum = orbPendingCharacter and orbPendingCharacter:FindFirstChildOfClass("Humanoid")
		local currentAmount = orbAmount(orbPendingItem)
		local consumed = orbPendingItem.Parent == nil
			or (orbPendingAmount and currentAmount and currentAmount < orbPendingAmount)
		if hum and hum.Health > 0 and consumed then
			orbState.pending = false
			orbState.expiresAt = orbState.requestedAt + 1800
			orbPendingItem, orbPendingCharacter, orbPendingAmount = nil, nil, nil
			farmStats.orbs = (farmStats.orbs or 0) + 1
			orbMessage = "Use confirmed"
			saveOrbState()
			return
		end
	end
	-- Without confirmation do not consume another orb during the possible buff window.
	if os.time() - orbState.requestedAt >= 1800 then
		orbState.pending = false
		orbPendingItem, orbPendingCharacter, orbPendingAmount = nil, nil, nil
		orbMessage = "Previous unconfirmed-use window ended"
		saveOrbState()
	end
end

local function ensureOrb(running, stand, att)
	checkOrbConsumption()
	if not autoUseOrb or not running() or orbRemaining() > 0 or orbState.pending or os.clock() < orbNextTry then return end
	local item = findFarmItem("2x Orb")
	if not item then
		orbMessage = "No 2x Orb - farming without Orb"
		orbNextTry = os.clock() + 5
		return
	end
	local char = localplr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end
	local using = item:FindFirstChild("Using")
	if using and using.Value == true then
		orbMessage = "Orb already in use; waiting"
		orbNextTry = os.clock() + 2
		return
	end
	local remote = getUseItemRemote(item)
	if not remote then
		orbMessage = "UseItem unavailable - farming without Orb"
		orbNextTry = os.clock() + 30
		return
	end
	local fired = false
	local ok, err = pcall(function()
		hum:EquipTool(item)
		task.wait(0.1)
		local s, a = readStandData()
		if not running() or not autoUseOrb or localplr.Character ~= char or hum.Health <= 0
			or item.Parent ~= char or s ~= stand or a ~= att or #farmSlots == 0 then return end
		orbState = {pending = true, requestedAt = os.time(), expiresAt = 0}
		orbPendingItem, orbPendingCharacter, orbPendingAmount = item, char, orbAmount(item)
		saveOrbState()
		s, a = readStandData()
		if not running() or not autoUseOrb or localplr.Character ~= char or hum.Health <= 0
			or item.Parent ~= char or s ~= stand or a ~= att or #farmSlots == 0 then
			orbState.pending = false
			orbPendingItem, orbPendingCharacter, orbPendingAmount = nil, nil, nil
			saveOrbState()
			return
		end
		fired = true
		orbMessage = "Using 2x Orb..."
		remote:FireServer()
		local deadline = os.clock() + 10
		while running() and os.clock() < deadline do
			checkOrbConsumption()
			if not orbState.pending then return end
			task.wait(0.1)
		end
		orbMessage = "Use not confirmed - automatic reuse held"
	end)
	returnFarmItem(item)
	if not ok then
		orbMessage = "Orb error - farming continues"
		warn("Orb: " .. tostring(err))
		if not fired then
			orbState.pending = false
			orbPendingItem, orbPendingCharacter, orbPendingAmount = nil, nil, nil
			saveOrbState()
		end
	end
	orbNextTry = os.clock() + 30
end

local function orbStatusText()
	local remaining = math.ceil(orbRemaining())
	if remaining > 0 then
		return string.format("2x Orb: ACTIVE (estimated) %02d:%02d | Auto: %s",
			math.floor(remaining / 60), remaining % 60, autoUseOrb and "ON" or "OFF")
	end
	if orbState.pending then return "2x Orb: use unconfirmed; automatic reuse held" end
	if orbState.expiresAt > 0 then
		return "2x Orb: EXPIRED | Auto: " .. (autoUseOrb and "ON" or "OFF")
	end
	return "2x Orb: " .. orbMessage .. " | Auto: " .. (autoUseOrb and "ON" or "OFF")
end

local function updateFarmExtrasUI()
	checkOrbConsumption()
	if orbStatusSection then orbStatusSection:Set(orbStatusText()) end
	if storageStatusSection then storageStatusSection:Set("Storage: " .. storageMessage) end
	for i, slot in ipairs(storageMap) do
		local sections = storageSlotSections[i]
		if sections then
			local r = readStandRecord(slot.data)
			sections.stand:Set(slot.label .. ": " .. (r and getDisplayName(r.stand) or "data unavailable"))
			sections.att:Set(r and ("Attribute: " .. r.att
				.. (checkSlotMatch(r.stand, r.att) and " [KEEP]" or " [AVAILABLE]")) or "Unavailable - do not use")
		end
	end
end

do
	local saved, err = readSavedState(storageFile)
	storagePending = getgenv().SURStorageStateV2[accountKey] or (saved and saved.pending ~= false and saved or nil)
	if err or (storagePending and not validPending(storagePending)) then
		storagePending = {invalid = true}
		storageMessage = "Saved swap record unreadable; manual review required."
	elseif storagePending then storageMessage = "Previous swap awaits verification." end

	local cached = getgenv().SUROrbSessionStateV2[accountKey]
	local candidate = type(cached) == "table" and cached.gameRef == game
		and cached.playerRef == localplr and cached.state or nil
	local now = os.time()
	if type(candidate) == "table" and type(candidate.expiresAt) == "number"
		and type(candidate.requestedAt) == "number" and candidate.requestedAt <= now
		and candidate.requestedAt >= now - 1800
		and candidate.expiresAt >= 0 and candidate.expiresAt <= now + 1800 then
		orbState = {expiresAt = candidate.expiresAt, requestedAt = candidate.requestedAt, pending = candidate.pending == true}
		if orbRemaining() > 0 then orbMessage = "Restored same-session estimate"
		elseif orbState.pending then orbMessage = "Restored same-session pending use" end
	else
		orbState = {expiresAt = 0, requestedAt = 0, pending = false}
		orbMessage = "New game session - fresh Orb required"
		saveOrbState()
	end
end

local function doStandFarm()
	if isFarmingActive or not getgenv().farmstands or getgenv().SURFarmSession ~= hubSession then return end
	isFarmingActive = true
	farmRun = farmRun + 1
	local run = farmRun
	farmStats = { arrows = 0, rokas = 0, errors = 0, stored = 0, orbs = 0 }
	local errors, lastFire = 0, 0
	local pendingArrowNotice = false
	local waitingForItem = nil
	local activeItem
	local function running()
		return getgenv().farmstands and farmRun == run and getgenv().SURFarmSession == hubSession
	end
	local function alive()
		local char = localplr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return char, hum and hum.Health > 0
	end
	local function recordError(message)
		if not running() then return end
		errors = errors + 1
		farmStats.errors = farmStats.errors + 1
		notif("Farm retry " .. errors .. "/10", message)
		task.wait(0.5)
	end
	local function stableData()
		local started, changedAt = os.clock(), os.clock()
		local previousStand, previousAtt
		while running() and os.clock() - started < 4 do
			local s, a = readStandData()
			if s == nil then return nil, nil end
			if s ~= previousStand or a ~= previousAtt then
				previousStand, previousAtt = s, a
				changedAt = os.clock()
			end
			-- An unselected Stand cannot become a match just because its Attribute
			-- arrives later. Reject it quickly; keep the full Attribute window for
			-- possible targets (including every Stand when a target uses Any).
			local empty = s == "None" and a == "None"
			local unselected = s ~= "None" and not checkSlotMatch(s, a, true)
			local fast = empty or unselected
			local minimumWait = fast and 0 or 0.75
			local quietWait = fast and (1 / 60) or 0.35
			if os.clock() - started >= minimumWait and os.clock() - changedAt >= quietWait and a ~= "" then
				return s, a, unselected
			end
			task.wait()
		end
		return nil, nil
	end
	local function fireItem(item, expectedStand, expectedAtt, fastReject)
		local remaining = 0.05 - (os.clock() - lastFire)
		if remaining > 0 then task.wait(remaining) end
		if not running() then return false, "cancelled" end
		if lairCombatBusy then return false, "lair combat" end
		local char, isAlive = alive()
		if not isAlive or not item or not item.Parent then return false, "Character/item unavailable." end
		local remote = getUseItemRemote(item)
		if not remote then return false, "UseItem RemoteEvent was not found." end
		local equipOk, equipErr = pcall(function()
			char:FindFirstChildOfClass("Humanoid"):EquipTool(item)
		end)
		if not equipOk then return false, tostring(equipErr) end
		-- Keep the previous farm Tool equipped until Roblox replaces it here.
		-- This removes the visible empty-hand gap between Arrow and Rokakaka.
		activeItem = item
		task.wait()
		if not running() then return false, "cancelled" end
		if lairCombatBusy then return false, "lair combat" end
		local currentChar, stillAlive = alive()
		local s, a = readStandData()
		if currentChar ~= char or not stillAlive or item.Parent ~= char then
			return false, "Character/item changed during equip."
		end
		if s ~= expectedStand or a ~= expectedAtt then return false, "data changed" end
		if #farmSlots == 0 or (expectedStand == "None" and item.Name ~= selectedArrowType) then
			return false, "data changed"
		end
		if storagePending then return false, "Storage swap still requires verification." end
		-- A retrieved junk Stand may still be removed even after storage becomes
		-- full. Require free storage only before using the next Arrow.
		if autoStoreMatches and expectedStand == "None" then
			local available = storageAvailability()
			if not available then return false, "No confirmed storage space." end
		end
		-- Re-check the slots after every yield before consuming Rokakaka.
		if expectedStand ~= "None" and checkSlotMatch(s, a) then return false, "data changed" end
		-- A target added during equip invalidates the fast rejection even if
		-- its desired Attribute has not arrived yet. Re-enter the normal check.
		if fastReject and checkSlotMatch(s, a, true) then return false, "data changed" end
		local ok, err = pcall(function() remote:FireServer() end)
		lastFire = os.clock()
		return ok, err
	end
	local function waitForResult(usingArrow, fromStand)
		local deadline = os.clock() + 8
		while running() and os.clock() < deadline do
			local s = readStandData()
			if s ~= nil then
				if usingArrow and s ~= "None" then return true end
				if not usingArrow and s == "None" then return true end
				if not usingArrow and s ~= fromStand then return false end
			end
			task.wait()
		end
		return false
	end

	local ok, err = xpcall(function()
		notif("Stand Farm", "Started. Arrow: " .. selectedArrowType)
		while running() do
			task.wait()
			if not running() then break end
			if #farmSlots == 0 then
				notif("Stand Farm", "Add at least 1 target before farming.")
				break
			end
			if errors >= 10 then
				notif("Farm Stopped", "Too many item-use errors. Check inventory/connection.")
				break
			end
			local _, isAlive = alive()
			if not isAlive or not localplr:FindFirstChild("Backpack") then
				task.wait(0.5)
				continue
			end
			-- Boss combat gets a very short exclusive window. This prevents an
			-- Arrow/Roka equip animation from swallowing the M1 used on the boss.
			if lairCombatBusy then
				task.wait(0.03)
				continue
			end
			-- Never use Arrow/Roka while an earlier swap has an uncertain outcome.
			if storagePending then
				local confirmed, detail = awaitStorageConfirmation(running)
				if not confirmed then notif("Storage Stopped", detail); break end
				farmStats.stored = farmStats.stored + 1
			end
			local stand, att, fastReject = stableData()
			if not running() then break end
			if stand == nil then task.wait(0.25); continue end
			local usingArrow = stand == "None"
			if not usingArrow then
				local matched, slotNum = checkSlotMatch(stand, att)
				if matched then
					-- A kept Stand must never leave an Arrow/Roka equipped while the
					-- hub stores it, stops, or displays the match popup.
					returnFarmItem(activeItem)
					activeItem = nil
					local dn = getDisplayName(stand)
					notif("MATCH!", "Target " .. slotNum .. ": " .. att .. " " .. dn)
					task.spawn(webhook, "MATCH FOUND: " .. att:upper() .. " " .. dn:upper()
						.. " (Target " .. slotNum .. ")", stand, 0x00FF00, att, true)
					if autoStoreMatches then
						local stored, detail = storeMatchedStand(stand, att, running)
						if not stored then
							storageMessage = detail
							notif("Storage Stopped", detail)
							break
						end
						farmStats.stored = farmStats.stored + 1
						pendingArrowNotice = false
						notif("Stand Stored", dn .. " / " .. att .. " -> " .. detail)
						task.spawn(webhook, "STORED: " .. att:upper() .. " " .. dn:upper()
							.. " -> " .. detail, stand, 0x00FF00, att, true)
						-- Re-read the stand taken OUT of storage before deciding what to use.
						continue
					end
					getgenv().farmstands = false
					setFarmToggleOff()
					popupfunc("YOU GOT " .. att:upper() .. " " .. dn:upper() .. "!", false, stand)
					break
				end
				if pendingArrowNotice then
					pendingArrowNotice = false
					task.spawn(webhook, "ARROW #" .. farmStats.arrows .. ": " .. att:upper()
						.. " " .. getDisplayName(stand):upper(), stand, 0xFFFF00, att, false)
				end
			end

			-- With a junk Stand active, use its Roka first. Once it becomes None,
			-- stop before the next Arrow if every enabled slot is protected.
			if autoStoreMatches and usingArrow then
				local available, reason = storageAvailability()
				if not available then
					storageMessage = reason == "full" and "All enabled slots are protected; farm stopped."
						or "Storage data unavailable; farm stopped."
					notif("Storage Stopped", storageMessage)
					break
				end
			end
			-- Renew Orb at the safe None -> Arrow boundary. Never insert Orb
			-- between an Arrow result and its immediate Rokakaka replacement.
			if usingArrow then ensureOrb(running, stand, att) end
			if not running() then break end
			local itemName = usingArrow and selectedArrowType or "Rokakaka"
			local item = findFarmItem(itemName)
			if not item then
				if waitingForItem ~= itemName then
					waitingForItem = itemName
					notif("Stand Farm", "Waiting for " .. itemName .. "; farming will resume automatically.")
				end
				task.wait(1)
				continue
			end
			if waitingForItem then
				notif("Stand Farm", itemName .. " found; resuming farming.")
				waitingForItem = nil
			end
			if lairCombatBusy then
				task.wait(0.03)
				continue
			end
			local fired, fireError = fireItem(item, stand, att, fastReject)
			if not fired then
				returnFarmItem(activeItem)
				activeItem = nil
				if not running() then break end
				if fireError ~= "data changed" and fireError ~= "lair combat" then
					recordError(tostring(fireError))
				end
				continue
			end
			local succeeded = waitForResult(usingArrow, stand)
			if not running() then break end
			if not succeeded then
				returnFarmItem(activeItem)
				activeItem = nil
				recordError(itemName .. " timed out; no confirmed result.")
				continue
			end
			errors = 0
			if usingArrow then
				farmStats.arrows = farmStats.arrows + 1
				pendingArrowNotice = true
				-- The next iteration waits for attribute replication and checks the slots.
			else
				farmStats.rokas = farmStats.rokas + 1
				task.spawn(webhook, "ROKA USED: " .. att:upper() .. " " .. getDisplayName(stand):upper(),
					stand, 0xFF0000, att, false)
			end
		end
	end, function(message) return debug.traceback(tostring(message), 2) end)

	returnFarmItem(activeItem)
	isFarmingActive = false
	if farmRun == run and getgenv().SURFarmSession == hubSession then
		getgenv().farmstands = false
		setFarmToggleOff()
	end
	if not ok then
		farmStats.errors = farmStats.errors + 1
		warn(err)
		notif("Farm Error", tostring(err))
	end
	notif("Farm Stopped", "Arrows: " .. farmStats.arrows .. " | Rokas: " .. farmStats.rokas)
	-- An off/on action during an old worker's wait starts exactly one fresh worker.
	if getgenv().farmstands and getgenv().SURFarmSession == hubSession then task.defer(startStandFarm) end
end

startStandFarm = function()
	if getgenv().SURFarmSession ~= hubSession then return end
	getgenv().farmstands = true
	if not loadingConfiguration and not isFarmingActive then task.spawn(doStandFarm) end
end

