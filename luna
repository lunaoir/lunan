local isFarmingActive = false
local farmStats = { arrows = 0, rokas = 0, errors = 0 }

function doStandFarm()
	if isFarmingActive then return end
	isFarmingActive = true
	farmStats = { arrows = 0, rokas = 0, errors = 0 }
	local consecutiveErrors = 0
	local MAX_CONSECUTIVE_ERRORS = 10
	local FIRE_COOLDOWN = 0.4
	local ARROW_TIMEOUT = 8
	local ROKA_TIMEOUT = 8
	local POLL_INTERVAL = 0.08
	local ATT_SETTLE_TIME = 0.05
	local lastFireTime = 0

	local function getFreshData()
		local data = localplr:FindFirstChild("Data")
		if not data then return nil, nil, nil end
		local standObj = data:FindFirstChild("Stand")
		local attObj = data:FindFirstChild("Attri")
		if not standObj or not attObj then return nil, nil, nil end
		return data, standObj, attObj
	end

	local function readFreshStandAtt()
		local s, a = "None", "None"
		pcall(function()
			local d = localplr:FindFirstChild("Data")
			s = d and d:FindFirstChild("Stand") and d.Stand.Value or "None"
			a = d and d:FindFirstChild("Attri") and d.Attri.Value or "None"
		end)
		return s, a
	end

	local function isCharAlive()
		local char = localplr.Character
		if not char then return false, nil end
		local hum = char:FindFirstChild("Humanoid")
		if not hum or hum.Health <= 0 then return false, nil end
		return true, char
	end

	local function getBackpack()
		return localplr:FindFirstChild("Backpack")
	end

	local function safeEquipAndFire(item, char)
		if not item or not char then return false, "missing item or char" end
		-- Bypass inventory cooldown/equip animation delay by firing directly if possible, or force equip and fire.
		local ok, err = pcall(function()
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:EquipTool(item)
			else
				item.Parent = char
			end
		end)
		if not ok then return false, "equip: " .. tostring(err) end
		task.wait(0.1) -- small wait to ensure server registers the equip before firing
		local ok2, err2 = pcall(function() game.ReplicatedStorage.Events.UseItem:FireServer() end)
		if not ok2 then return false, "fire: " .. tostring(err2) end
		return true, nil
	end

	local function safeReturnItem(item, backpack)
		pcall(function()
			if item and item.Parent and item.Parent ~= backpack then
				item.Parent = backpack
			end
		end)
	end

	local function waitForStandChange(fromValue, timeout)
		local elapsed = 0
		while elapsed < timeout do
			if not getgenv().farmstands then return false end
			local val = readFreshStandAtt()
			if val ~= fromValue then return true end
			task.wait(POLL_INTERVAL)
			elapsed = elapsed + POLL_INTERVAL
		end
		return false
	end

	local function cooldown()
		local remaining = FIRE_COOLDOWN - (tick() - lastFireTime)
		if remaining > 0 then task.wait(remaining) end
	end

	notif("Stand Farm", "⚡ Speed Farm started! Arrow: " .. selectedArrowType)

	while getgenv().farmstands do
		task.wait(0.05)
		if not getgenv().farmstands then break end

		if #farmSlots == 0 then
			notif("Error", "Add at least 1 slot before farming!")
			getgenv().farmstands = false
			break
		end

		if consecutiveErrors >= MAX_CONSECUTIVE_ERRORS then
			notif("❌ Farm Stopped", "Too many errors (" .. consecutiveErrors .. "). Check items/connection!")
			getgenv().farmstands = false
			break
		end

		local alive, char = isCharAlive()
		if not alive then task.wait(0.5); consecutiveErrors = consecutiveErrors + 1; continue end

		local backpack = getBackpack()
		if not backpack then task.wait(0.5); consecutiveErrors = consecutiveErrors + 1; continue end

		local currentStand, currentAtt = readFreshStandAtt()

		if currentStand ~= "None" then
			local matched, slotNum = checkSlotMatch(currentStand, currentAtt)
			if matched then
				local dn = getDisplayName(currentStand)
				getgenv().farmstands = false
				notif("✅ MATCH!", "Slot " .. slotNum .. ": " .. currentAtt .. " " .. dn)
				notif("📊 Stats", "Arrows: " .. farmStats.arrows .. " | Rokas: " .. farmStats.rokas)
				webhook("MATCH FOUND: " .. currentAtt:upper() .. " " .. dn:upper() .. " (Slot " .. slotNum .. ")", currentStand, tonumber(0x00FF00), currentAtt, true)
				popupfunc("YOU GOT " .. currentAtt:upper() .. " " .. dn:upper() .. "!", false, currentStand)
				break
			end

			webhook("ROKA USED: " .. currentAtt:upper() .. " " .. getDisplayName(currentStand):upper(), currentStand, tonumber(0xFF0000), currentAtt, false)

			local roka = nil
			pcall(function() roka = backpack:FindFirstChild("Rokakaka") end)
			if not roka then
				getgenv().farmstands = false
				notif("Hết Rokakaka!", "Đã dùng " .. farmStats.rokas .. " quả. Arrows: " .. farmStats.arrows)
				break
			end

			cooldown()
			alive, char = isCharAlive()
			if not alive then consecutiveErrors = consecutiveErrors + 1; continue end

			local fireOk, fireErr = safeEquipAndFire(roka, char)
			lastFireTime = tick()
			if not fireOk then
				safeReturnItem(roka, backpack)
				consecutiveErrors = consecutiveErrors + 1
				task.wait(0.5)
				continue
			end

			local resetOk = waitForStandChange(currentStand, ROKA_TIMEOUT)
			safeReturnItem(roka, backpack)

			if resetOk then
				farmStats.rokas = farmStats.rokas + 1
				consecutiveErrors = 0
			else
				local freshVal = readFreshStandAtt()
				if freshVal == "None" then
					farmStats.rokas = farmStats.rokas + 1
					consecutiveErrors = 0
				else
					consecutiveErrors = consecutiveErrors + 1
					notif("⚠️ Roka Timeout", "Retry " .. consecutiveErrors .. "/" .. MAX_CONSECUTIVE_ERRORS)
					task.wait(1)
				end
			end
		else
			local arrowName = selectedArrowType
			local arrow = nil
			pcall(function() arrow = backpack:FindFirstChild(arrowName) end)
			if not arrow then
				getgenv().farmstands = false
				notif("Hết Arrow!", "Hết " .. arrowName .. "! Arrows: " .. farmStats.arrows .. " | Rokas: " .. farmStats.rokas)
				break
			end

			cooldown()
			alive, char = isCharAlive()
			if not alive then consecutiveErrors = consecutiveErrors + 1; continue end

			local fireOk, fireErr = safeEquipAndFire(arrow, char)
			lastFireTime = tick()
			if not fireOk then
				safeReturnItem(arrow, backpack)
				consecutiveErrors = consecutiveErrors + 1
				task.wait(0.5)
				continue
			end

			local gotStand = waitForStandChange("None", ARROW_TIMEOUT)
			safeReturnItem(arrow, backpack)

			if not gotStand then
				local freshVal = readFreshStandAtt()
				if freshVal ~= "None" then
					gotStand = true
				end
			end

			if gotStand then
				farmStats.arrows = farmStats.arrows + 1
				consecutiveErrors = 0
				task.wait(ATT_SETTLE_TIME)

				local freshStand, freshAtt = readFreshStandAtt()
				if freshStand ~= "None" then
					local matched, slotNum = checkSlotMatch(freshStand, freshAtt)
					local dn = getDisplayName(freshStand)

					if matched then
						getgenv().farmstands = false
						notif("✅ MATCH!", "Slot " .. slotNum .. ": " .. freshAtt .. " " .. dn)
						notif("📊 Stats", "Arrows: " .. farmStats.arrows .. " | Rokas: " .. farmStats.rokas)
						webhook("MATCH FOUND: " .. freshAtt:upper() .. " " .. dn:upper() .. " (Slot " .. slotNum .. ")", freshStand, tonumber(0x00FF00), freshAtt, true)
						popupfunc("YOU GOT " .. freshAtt:upper() .. " " .. dn:upper() .. "!", false, freshStand)
						break
					end

					webhook("ARROW #" .. farmStats.arrows .. ": " .. freshAtt:upper() .. " " .. dn:upper() .. " -> ROKA", freshStand, tonumber(0xFFFF00), freshAtt, false)

					local roka = nil
					pcall(function() roka = backpack:FindFirstChild("Rokakaka") end)
					if not roka then
						getgenv().farmstands = false
						notif("Hết Rokakaka!", "Đã dùng " .. farmStats.rokas .. " quả.")
						break
					end

					cooldown()
					alive, char = isCharAlive()
					if not alive then consecutiveErrors = consecutiveErrors + 1; continue end

					local rokaOk, rokaErr = safeEquipAndFire(roka, char)
					lastFireTime = tick()
					if not rokaOk then
						safeReturnItem(roka, backpack)
						consecutiveErrors = consecutiveErrors + 1
						task.wait(0.5)
						continue
					end

					local resetOk = waitForStandChange(freshStand, ROKA_TIMEOUT)
					safeReturnItem(roka, backpack)

					if resetOk then
						farmStats.rokas = farmStats.rokas + 1
						consecutiveErrors = 0
					else
						local checkVal = readFreshStandAtt()
						if checkVal == "None" then
							farmStats.rokas = farmStats.rokas + 1
							consecutiveErrors = 0
						else
							consecutiveErrors = consecutiveErrors + 1
							notif("⚠️ Roka Timeout", "Retry " .. consecutiveErrors .. "/" .. MAX_CONSECUTIVE_ERRORS)
							task.wait(1)
						end
					end
				end
			else
				consecutiveErrors = consecutiveErrors + 1
				notif("⚠️ Arrow Timeout", "Retry " .. consecutiveErrors .. "/" .. MAX_CONSECUTIVE_ERRORS)
				task.wait(1)
			end
		end
	end

	if not getgenv().farmstands then
		notif("Farm Stopped", "📊 Arrows: " .. farmStats.arrows .. " | Rokas: " .. farmStats.rokas)
	end
	isFarmingActive = false
end

