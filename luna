local function safeLoadConfiguration()
	if not Rayfield or type(Rayfield.LoadConfiguration) ~= "function" then
		return false, "Configuration loader is unavailable."
	end
	if stopStandFarm then stopStandFarm() end
	loadingConfiguration = true
	local ok, result, err = pcall(function()
		return Rayfield:LoadConfiguration()
	end)
	loadingConfiguration = false
	if not ok or result == false then
		if stopStandFarm then stopStandFarm() end
		return false, not ok and result or err or "Configuration load failed."
	end
	if getgenv().farmstands and startStandFarm then startStandFarm() end
	return true, nil
end

