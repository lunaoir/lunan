local function isInvalidGroundSurface(hitInstance,hitPosition,referenceY)
if hitInstance==supportState.Slab or(hitInstance and hitInstance.Name==SUPPORT_FLOOR_NAME)then
return true
end
if hitInstance and hitInstance:IsA("Terrain")then
if referenceY and hitPosition.Y>referenceY+2.5 then
return true
end
return false
end
if not hitInstance or not hitInstance:IsA("BasePart")then
return true
end
if not hitInstance.CanCollide then
return true
end
local ancestorModel=hitInstance:FindFirstAncestorOfClass("Model")
if ancestorModel and(ancestorModel:FindFirstChildOfClass("Humanoid")~=nil or isHalloweenMobName(ancestorModel.Name))then
return true
end
local doors=doorFolder()
if doors and hitInstance:IsDescendantOf(doors)then
return true
end
local lowerName=string.lower(hitInstance.Name)
if
lowerName:find("roof",1,true)
or lowerName:find("leaf",1,true)
or lowerName:find("leaves",1,true)
or lowerName:find("canopy",1,true)
or lowerName:find("ceiling",1,true)
or lowerName:find("doortype",1,true)
or lowerName:find("awning",1,true)
then
return true
end
if referenceY and hitPosition.Y>referenceY+2.5 then
return true
end
return false
end
local function findRealGroundPosition(referencePos)
if not referencePos then
return nil
end
local params=buildGroundRayParams()
local startY=referencePos.Y+4.5
local origin=Vector3.new(referencePos.X,startY,referencePos.Z)
local direction=Vector3.new(0,-120,0)
for _=1,8 do
local hit=workspace:Raycast(origin,direction,params)
if not hit then
break
end
local hitInst=hit.Instance
if isInvalidGroundSurface(hitInst,hit.Position,referencePos.Y)or hit.Normal.Y<0.55 then
local filter=params.FilterDescendantsInstances
table.insert(filter,hitInst)
params.FilterDescendantsInstances=filter
else
return hit.Position
end
end
return nil
end
local function computeUprightUndergroundCFrame(groundPos,horizontalLookDir,depthOverride)
local dir=Vector3.new(horizontalLookDir.X,0,horizontalLookDir.Z)
if dir.Magnitude<0.01 then
dir=Vector3.new(0,0,-1)
else
dir=dir.Unit
end
local effectiveDepth=depthOverride or math.max(undergroundDepth,currentRequiredClearanceDepth or 0)
local undergroundPos=Vector3.new(groundPos.X,groundPos.Y-effectiveDepth,groundPos.Z)
return CFrame.lookAt(undergroundPos,undergroundPos+dir)
end
local cachedClearanceChar=nil
local cachedPlayerClearance=3.0
local function measureModelTopClearanceAboveRoot(model,targetRoot)
if not model or not targetRoot then
return 3.0
end
if model==cachedClearanceChar and cachedPlayerClearance then
return cachedPlayerClearance
end
local clearance=3.0
local ok,boxCF,boxSize=pcall(function()
return model:GetBoundingBox()
end)
if ok and boxCF and boxSize and type(boxSize.Y)=="number"then
local boxTopOffset=boxSize.Y*0.5
if boxCF.Position and targetRoot.Position and math.abs(boxCF.Position.Y-targetRoot.Position.Y)<=boxSize.Y then
boxTopOffset=(boxCF.Position.Y+(boxSize.Y*0.5))-targetRoot.Position.Y
end
clearance=math.max(clearance,boxTopOffset)
end
local okExt,extSize=pcall(function()
return model:GetExtentsSize()
end)
if okExt and extSize and type(extSize.Y)=="number"then
clearance=math.max(clearance,extSize.Y*0.55)
end
if targetRoot.Size and type(targetRoot.Size.Y)=="number"then
local head=model:FindFirstChild("Head")
local headH=(head and head:IsA("BasePart")and head.Size and type(head.Size.Y)=="number")and head.Size.Y or 1.5
clearance=math.max(clearance,(targetRoot.Size.Y*0.5)+headH)
end
clearance=math.clamp(clearance,2.0,14.0)
if model==localplr.Character then
cachedClearanceChar=model
cachedPlayerClearance=clearance
end
return clearance
end
