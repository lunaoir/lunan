table.insert(excludeList,supportState.Slab)
end
for mobModel in pairs(mobs)do
if mobModel and mobModel.Parent then
table.insert(excludeList,mobModel)
end
end
if type(extraExclude)=="table"then
for _,item in ipairs(extraExclude)do
if item then
table.insert(excludeList,item)
end
end
end
local params=RaycastParams.new()
