local head=character:FindFirstChild("Head")
if head and head:IsA("BasePart")then
local offset=head.Position.Y-root.Position.Y+head.Size.Y*.5
if offset>0 and offset<=4 then clearance=math.max(clearance,offset)end
end
local y=math.min(point.Y-depth,record.GroundPos.Y-clearance-.25)
local p=Vector3.new(point.X,y,point.Z)
if(p-point).Magnitude>math.max(0,radius-.25)then
return nil,"Điểm E gốc quá xa để vừa ở dưới đất vừa gõ cửa · Đổi cửa khác"
end
return CFrame.lookAt(p,p+record.LookDir)
end
